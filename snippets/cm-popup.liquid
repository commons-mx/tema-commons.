{%- comment -%} Popup v6: necesidad → correo → WhatsApp (opcional) → código. 10% primera compra; no se acumula con volumen. {%- endcomment -%}
{%- unless template.name == 'cart' or template contains 'customers' or template.suffix == 'buen-fin' -%}
<style>
#cm-pp{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:24px;
  --bg:#F7F7F4;--ink:#141A16;--ink2:#4A524C;--rule:#D9D8D1;--lime:#EDE47A;--fd:'Jost','Figtree',system-ui,sans-serif;--fb:'Figtree',system-ui,sans-serif;--fm:'DM Mono',ui-monospace,monospace;
  font-family:var(--fb);color:var(--ink);-webkit-font-smoothing:antialiased}
#cm-pp[hidden],#cm-pp-tab[hidden]{display:none !important}
#cm-pp *{box-sizing:border-box}
#cm-pp .pv-dim{position:absolute;inset:0;background:rgba(20,26,22,.6)}
#cm-pp .pv{position:relative;display:grid;grid-template-columns:44% 56%;width:min(920px,100%);min-height:560px;max-height:calc(100vh - 48px);background:var(--bg);overflow:hidden;animation:pvIn .35s ease}
@keyframes pvIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
#cm-pp .pv-ph{position:relative;background:#E9E7DF}
#cm-pp .pv-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#cm-pp .pv-ph .ih{display:none}
#cm-pp .pv-badge{position:absolute;left:20px;bottom:20px;background:var(--lime);color:var(--ink);font-family:var(--fm);font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:8px 12px;border-radius:999px}
#cm-pp .pv-body{position:relative;display:flex;flex-direction:column;padding:44px 48px 32px;overflow:auto}
#cm-pp .pv-x{position:absolute;top:14px;right:14px;width:40px;height:40px;border-radius:999px;border:0;background:transparent;color:var(--ink);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2}
#cm-pp .pv-x:hover{background:#ECEBE4}
#cm-pp .pv-prog{display:flex;gap:6px;margin:0 48px 28px 0}
#cm-pp .pv-prog i{flex:1;height:3px;background:var(--rule);border-radius:3px}
#cm-pp .pv-prog i.on{background:var(--ink)}
#cm-pp .pv-st{display:none;flex-direction:column;gap:18px;flex:1}
#cm-pp .pv-st.on{display:flex;animation:pvIn .3s ease}
#cm-pp .pv-eb{font-family:var(--fm);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
#cm-pp .pv-h{font-family:var(--fd);font-weight:500;font-size:40px;line-height:1.04;letter-spacing:-.02em;margin:0}
#cm-pp .pv-h b{font-weight:500;background:var(--lime);padding:0 .12em}
#cm-pp .pv-p{margin:0;font-size:16px;line-height:1.45;color:var(--ink2);max-width:40ch}
#cm-pp .pv-needs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:4px}
#cm-pp .pv-need{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:14px 14px 12px;border:1px solid var(--ink);border-radius:14px;background:transparent;color:var(--ink);font:500 15px/1 var(--fb);cursor:pointer;text-align:left;transition:background .15s,color .15s}
#cm-pp .pv-need svg{width:30px;height:30px}
#cm-pp .pv-need:hover,#cm-pp .pv-need:focus-visible{background:var(--ink);color:var(--bg)}
#cm-pp .pv-chip{align-self:flex-start;display:inline-flex;gap:8px;align-items:center;background:#ECEBE4;border-radius:999px;padding:6px 12px;font-size:13px}
#cm-pp .pv-chip button{border:0;background:none;padding:0;font:inherit;text-decoration:underline;color:var(--ink2);cursor:pointer}
#cm-pp form{display:flex;flex-direction:column;gap:10px;margin:0}
#cm-pp .pv-in{display:flex;align-items:center;height:56px;border:1px solid var(--ink);border-radius:999px;background:#fff;overflow:hidden}
#cm-pp .pv-in span{padding:0 4px 0 22px;font-size:16px;color:var(--ink2)}
#cm-pp .pv-in input{flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;padding:0 22px;font:400 16px var(--fb);color:var(--ink)}
#cm-pp .pv-in span + input{padding-left:6px}
#cm-pp .pv-in:focus-within{box-shadow:0 0 0 3px rgba(237,228,122,.9)}
#cm-pp .pv-btn{display:flex;align-items:center;justify-content:center;gap:10px;height:56px;border:0;border-radius:999px;background:var(--ink);color:#fff;font:500 16px var(--fb);cursor:pointer;text-decoration:none;width:100%}
#cm-pp .pv-btn.lime{background:var(--lime);color:var(--ink)}
#cm-pp .pv-btn:hover{opacity:.92}
#cm-pp .pv-btn[disabled]{opacity:.5;cursor:wait}
#cm-pp .pv-skip{align-self:center;border:0;background:none;font:400 14px var(--fb);color:var(--ink2);text-decoration:underline;cursor:pointer;padding:6px}
#cm-pp .pv-fine{margin:auto 0 0;font-size:12px;line-height:1.45;color:var(--ink2)}
#cm-pp .pv-fine a{color:inherit}
#cm-pp .pv-wa{display:flex;gap:10px;align-items:flex-start;font-size:14px;line-height:1.4;color:var(--ink2);margin:0;padding:0;list-style:none;flex-direction:column}
#cm-pp .pv-wa li{display:flex;gap:10px}
#cm-pp .pv-wa li:before{content:'';flex:none;width:8px;height:8px;margin-top:6px;border-radius:99px;background:var(--ink)}
#cm-pp .pv-code{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1.5px dashed var(--ink);border-radius:14px;padding:16px 18px;background:#fff}
#cm-pp .pv-code b{font-family:var(--fm);font-weight:500;font-size:20px;letter-spacing:.06em}
#cm-pp .pv-copy{border:0;background:var(--ink);color:#fff;border-radius:999px;padding:10px 16px;font:500 14px var(--fb);cursor:pointer}
#cm-pp .pv-ladder{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--rule);border-radius:14px;overflow:hidden}
#cm-pp .pv-ladder div{padding:12px;display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--ink2)}
#cm-pp .pv-ladder div + div{border-left:1px solid var(--rule)}
#cm-pp .pv-ladder b{font-family:var(--fd);font-weight:500;font-size:22px;color:var(--ink)}
@media (max-width:760px){
  #cm-pp{padding:0;align-items:stretch}
  #cm-pp .pv{grid-template-columns:1fr;grid-template-rows:30vh 1fr;width:100%;height:100%;max-height:none;min-height:0;border-radius:0}
  #cm-pp .pv-ph .iv{display:none}#cm-pp .pv-ph .ih{display:block}
  #cm-pp .pv-badge{left:16px;bottom:16px}
  #cm-pp .pv-body{padding:22px 20px calc(20px + env(safe-area-inset-bottom))}
  #cm-pp .pv-x{position:fixed;top:12px;right:12px;background:var(--bg)}
  #cm-pp .pv-prog{margin:0 0 20px}
  #cm-pp .pv-h{font-size:34px}
  #cm-pp .pv-p{font-size:15px}
  #cm-pp .pv-st{gap:14px}
  #cm-pp .pv-needs{grid-template-columns:repeat(2,minmax(0,1fr))}
  #cm-pp .pv-need{flex-direction:row;align-items:center;padding:12px;font-size:15px}
  #cm-pp .pv-need svg{width:26px;height:26px}
}
#cm-pp-tab{position:fixed;left:16px;bottom:16px;z-index:2147482999;display:flex;align-items:center;gap:2px;background:#141A16;color:#F7F7F4;border-radius:999px;font-family:'Figtree',system-ui,sans-serif;box-shadow:0 6px 20px rgba(0,0,0,.18)}
#cm-pp-tab button{border:0;background:none;color:inherit;font:500 14px 'Figtree',system-ui,sans-serif;cursor:pointer}
#cm-pp-tab .t1{padding:12px 6px 12px 18px;display:flex;gap:8px;align-items:center}
#cm-pp-tab .t1 i{font-style:normal;background:#EDE47A;color:#141A16;border-radius:999px;padding:3px 8px;font-size:12px}
#cm-pp-tab .t2{padding:12px 14px 12px 6px;opacity:.7}
</style>
<div id="cm-pp-tab" hidden><button type="button" class="t1" data-pv-open>Tu primer Commons <i>−10%</i></button><button type="button" class="t2" data-pv-tabx aria-label="Ocultar">✕</button></div>
<div id="cm-pp" hidden role="dialog" aria-modal="true" aria-labelledby="pv-h1">
<div class="pv-dim" data-pv-close></div>
<div class="pv">
  <div class="pv-ph">
    <img class="iv" src="{{ 'cm-b-e2ddf954dc.jpg' | asset_url }}" alt="" width="1200" height="1210" loading="lazy">
    <img class="ih" src="{{ 'cm-b-4d65fc747e.jpg' | asset_url }}" alt="" width="1400" height="867" loading="lazy">
    <span class="pv-badge">Ahorra hasta 20%</span>
  </div>
  <div class="pv-body">
    <button type="button" class="pv-x" data-pv-close aria-label="Cerrar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    <div class="pv-prog" aria-hidden="true"><i class="on"></i><i></i><i></i></div>

    <section class="pv-st on" data-st="1">
      <span class="pv-eb">Bienvenida a Commons</span>
      <h2 id="pv-h1" class="pv-h">Tu primer Commons, con <b>10%</b>.</h2>
      <p class="pv-p">¿Qué quieres acompañar? Elige uno y te decimos por dónde empezar.</p>
      <div class="pv-needs"><button type="button" class="pv-need" data-need="sueno" data-label="Sueño" data-url="/collections/adaptogenos-para-el-sueno">{%- render 'cm-need-icon', icon: 'Sueño' -%}<span>Sueño</span></button><button type="button" class="pv-need" data-need="estres" data-label="Estrés" data-url="/collections/adaptogenos-para-reducir-estres">{%- render 'cm-need-icon', icon: 'Estrés' -%}<span>Estrés</span></button><button type="button" class="pv-need" data-need="animo" data-label="Ánimo" data-url="/collections/adaptogenos-para-estado-de-animo">{%- render 'cm-need-icon', icon: 'Ánimo' -%}<span>Ánimo</span></button><button type="button" class="pv-need" data-need="enfoque" data-label="Enfoque" data-url="/collections/adaptogenos-para-concentracion-y-enfoque">{%- render 'cm-need-icon', icon: 'Enfoque' -%}<span>Enfoque</span></button><button type="button" class="pv-need" data-need="energia" data-label="Energía" data-url="/collections/adaptogenos-para-la-energia">{%- render 'cm-need-icon', icon: 'Energía' -%}<span>Energía</span></button><button type="button" class="pv-need" data-need="ciclo" data-label="Ciclo" data-url="/collections/adaptogenos-para-salud-hormonal">{%- render 'cm-need-icon', icon: 'Ciclo' -%}<span>Ciclo</span></button></div>
      <button type="button" class="pv-skip" data-pv-close>No, gracias</button>
    </section>

    <section class="pv-st" data-st="2">
      <span class="pv-chip">Para: <b data-pv-need-label>ti</b> <button type="button" data-pv-back>cambiar</button></span>
      <h2 class="pv-h">¿A dónde te mandamos tu <b>10%</b>?</h2>
      <p class="pv-p">Te llega tu código y una guía corta para empezar con lo que elegiste.</p>
      {%- form 'customer', class: 'pv-mail', id: 'pv-mail' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup" data-pv-tags>
        <label class="pv-in"><input type="email" name="contact[email]" required autocomplete="email" placeholder="Tu correo" aria-label="Tu correo" data-pv-email></label>
        <button type="submit" class="pv-btn">Continuar <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      {%- endform -%}
      <p class="pv-fine">Descuentos no acumulables. Se aplica el mayor beneficio disponible. Al continuar aceptas recibir correos de Commons; te das de baja cuando quieras. <a href="/pages/aviso-de-privacidad">Aviso de privacidad</a>.</p>
    </section>

    <section class="pv-st" data-st="3">
      <span class="pv-eb">Último paso</span>
      <h2 class="pv-h">Actívalo por <b>WhatsApp</b>.</h2>
      <ul class="pv-wa"><li>Te mandamos tu código ahí también.</li><li>Te avisamos antes de que se acabe tu frasco.</li><li>Una persona te asesora cuando lo necesites.</li></ul>
      {%- form 'contact', class: 'pv-wa-f', id: 'pv-wa-f' -%}
        <input type="hidden" name="contact[email]" data-pv-email2>
        <input type="hidden" name="contact[interes]" data-pv-need2>
        <input type="hidden" name="contact[origen]" value="Popup v6 · alta WhatsApp">
        <label class="pv-in"><span>+52</span><input type="tel" name="contact[whatsapp]" inputmode="numeric" autocomplete="tel-national" pattern="[0-9 ]{10,14}" required placeholder="Tu WhatsApp a 10 dígitos" aria-label="Tu WhatsApp a 10 dígitos"></label>
        <button type="submit" class="pv-btn lime">Activar mi 10% <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      {%- endform -%}
      <button type="button" class="pv-skip" data-pv-skipwa>Prefiero solo por correo</button>
      <p class="pv-fine">Al enviar aceptas recibir mensajes de Commons por WhatsApp sobre tus pedidos, recordatorios y promociones. No es condición de compra. Te das de baja cuando quieras respondiendo BAJA. <a href="/pages/aviso-de-privacidad">Aviso de privacidad</a>.</p>
    </section>

    <section class="pv-st" data-st="4">
      <span class="pv-eb">Ya eres parte de Commons</span>
      <h2 class="pv-h">Listo. Aquí está tu <b>10%</b>.</h2>
      <div class="pv-code"><b>MIPRIMERHONGUITO</b><button type="button" class="pv-copy" data-pv-copy>Copiar</button></div>
      <p class="pv-p" style="font-size:14px">Se aplica solo al pagar. También te lo mandamos a tu correo.</p>
      <a class="pv-btn" href="/collections/all" data-pv-go><span data-pv-go-label>Ir a la tienda</span> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <span class="pv-eb" style="margin-top:6px">¿Vas por más? Combina y ahorra</span>
      <div class="pv-ladder"><div><b>−10%</b>2 productos</div><div><b>−15%</b>3 o más</div></div>
      <p class="pv-fine">Descuentos no acumulables. Se aplica el mayor beneficio disponible.</p>
    </section>
  </div>
</div>
</div>
<script>
(function(){
  var K='cm-pp-v6', T='cm-pp-tab-off', CODE='MIPRIMERHONGUITO';
  var el=document.getElementById('cm-pp'), tab=document.getElementById('cm-pp-tab'); if(!el) return;
  var st={need:'',label:'',url:'/collections/all',email:''};
  function ls(k,v){ try{ if(v===undefined) return localStorage.getItem(k); localStorage.setItem(k,v);}catch(e){} }
  function seen(){ var t=+ls(K); return t && (Date.now()-t)<14*864e5; }
  function tabOff(){ try{ return sessionStorage.getItem(T)==='1'; }catch(e){ return false; } }
  function showTab(){ if(tab && !tabOff() && ls('cm-pp-done')!=='1') tab.hidden=false; }
  function go(n){ el.querySelectorAll('.pv-st').forEach(function(s){ s.classList.toggle('on', s.dataset.st==String(n)); });
    el.querySelectorAll('.pv-prog i').forEach(function(i,ix){ i.classList.toggle('on', ix < Math.min(n,3)); });
    var f=el.querySelector('.pv-st.on input:not([type=hidden])'); if(f && window.innerWidth>760) f.focus(); el.querySelector('.pv-body').scrollTop=0; }
  function open(){ el.hidden=false; if(tab) tab.hidden=true; ls(K,String(Date.now())); document.documentElement.style.overflow='hidden'; }
  function close(){ el.hidden=true; ls(K,String(Date.now())); document.documentElement.style.overflow=''; showTab(); }
  el.querySelectorAll('[data-pv-close]').forEach(function(b){ b.addEventListener('click', close); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !el.hidden) close(); });
  if(tab){ tab.querySelector('[data-pv-open]').addEventListener('click', open); tab.querySelector('[data-pv-tabx]').addEventListener('click', function(){ tab.hidden=true; try{ sessionStorage.setItem(T,'1'); }catch(e){} }); }
  el.querySelectorAll('[data-need]').forEach(function(b){ b.addEventListener('click', function(){
    st.need=b.dataset.need; st.label=b.dataset.label; st.url=b.dataset.url;
    el.querySelector('[data-pv-need-label]').textContent=st.label;
    el.querySelector('[data-pv-tags]').value='newsletter,popup,interes-'+st.need;
    go(2);
  }); });
  el.querySelector('[data-pv-back]').addEventListener('click', function(){ go(1); });
  function finish(){
    ls('cm-pp-done','1');
    var g=el.querySelector('[data-pv-go]'); g.href='/discount/'+CODE+'?redirect='+encodeURIComponent(st.url);
    el.querySelector('[data-pv-go-label]').textContent = st.label ? ('Ver lo de '+st.label) : 'Ir a la tienda';
    fetch('/discount/'+CODE,{credentials:'same-origin'}).catch(function(){});
    go(4);
  }
  function post(f){ return fetch(f.action||'/contact',{method:'POST',body:new FormData(f),headers:{'Accept':'text/html'},credentials:'same-origin'}); }
  var fm=document.getElementById('pv-mail');
  fm.addEventListener('submit', function(e){ if(!fm.checkValidity()) return; e.preventDefault();
    var b=fm.querySelector('button'); b.disabled=true;
    st.email=fm.querySelector('[data-pv-email]').value;
    el.querySelector('[data-pv-email2]').value=st.email; el.querySelector('[data-pv-need2]').value=st.label;
    post(fm).then(function(r){ b.disabled=false; if(r.redirected && /challenge/.test(r.url)){ ls('cm-pp-need',st.url); fm.submit(); return; } go(3); }).catch(function(){ b.disabled=false; go(3); });
  });
  var fw=document.getElementById('pv-wa-f');
  fw.addEventListener('submit', function(e){ if(!fw.checkValidity()) return; e.preventDefault();
    var b=fw.querySelector('button'); b.disabled=true;
    var t=fw.querySelector('input[type=tel]'); t.value='+52 '+t.value.replace(/\D/g,'');
    post(fw).then(finish).catch(finish);
  });
  el.querySelector('[data-pv-skipwa]').addEventListener('click', finish);
  el.querySelector('[data-pv-copy]').addEventListener('click', function(e){ try{ navigator.clipboard.writeText(CODE); e.target.textContent='Copiado'; }catch(x){} });
  if(location.search.indexOf('customer_posted=true')>-1){ var u=ls('cm-pp-need'); if(u) st.url=u; open(); go(3); return; }
  if(ls('cm-pp-done')==='1') return;
  if(seen()){ showTab(); return; }
  var tm=setTimeout(open, 8000);
  window.addEventListener('scroll', function f(){ var h=document.documentElement; if((h.scrollTop+innerHeight)/h.scrollHeight>.4){ clearTimeout(tm); if(el.hidden && !seen()) open(); window.removeEventListener('scroll', f); } }, {passive:true});
})();
</script>
{%- endunless -%}
