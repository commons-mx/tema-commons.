<script>
(function(){
  var K = 'cm-pp-v5', T = 'cm-pp-tab-off', el = document.getElementById('cm-pp'), tab = document.getElementById('cm-pp-tab'); if (!el) return;
  function seen(){ try { var t = +localStorage.getItem(K); return t && (Date.now() - t) < 14*864e5; } catch(e){ return false; } }
  function mark(){ try { localStorage.setItem(K, String(Date.now())); } catch(e){} }
  function tabOff(){ try { return sessionStorage.getItem(T) === '1'; } catch(e){ return false; } }
  function showTab(){ if (tab && !tabOff()) tab.hidden = false; }
  function open(){ el.hidden = false; if (tab) tab.hidden = true; mark(); var c = el.querySelector('.pp-close'); if (c) c.focus(); }
  function close(){ el.hidden = true; mark(); showTab(); }
  el.querySelectorAll('.pp-close,[data-pp-close],[data-pp-go]').forEach(function(b){ b.addEventListener('click', close); });
  if (tab) { tab.querySelector('.pp-tab').addEventListener('click', open); tab.querySelector('.pp-tabx').addEventListener('click', function(){ tab.hidden = true; try { sessionStorage.setItem(T, '1'); } catch(e){} }); }
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !el.hidden) close(); });
  if (location.search.indexOf('customer_posted=true') > -1) { open(); return; }
  if (seen()) { showTab(); return; }
  var t = setTimeout(open, 8000);
  window.addEventListener('scroll', function f(){ var h = document.documentElement; if ((h.scrollTop + innerHeight) / h.scrollHeight > .4) { clearTimeout(t); if (el.hidden && !seen()) open(); window.removeEventListener('scroll', f); } }, { passive: true });
})();
</script>
