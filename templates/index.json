    "cm_faq": {
      "type": "cm-faq",
      "blocks": {
        "b1": {
          "type": "faq",
          "settings": {
            "q": "¿Qué es Botanicals y qué es Science?",
            "a": "<p>Botanicals son nuestros adaptógenos: extractos estandarizados de hongos, raíces y plantas. Science son nuestras fórmulas con ingredientes de patente y estudios clínicos, en la dosis que se estudió. Puedes combinarlos en un mismo protocolo.</p>"
          }
        },
        "b2": {
          "type": "faq",
          "settings": {
            "q": "¿Qué significa “estandarizado”?",
            "a": "<p>Que cada lote trae la misma cantidad de compuesto activo y que la declaramos en la etiqueta. Un polvo común es la planta molida: no sabes cuánto activo trae.</p>"
          }
        },
        "b3": {
          "type": "faq",
          "settings": {
            "q": "¿Cuánto me dura un frasco?",
            "a": "<p>Con 2 cápsulas al día, un frasco de 120 te dura alrededor de 2 meses. Un polvo de 100 g, con 1 scoop al día, casi 4 meses.</p>"
          }
        },
        "b4": {
          "type": "faq",
          "settings": {
            "q": "¿Puedo combinar productos?",
            "a": "<p>Sí. Arma tu protocolo con 2 o 3 frascos según lo que necesitas, o haz el quiz y te lo armamos. Si tomas medicamentos, estás embarazada o en lactancia, consulta a tu médico.</p>"
          }
        },
        "b5": {
          "type": "faq",
          "settings": {
            "q": "¿Hacen envíos a todo México?",
            "a": "<p>Sí. Envío gratis en pedidos desde $990. [Tiempo de entrega]</p>"
          }
        }
      },
