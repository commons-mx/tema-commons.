      when 'eleuthero-full-polvo'
        assign gal_list = 'cm-gal-eleuthero-01.jpg,cm-gal-eleuthero-03.jpg,cm-gal-eleuthero-04.jpg,cm-gal-eleuthero-05.jpg,cm-gal-eleuthero-06.jpg,cm-gal-eleuthero-07.jpg'
      when 'shatavari-full-polvo'
        assign gal_list = 'cm-gal-shatavari-01.jpg,cm-gal-shatavari-03.jpg,cm-gal-shatavari-04.jpg,cm-gal-shatavari-05.jpg,cm-gal-shatavari-06.jpg,cm-gal-shatavari-07.jpg'
      when 'vitex-extracto'
        assign gal_list = 'cm-gal-vitex-01.jpg,cm-gal-vitex-03.jpg,cm-gal-vitex-04.jpg,cm-gal-vitex-05.jpg,cm-gal-vitex-06.jpg,cm-gal-vitex-07.jpg'
      when 'tulsi-full-polvo'
        assign gal_list = 'cm-gal-tulsi-01.jpg,cm-gal-tulsi-03.jpg,cm-gal-tulsi-04.jpg,cm-gal-tulsi-05.jpg,cm-gal-tulsi-06.jpg,cm-gal-tulsi-07.jpg,cm-gal-tulsi-08.jpg'
      when 'gotu-kola'
        assign gal_list = 'cm-gal-gotukola-01.jpg,cm-gal-gotukola-03.jpg,cm-gal-gotukola-04.jpg,cm-gal-gotukola-05.jpg,cm-gal-gotukola-06.jpg,cm-gal-gotukola-07.jpg'
      when 'astragalus-full-polvo'
        assign gal_list = 'cm-gal-astragalo-01.jpg,cm-gal-astragalo-03.jpg,cm-gal-astragalo-04.jpg,cm-gal-astragalo-05.jpg,cm-gal-astragalo-06.jpg,cm-gal-astragalo-07.jpg'
      when 'amla-full-polvo'
        assign gal_list = 'cm-gal-amla-01.jpg,cm-gal-amla-03.jpg,cm-gal-amla-04.jpg,cm-gal-amla-05.jpg,cm-gal-amla-06.jpg,cm-gal-amla-07.jpg'
      when 'gingko-biloba-y-bacopa'
        assign gal_list = 'cm-gal-ginkgo-bacopa-01.jpg,cm-gal-ginkgo-bacopa-03.jpg,cm-gal-ginkgo-bacopa-04.jpg,cm-gal-ginkgo-bacopa-05.jpg,cm-gal-ginkgo-bacopa-06.jpg,cm-gal-ginkgo-bacopa-07.jpg'
    endcase
  -%}
  {%- if gal_list != blank -%}
  {%- assign ga = gal_list | split: ',' -%}
  <div class="gal gsl" data-gsl>
    <div class="gstage">
    <div class="gtrack" tabindex="0" aria-label="Galería de {{ name | escape }}">
      {%- assign glast = ga | last | strip -%}{%- assign gfirst = ga | first | strip -%}<div class="gslide" aria-hidden="true"><img src="{{ glast | asset_url }}" alt="" width="1400" height="1400" loading="lazy"></div>
      {%- for a in ga -%}<div class="gslide">{%- assign af = a | strip -%}<img src="{{ af | asset_url }}" alt="{{ name | escape }} · imagen {{ forloop.index }}" width="1400" height="1400" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">{%- if forloop.first and s.badge != blank -%}<span class="badge">{{ s.badge }}</span>{%- endif -%}</div>{%- endfor -%}<div class="gslide" aria-hidden="true"><img src="{{ gfirst | asset_url }}" alt="" width="1400" height="1400" loading="lazy"></div>
    </div>
    <button type="button" class="garr gprev" aria-label="Anterior" data-gp>‹</button><button type="button" class="garr gnext" aria-label="Siguiente" data-gn>›</button>
    </div>
    <div class="gthumbs">{%- for a in ga -%}{%- assign af = a | strip -%}<button type="button" class="gth{% if forloop.first %} on{% endif %}" data-gi="{{ forloop.index0 }}" aria-label="Ver imagen {{ forloop.index }}"><img src="{{ af | asset_url }}" alt="" width="120" height="120" loading="lazy"></button>{%- endfor -%}</div>
  </div>
  <style>
  .gsl{position:relative;min-width:0;display:block !important;height:auto !important}.gsl .gstage{position:relative}
  .gsl .gtrack{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .gsl .gtrack::-webkit-scrollbar{display:none}
  .gsl .gslide{flex:0 0 100%;scroll-snap-align:start;position:relative;aspect-ratio:1;background:#f7f8f3}
  .gsl .gslide img{width:100%;height:100%;object-fit:cover;display:block}
  .gsl .garr{position:absolute;top:calc(50% - 22px);z-index:2;width:44px;height:44px;border-radius:50%;border:1px solid var(--ink,#141a16);background:rgba(255,255,255,.9);font-size:24px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ink,#141a16)}
  .gsl .gprev{left:12px}.gsl .gnext{right:12px}
  .gsl .gthumbs{display:grid;grid-template-columns:repeat(9,1fr);gap:8px;margin-top:10px}
  .gsl .gth{padding:0;border:1px solid transparent;background:none;cursor:pointer;aspect-ratio:1;opacity:.6}
  .gsl .gth.on{border-color:var(--ink,#141a16);opacity:1}
  .gsl .gth img{width:100%;height:100%;object-fit:cover;display:block}
  @media (max-width:749px){.gsl .garr{display:none}.gsl .gthumbs{display:flex;justify-content:center;gap:6px;margin-top:12px}.gsl .gth{width:7px;height:7px;border-radius:50%;background:#c9cbc4;border:0;opacity:1}.gsl .gth.on{background:var(--ink,#141a16)}.gsl .gth img{display:none}}
  </style>
  <script>
  (function(){ document.querySelectorAll('[data-gsl]').forEach(function(g){ if (g.__ok) return; g.__ok = 1;
    var tr = g.querySelector('.gtrack'), th = g.querySelectorAll('.gth'), n = th.length, tm;
    var W = function(){ return tr.clientWidth; };
    var jump = function(r){ tr.style.scrollSnapType = 'none'; tr.scrollLeft = r * W(); tr.offsetHeight; tr.style.scrollSnapType = ''; };
    var raw = function(){ return Math.round(tr.scrollLeft / W()); };
    var real = function(){ return ((raw() - 1) % n + n) % n; };
    var mark = function(){ var i = real(); th.forEach(function(b, k){ b.classList.toggle('on', k === i); }); };
    var go = function(i){ tr.scrollTo({ left: (i + 1) * W(), behavior: 'smooth' }); };
    requestAnimationFrame(function(){ jump(1); });
    tr.addEventListener('scroll', function(){ mark(); clearTimeout(tm); tm = setTimeout(function(){ var r = raw(); if (r <= 0) jump(n); else if (r >= n + 1) jump(1); mark(); }, 140); }, { passive: true });
    g.addEventListener('click', function(e){ var b = e.target.closest('[data-gi]'); if (b) go(+b.dataset.gi); if (e.target.closest('[data-gp]')) go(raw() - 2); if (e.target.closest('[data-gn]')) go(raw()); });
    tr.addEventListener('keydown', function(e){ if (e.key === 'ArrowRight') go(raw()); if (e.key === 'ArrowLeft') go(raw() - 2); });
    window.addEventListener('resize', function(){ jump(raw()); });
  }); })();
</script>
  {%- else -%}
  <div class="gal">
    {%- assign m = product.media -%}
    <div class="gimg">
      {%- if m[0] -%}{{ m[0] | image_url: width: 1400 | image_tag: class: 'prod', loading: 'eager', sizes: '(min-width: 990px) 50vw, 100vw' }}{%- endif -%}
      {%- if s.badge != blank -%}<span class="badge">{{ s.badge }}</span>{%- endif -%}
    </div>
    {%- if m[1] or m[2] -%}
    <div class="gpair">
      {%- if m[1] -%}<div class="gimg">{{ m[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '25vw' }}</div>{%- endif -%}
      {%- if m[2] -%}<div class="gimg">{{ m[2] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '25vw' }}</div>{%- endif -%}
    </div>
    {%- endif -%}
  </div>
  {%- endif -%}
  <div class="bcol">
    <div class="bbox">
      {%- if s.line_label != blank -%}<span class="lab">{{ s.line_label }}</span>{%- endif -%}
      <h1 class="disp h2" style="margin: 0">{{ name }}</h1>
      {%- if s.sci != blank -%}<p class="sci">{{ s.sci }}</p>{%- endif -%}
      {%- if rnum > 0 and nnum > 0 -%}<a class="rating" href="#resenas" style="text-decoration:none;color:inherit"><b aria-label="{{ rating }} de 5">★★★★★</b><span>{{ rating | round: 1 }} · Reseñas</span></a>{%- endif -%}
      {%- if s.needs != blank -%}<div class="tags">{%- assign nn = s.needs | split: ',' -%}{%- for n in nn -%}<span class="tag">{{ n | strip }}</span>{%- endfor -%}</div>{%- endif -%}
      {%- if s.claim != blank -%}<p style="margin: 0; font-size: 18px">{{ s.claim }}</p>{%- endif -%}
      {%- if s.ev_quick != blank -%}<a class="evq" href="#evidencia"><span class="dt"></span>{{ s.ev_quick }}<span class="go">Ver evidencia ↓</span></a>{%- endif -%}
      {%- if s.ten != blank -%}
      <div class="ten"><div class="tenh lab">En 10 segundos</div><dl>
        {%- assign rows = s.ten | newline_to_br | split: '<br />' -%}
        {%- for r in rows -%}{%- assign kv = r | strip | split: ':' -%}{%- if kv.size > 1 -%}<dt>{{ kv[0] | strip }}</dt><dd>{{ r | strip | remove_first: kv[0] | remove_first: ':' | strip }}</dd>{%- endif -%}{%- endfor -%}
      </dl></div>
      {%- endif -%}

      <form method="post" action="{{ routes.cart_add_url }}" data-form>
        <input type="hidden" name="id" value="{{ cur.id }}" data-vid>
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="selling_plan" value="" data-plan>
        {%- unless product.has_only_default_variant -%}
        <span class="lab">Presentación</span>
        <div class="optset">
          {%- for v in product.variants -%}
          {%- assign hint = '' -%}
          {%- assign hl = s.opt_hints | newline_to_br | split: '<br />' -%}
          {%- for h in hl -%}{%- assign hp = h | strip | split: '|' -%}{%- if hp[0] == v.title -%}{%- assign hint = hp[1] -%}{%- endif -%}{%- endfor -%}
          <button type="button" class="opt{% if v.id == cur.id %} sel{% endif %}" data-v="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros }}" data-title="{{ v.title | escape }}" data-carry="{% if v.title contains 'Carry' or v.title contains '50' %}1{% endif %}"{% unless v.available %} disabled{% endunless %}>
            <span><b>{{ v.title }}</b>{%- if hint != '' -%}<span class="hint">{{ hint }}</span>{%- endif -%}</span><span class="num">{{ v.price | money_without_trailing_zeros }}</span>
          </button>
          {%- endfor -%}
        </div>
        {%- endunless -%}
        {%- if has_sub -%}
        {%- assign plan = product.selling_plan_groups.first.selling_plans.first -%}
        <span class="lab">¿Cómo lo quieres?</span>
        <div class="pmode" role="radiogroup" aria-label="Cómo lo quieres">
          <button type="button" class="pm on" data-mode="0" role="radio" aria-checked="true"><span class="rd"></span><span class="pmt"><b>Compra única</b><small>Pagas una vez</small></span><span class="pmp"><span class="num" data-price>{{ cur.price | money_without_trailing_zeros }}</span></span></button>
          <button type="button" class="pm" data-mode="1" data-plan-id="{{ plan.id }}" role="radio" aria-checked="false"><span class="rd"></span><span class="pmt"><b>Suscríbete y ahorra</b>{%- if s.sub_save != blank -%}<span class="save">{{ s.sub_save }}</span>{%- endif -%}<small>{{ plan.name }}</small></span><span class="pmp"><span class="num">{{ cur.selling_plan_allocations.first.price | default: cur.price | money_without_trailing_zeros }}</span></span></button>
        </div>
        {%- if s.sub_benefits != blank -%}<ul class="subben" data-subben hidden>{%- assign sb = s.sub_benefits | newline_to_br | split: '<br />' -%}{%- for b in sb -%}<li>{{ b | strip }}</li>{%- endfor -%}</ul>{%- endif -%}
        {%- endif -%}
        <button type="submit" class="btn dark full" data-add style="border: 0; cursor: pointer; width: 100%"><span data-cta>Agregar al carrito · {{ cur.price | money_without_trailing_zeros }}</span><span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></button>
      </form>

      {%- liquid
        assign pf_act = ''
        assign pf_dose = ''
        assign pf_p = 0
        assign pf_c = 0
        if s.ten != blank
          assign tr = s.ten | newline_to_br | split: '<br />'
          for r in tr
            if r contains 'Estandarizado'
              assign pf_act = r | split: ':' | last | strip
            endif
          endfor
        endif
        if s.cmp != blank
          assign cr = s.cmp | newline_to_br | split: '<br />'
          for r in cr
            assign kv = r | strip | split: '|'
            if kv[0] contains 'Cuánto'
              assign pf_dose = kv[1] | strip | split: ' de ' | first
            endif
          endfor
        endif
        for v in product.variants
          if v.title contains 'Polvo' and v.title contains '100'
            assign pf_p = v.price | divided_by: 200.0 | round
          endif
          if v.title contains 'Cápsulas 120'
            assign pf_c = v.price | divided_by: 120.0 | round
          endif
        endfor
      -%}
      {%- if pf_act != '' or pf_dose != '' or pf_p > 0 -%}
      <div class="cm-prooft" aria-label="Lo que hay en el frasco">
        {%- if pf_act != '' -%}{%- assign a1 = pf_act | split: ' ' | first -%}<div><b class="num">{{ a1 }}</b><span>{{ pf_act | remove_first: a1 | strip }}, declarado en la etiqueta</span></div>{%- endif -%}
        {%- if pf_dose != '' -%}<div><b class="num">{{ pf_dose }}</b><span>al día de extracto</span></div>{%- endif -%}
        {%- if pf_p > 0 -%}<div><b class="num">{{ pf_p | money_without_trailing_zeros | remove: " " }}</b><span>al día en polvo de 100 g{% if pf_c > 0 %} · {{ pf_c | money_without_trailing_zeros | remove: " " }} en cápsula{% endif %}</span></div>{%- elsif pf_c > 0 -%}<div><b class="num">{{ pf_c | money_without_trailing_zeros | remove: " " }}</b><span>al día en cápsula</span></div>{%- endif -%}
      </div>
      {%- if s.cmp != blank and s.big != blank -%}<a class="tlink cm-prooflink" href="#porcion" style="align-self: flex-start">Compáralo con un polvo común ↓</a>{%- endif -%}
      {%- endif -%}

      {%- if s.show_volume -%}<div class="volnote" data-vol>{%- if s.line_label contains 'Science' -%}<span>Súmalo a tu protocolo: 10% al llevar 2 o más productos</span>{%- else -%}<span>Lleva 2 frascos y ahorra 10% · 3 o más, 15%</span>{%- endif -%}<a class="tlink" href="/#protocolo">Arma tu protocolo</a></div>{%- endif -%}
      <div class="perks"><span>Envío gratis desde $999</span><span>3 meses sin intereses</span><span>Te asesora una persona por WhatsApp</span></div>
      <a class="tlink" href="/pages/quiz-commons" style="align-self: flex-start">¿Es para ti? Haz el quiz</a>
      <div class="bacc">
        {%- for block in section.blocks -%}
        {%- if block.type == 'acc' -%}{%- unless block.settings.title contains 'Envío' -%}
        <details class="ai" {{ block.shopify_attributes }}><summary class="ah"><span>{{ block.settings.title }}</span><span aria-hidden="true">+</span></summary><div class="ab">{%- if block.settings.text != blank -%}{{ block.settings.text }}{%- elsif block.settings.title == 'Beneficios' -%}{{ product.description }}{%- endif -%}</div></details>
        {%- endunless -%}{%- elsif block.type == 'nut' -%}
        <details class="ai" {{ block.shopify_attributes }}><summary class="ah"><span>{{ block.settings.title | default: 'Tabla nutrimental' }}</span><span aria-hidden="true">+</span></summary><div class="ab">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Tabla nutrimental', style: 'width:100%;height:auto;background:#fff' }}{%- endif -%}{{ block.settings.text }}</div></details>
        {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if s.shipping != blank -%}<div class="shipv"><span class="lab">Envío y devoluciones</span><div>{{ s.shipping }}</div></div>{%- endif -%}
    </div>
  </div>
</section>

{%- if s.forr != blank -%}
<section aria-labelledby="fp-{{ section.id }}">
  <div class="hd-row"><h2 id="fp-{{ section.id }}" class="lab" style="margin: 0; font-size: 14px">Formulado para acompañar:</h2></div>
  <div class="forrows">
    {%- assign fr = s.forr | newline_to_br | split: '<br />' -%}
    {%- for f in fr -%}{%- assign t = f | strip -%}{%- if t != '' -%}
    {%- assign d = 'M10 38 C10 20 22 10 40 8 C38 26 28 38 10 38 Z M10 38 L28 20' -%}{%- assign tl = t | downcase -%}
    {%- if tl contains 'estr' or tl contains 'calma' -%}{%- assign d = 'M8 16 C12 10 16 10 20 16 C24 22 28 22 32 16 C36 10 40 10 40 13 M8 25 C12 21.5 16 21.5 20 25 C24 28.5 28 28.5 32 25 C36 21.5 40 21.5 40 23.5 M8 34 L40 34' -%}{%- elsif tl contains 'sue' -%}{%- assign d = 'M7 23 C12 32 36 32 41 23 M11.5 28.5 L8.5 32.5 M17.5 31 L16 35.8 M24 31.8 L24 36.8 M30.5 31 L32 35.8 M36.5 28.5 L39.5 32.5 M30 8 H37 L30 16 H37' -%}{%- elsif tl contains 'nimo' -%}{%- assign d = 'M6 35 L42 35 M12.5 35 A11.5 11.5 0 0 1 35.5 35 M39.22 30.06 L44.92 28.2 M33.4 22.06 L36.93 17.2 M24 19 L24 13 M14.6 22.06 L11.07 17.2 M8.78 30.06 L3.08 28.2' -%}{%- elsif tl contains 'enfoque' or tl contains 'claridad' or tl contains 'memoria' -%}{%- assign d = 'M36 27 A15 15 0 1 1 21 12 M30 27 A9 9 0 1 1 21 18 M21 27 L40 8 M35 7 L40 8 L41 13' -%}{%- endif -%}
