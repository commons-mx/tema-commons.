{%- liquid
  assign s = section.settings
  assign cur = product.selected_or_first_available_variant
  assign has_sub = false
  if product.selling_plan_groups.size > 0
    assign has_sub = true
  endif
  assign rating = product.metafields.loox.avg_rating.value | default: product.metafields.reviews.rating.value.rating
  assign nrev = product.metafields.loox.num_reviews.value | default: product.metafields.reviews.rating_count.value
  assign name = s.short_name | default: product.title
  assign rnum = rating | plus: 0
  assign nnum = nrev | plus: 0
-%}
{{ 'cm-pg-producto.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmp-{{ section.id }}" data-cmp>
<div class="v4 tA acY{% if s.product_color != blank %} pc{% endif %}" style="--pc:#141A16;--pc2:#EEEFA8;">

<div class="stickybar" aria-label="Compra rápida">
  <span class="sbname">{{ name }}</span>
  <div class="sbright">
    <div class="sbsel"><span data-optlabel>{{ cur.title }}</span><span class="num" data-price>{{ cur.price | money_without_trailing_zeros }}</span></div>
    <button type="button" class="sbbtn" data-add>Agregar al carrito</button>
  </div>
</div>

<section class="buy" aria-label="Comprar {{ name | escape }}">
  {%- liquid
