      when 'cordyceps-extracto-commons'
        assign gal_list = 'cm-gal-cordyceps-01.jpg,cm-gal-cordyceps-03.jpg,cm-gal-cordyceps-04.jpg,cm-gal-cordyceps-05.jpg,cm-gal-cordyceps-06.jpg,cm-gal-cordyceps-07.jpg,cm-gal-cordyceps-08.jpg,cm-gal-cordyceps-09.jpg'
      when 'master-blend-160-capsulas'
        assign gal_list = 'cm-gal-master-blend-01.jpg,cm-gal-master-blend-03.jpg,cm-gal-master-blend-04.jpg,cm-gal-master-blend-05.jpg,cm-gal-master-blend-06.jpg,cm-gal-master-blend-07.jpg'
      when 'chaga'
        assign gal_list = 'cm-gal-chaga-01.jpg,cm-gal-chaga-03.jpg,cm-gal-chaga-04.jpg,cm-gal-chaga-05.jpg,cm-gal-chaga-06.jpg,cm-gal-chaga-07.jpg,cm-gal-chaga-08.jpg'
      when 'hongo-cola-de-pavo-full-polvo'
