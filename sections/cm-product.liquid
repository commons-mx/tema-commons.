<script>
(function(){
  var root = document.getElementById('cmp-{{ section.id }}'); if (!root) return;
  var vid = root.querySelector('[data-vid]'), plan = root.querySelector('[data-plan]');
  var cta = root.querySelector('[data-cta]'), vol = root.querySelector('[data-vol]'), subben = root.querySelector('[data-subben]');
  var price = '{{ cur.price | money_without_trailing_zeros }}', mode = 0;
  function paint(){
    root.querySelectorAll('[data-price]').forEach(function(e){ if (e.tagName !== 'BUTTON') e.textContent = price; });
    if (cta) cta.textContent = (mode ? 'Suscribirme' : 'Agregar al carrito') + ' · ' + price;
  }
  root.querySelectorAll('.opt').forEach(function(b){ b.addEventListener('click', function(){
    root.querySelectorAll('.opt').forEach(function(x){ x.classList.remove('sel'); }); b.classList.add('sel');
    vid.value = b.dataset.v; price = b.dataset.price;
    var l = root.querySelector('[data-optlabel]'); if (l) l.textContent = b.dataset.title;
    if (vol) vol.hidden = !!b.dataset.carry;
    var u = new URL(location.href); u.searchParams.set('variant', b.dataset.v); history.replaceState(null, '', u);
    paint();
  }); });
  root.querySelectorAll('.pm').forEach(function(b){ b.addEventListener('click', function(){
    root.querySelectorAll('.pm').forEach(function(x){ x.classList.remove('on'); x.setAttribute('aria-checked','false'); });
    b.classList.add('on'); b.setAttribute('aria-checked','true'); mode = +b.dataset.mode;
    plan.value = mode ? (b.dataset.planId || '') : ''; if (subben) subben.hidden = !mode; paint();
  }); });
  function add(id, sp, btn){
    var body = { items: [{ id: +id, quantity: 1 }] }; if (sp) body.items[0].selling_plan = +sp;
    return fetch('{{ routes.cart_add_url }}.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body) })
      .then(function(r){ if (!r.ok) throw r; return r.json(); })
      .then(function(){ if (window.Alpine && Alpine.store('xMiniCart')) { Alpine.store('xMiniCart').reLoad && Alpine.store('xMiniCart').reLoad(); Alpine.store('xMiniCart').openCart(); } else { location.href = '{{ routes.cart_url }}'; } })
      .catch(function(){ location.href = '{{ routes.cart_url }}'; });
  }
  var form = root.querySelector('[data-form]');
  if (form) form.addEventListener('submit', function(e){ e.preventDefault(); add(vid.value, plan.value); });
  root.querySelectorAll('.sbbtn').forEach(function(b){ b.addEventListener('click', function(){ add(vid.value, plan.value); }); });
  root.querySelectorAll('[data-comp]').forEach(function(b){ b.addEventListener('click', function(){
    if (b.classList.contains('on')) return; b.classList.add('on'); b.textContent = '✓ Agregado'; add(b.dataset.comp);
  }); });
  var sel = root.querySelector('.opt.sel'); if (sel && vol) vol.hidden = !!sel.dataset.carry;
})();
</script>
<style>/* tira de prueba (se oculta si la ficha trae la comparativa CRO) */
body:has([data-cmpz-tira]) #cmp-{{ section.id }} .cm-prooft,body:has([data-cmpz-tira]) #cmp-{{ section.id }} .cm-prooflink{display:none !important}
#cmp-{{ section.id }} .cm-prooft{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #141A16;border-bottom:1px solid #D9D6CC}
#cmp-{{ section.id }} .cm-prooft>div{display:flex;flex-direction:column;gap:6px;padding:16px 14px 16px 0}
#cmp-{{ section.id }} .cm-prooft>div+div{padding-left:14px;border-left:1px solid #D9D6CC}
#cmp-{{ section.id }} .cm-prooft b{font-size:30px;line-height:1;font-weight:500;letter-spacing:-.01em}
#cmp-{{ section.id }} .cm-prooft span{font-size:13px;line-height:1.4;color:#5A5F58}
#cmp-{{ section.id }} #porcion{scroll-margin-top:90px}
@media (max-width:749px){#cmp-{{ section.id }} .cm-prooft b{font-size:24px}#cmp-{{ section.id }} .cm-prooft>div{padding-right:8px}#cmp-{{ section.id }} .cm-prooft>div+div{padding-left:10px}}
</style>
<style>/* evidencia legible */
#cmp-{{ section.id }} .evx{outline:0 !important;border:0 !important;padding:0 !important;background:transparent !important;gap:14px !important}
#cmp-{{ section.id }} .evx-hd{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
#cmp-{{ section.id }} .evx-study{background:#fff;border:1px solid #D9D6CC;padding:20px 22px;display:flex;flex-direction:column;gap:12px}
#cmp-{{ section.id }} .evx-study dl{margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
#cmp-{{ section.id }} .evx-study dt{font:500 11px/1.2 var(--fl,Figtree),sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#5A5F58;margin-bottom:4px}
#cmp-{{ section.id }} .evx-study dd{margin:0;font-size:16px;line-height:1.35}
#cmp-{{ section.id }} .evx-find{background:#EFEBE3;padding:20px 22px;display:flex;flex-direction:column;gap:10px}
#cmp-{{ section.id }} .evx-find p{margin:0;font-size:18px;line-height:1.5}
#cmp-{{ section.id }} .evx-ft{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding-top:12px;border-top:1px solid #E6E3DA}
#cmp-{{ section.id }} .evx-ft .small{color:#5A5F58}
#cmp-{{ section.id }} .evx-go{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 16px;border:1px solid #141A16;border-radius:999px;font-size:14px;font-weight:500;color:#141A16;text-decoration:none;white-space:nowrap}
#cmp-{{ section.id }} .evx-go:hover{background:#141A16;color:#fff}
#cmp-{{ section.id }} .evx-more{display:flex;flex-direction:column;gap:10px;margin-top:10px}
#cmp-{{ section.id }} .evx-card{background:#fff;border:1px solid #D9D6CC;padding:18px 22px;display:flex;flex-direction:column;gap:12px}
#cmp-{{ section.id }} .evx-cf{margin:0;font-size:16px;line-height:1.45;font-weight:500}
@media (max-width:749px){#cmp-{{ section.id }} .evx-study,#cmp-{{ section.id }} .evx-find,#cmp-{{ section.id }} .evx-card{padding:16px}#cmp-{{ section.id }} .evx-find p{font-size:16px}}
</style>
