{{ 'cm-pg-puntos.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmpg-{{ section.id }}">
<div class="v4 tA acY">


<!-- 1 · DÓNDE ENCONTRARNOS -->
<section class="pv-hero" aria-labelledby="ph">
<div class="cell"><span class="lab">Puntos de venta</span><h1 id="ph" class="disp h1" style="max-width: 10ch">Encuéntranos cerca de ti.</h1></div>
<div class="cell"><p class="sub">Estamos en 5 cadenas y en más de 80 tiendas orgánicas y de wellness en todo México. O pide en línea: envío gratis desde $999.</p>
<div class="pv-search"><span>Ciudad o código postal</span><a class="btn dark" href="#cd">Buscar<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div></div>
</section>

<!-- 2 · CADENAS -->
<section aria-labelledby="cd">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Cadenas</span><h2 id="cd" class="disp h2">En tus tiendas de siempre.</h2></div></div>
<div class="pv-chains"><div><b>Liverpool</b><span class="small">Tiendas departamentales</span></div><div><b>HEB</b><span class="small">Supermercados</span></div><div><b>Sanborns</b><span class="small">Tiendas en todo el país</span></div><div><b>Fresko La Comer</b><span class="small">Supermercados</span></div><div><b>Farmacias San Pablo</b><span class="small">Farmacias</span></div><div><b>Alsuper</b><span class="small">Supermercados</span></div></div>
<p class="pv-note">Cada cadena y cada sucursal tiene productos distintos. Si buscas uno en específico, aquí en línea está todo el catálogo.</p>
</section>

<style>/* tiendas tarjetas */
.cmpg .cm-dir,.cm4 .cm-dir{gap:12px !important;padding:0 20px}
.cmpg .cm-dir > div,.cm4 .cm-dir > div{background:#fff;border:1px solid #D9D6CC !important;border-radius:14px;padding:18px 18px 6px !important}
.cmpg .cm-dir h3,.cm4 .cm-dir h3{margin:0 0 4px;padding-bottom:12px;border-bottom:2px solid #141A16}
.cmpg .cm-dir ul,.cm4 .cm-dir ul{margin:0;padding:0;list-style:none;border:0 !important}
.cmpg .cm-dir li,.cm4 .cm-dir li{padding:12px 0 !important;border-bottom:1px solid #E6E3DA;display:flex;flex-direction:column;gap:3px}
.cmpg .cm-dir li:last-child,.cm4 .cm-dir li:last-child{border-bottom:0}
</style>
<!-- 3 · TIENDAS ESPECIALIZADAS -->
<section aria-labelledby="ti">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Tiendas independientes</span><h2 id="ti" class="disp h2">Y en tiendas que comparten lo que hacemos.</h2></div></div>
<div class="cm-dir"><div><h3>CDMX</h3><ul><li><b>Numu Market</b><span>Tienda orgánica · Coyoacán</span></li><li><b>Latte Latte Café</b><span>Cafetería · Polanco</span></li><li><b>Farmacia París</b><span>Farmacia · Centro</span></li></ul></div><div><h3>Puebla</h3><ul><li><b>Better Mood Coffee</b><span>Cafetería · Puebla</span></li><li><b>Nirvana</b><span>Tienda · Puebla</span></li></ul></div><div><h3>Jalisco</h3><ul><li><b>Flor a Semilla</b><span>Cafetería · Guadalajara</span></li></ul></div><div><h3>Guanajuato</h3><ul><li><b>Rehiletes</b><span>Tienda · San Miguel de Allende</span></li><li><b>Voltmind</b><span>Tienda · León</span></li><li><b>Mercadito La Harinera</b><span>Tienda · Irapuato</span></li></ul></div><div><h3>Querétaro</h3><ul><li><b>Orgánico San Cosme</b><span>Tienda y cafetería · Querétaro</span></li></ul></div><div><h3>San Luis Potosí</h3><ul><li><b>Biótica Proyecto Sano</b><span>Tienda · San Luis Potosí</span></li><li><b>Vitruvius</b><span>Tienda · Matehuala</span></li></ul></div><div><h3>Aguascalientes</h3><ul><li><b>Terravi</b><span>Tienda · Aguascalientes</span></li></ul></div><div><h3>Baja California Sur</h3><ul><li><b>ChezBlue</b><span>Cafetería · San José del Cabo</span></li><li><b>Pueblita Bonita</b><span>Restaurante · Cabo San Lucas</span></li></ul></div><div><h3>Baja California</h3><ul><li><b>Fermega Bebidas y Alimentos</b><span>Restaurante · Mexicali</span></li></ul></div></div>
<p class="pv-note">Cada tienda maneja productos distintos. Escríbeles antes de ir o pide todo el catálogo aquí en línea.</p>
</section>
<style>.cm-dir{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0 24px;border-top:1px solid var(--rule,#141a16);margin:0 40px}@media(max-width:749px){.cm-dir{margin:0 20px}}.cm-dir>div{padding:22px 24px 24px 0;border-bottom:1px solid var(--rule,#141a16)}.cm-dir h3{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;margin:0 0 12px}.cm-dir ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}.cm-dir li b{display:block;font-weight:500}.cm-dir li span{font-size:14px;color:#5a5f58}</style>
<section class="pv-two" aria-label="Otras formas de comprar">
<div class="cell yellow"><span class="lab">En línea</span><h2 class="disp h2" style="max-width: 12ch">Todo Commons en commons.mx.</h2><p class="sub" style="color: #2C342F">El catálogo completo, envío gratis desde $999 y descuento por volumen: 2 frascos −10%, 3 o más −15%.</p><a class="btn dark" href="/collections/tienda" style="align-self: flex-start">Comprar en línea<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div>
<div class="cell"><span class="lab">¿Tienes una tienda?</span><h2 class="disp h2" style="max-width: 12ch">Vende Commons.</h2><p class="sub">Para tiendas, cafés, spas y estudios. Un solo precio de mayoreo y catálogo a tu correo.</p><a class="sq" href="/pages/benefecios-ser-distribuidor" style="align-self: flex-start">Ir a Mayoreo</a></div>
</section>


</div>
</div>
<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var D = [["CDMX", "Orgánica"], ["CDMX", "Wellness"], ["CDMX", "Concept store"], ["CDMX", "Café"], ["Jalisco", "Orgánica"], ["Jalisco", "Wellness"], ["Nuevo León", "Orgánica"], ["Nuevo León", "Wellness"], ["Querétaro", "Orgánica"], ["Yucatán", "Wellness"], ["Otros estados", "Orgánica"], ["Otros estados", "Wellness"]];
function pick(i){ root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.classList.toggle('on', +x.dataset.i === i); });
  var c = root.querySelector('.pv-card'); if (c){ c.querySelector('[data-k]').textContent = D[i][1]; c.querySelector('[data-n]').textContent = '[Tienda ' + (i + 1) + ']'; c.querySelector('[data-s]').textContent = D[i][0]; } }
root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.addEventListener('click', function(){ pick(+x.dataset.i); }); });
function count(){ var n = 0; root.querySelectorAll('.pv-shop').forEach(function(x){ if (!x.hidden) n++; }); var c = root.querySelector('[data-count]'); if (c) c.textContent = n + ' tiendas (ejemplo)'; }
root.querySelectorAll('[data-st]').forEach(function(b){ if (b.tagName !== 'BUTTON' || b.classList.contains('pv-shop') || b.classList.contains('pv-pin')) return; b.addEventListener('click', function(){
  root.querySelectorAll('.pv-chips [data-st]').forEach(function(x){ x.classList.toggle('on', x === b); });
  root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.hidden = !!b.dataset.st && x.dataset.st !== b.dataset.st; }); count();
}); });
root.querySelectorAll('[data-view]').forEach(function(b){ b.addEventListener('click', function(){
  root.querySelectorAll('[data-view]').forEach(function(x){ x.classList.toggle('on', x === b); });
  var l = root.querySelector('[data-loc]'); l.classList.remove('m-lista', 'm-mapa'); l.classList.add('m-' + b.dataset.view);
}); });
count();
})();
</script>
