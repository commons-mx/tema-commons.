{{ 'cm-pg-puntos.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmpg-{{ section.id }}">
<div class="v4 tA acY">


<!-- 1 · DÓNDE ENCONTRARNOS -->
<section class="pv-hero" aria-labelledby="ph">
<div class="cell"><span class="lab">Puntos de venta</span><h1 id="ph" class="disp h1" style="max-width: 10ch">Encuéntranos cerca de ti.</h1></div>
<div class="cell"><p class="sub">Estamos en 5 cadenas y en más de 80 tiendas orgánicas y de wellness en todo México. O pide en línea: envío gratis desde $990.</p>
<div class="pv-search"><span>Ciudad o código postal</span><a class="btn dark" href="#tiendas">Buscar<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div></div>
</section>

<!-- 2 · CADENAS -->
<section aria-labelledby="cd">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Cadenas</span><h2 id="cd" class="disp h2">En tus tiendas de siempre.</h2></div></div>
<div class="pv-chains"><div><b>Liverpool</b><span class="small">Tiendas departamentales y en línea</span><a class="tlink" href="#" style="align-self: flex-start; margin-top: 6px">Ver tienda en línea</a></div><div><b>HEB</b><span class="small">Supermercados</span><a class="tlink" href="#" style="align-self: flex-start; margin-top: 6px">Ver tienda en línea</a></div><div><b>Sanborns</b><span class="small">Tiendas en todo el país</span><a class="tlink" href="#" style="align-self: flex-start; margin-top: 6px">Ver tienda en línea</a></div><div><b>Fresko La Comer</b><span class="small">Supermercados</span><a class="tlink" href="#" style="align-self: flex-start; margin-top: 6px">Ver tienda en línea</a></div><div><b>Farmacias San Pablo</b><span class="small">Farmacias</span><a class="tlink" href="#" style="align-self: flex-start; margin-top: 6px">Ver tienda en línea</a></div></div>
<p class="pv-note">La disponibilidad cambia por sucursal. [Qué líneas tiene cada cadena · confirmar]</p>
</section>

<!-- 3 · TIENDAS ESPECIALIZADAS -->
