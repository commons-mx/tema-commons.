<div class="pv-chips" role="tablist" aria-label="Estado"><button type="button" class="on" data-st="" role="tab">Todos</button><button type="button" class="" data-st="CDMX" role="tab">CDMX</button><button type="button" class="" data-st="Jalisco" role="tab">Jalisco</button><button type="button" class="" data-st="Nuevo León" role="tab">Nuevo León</button><button type="button" class="" data-st="Querétaro" role="tab">Querétaro</button><button type="button" class="" data-st="Yucatán" role="tab">Yucatán</button><button type="button" class="" data-st="Otros estados" role="tab">Otros estados</button><span class="small" data-count></span></div>
<div class="pv-view"><button type="button" class="on" data-view="lista">Lista</button><button type="button" data-view="mapa">Mapa</button></div>
<div class="pv-loc m-lista" data-loc>
<div class="pv-list"><button type="button" class="pv-shop on" data-i="0" data-st="CDMX"><b>[Tienda 1]</b><span class="small">CDMX · [Dirección]</span><span class="tag">Orgánica</span></button><button type="button" class="pv-shop" data-i="1" data-st="CDMX"><b>[Tienda 2]</b><span class="small">CDMX · [Dirección]</span><span class="tag">Wellness</span></button><button type="button" class="pv-shop" data-i="2" data-st="CDMX"><b>[Tienda 3]</b><span class="small">CDMX · [Dirección]</span><span class="tag">Concept store</span></button><button type="button" class="pv-shop" data-i="3" data-st="CDMX"><b>[Tienda 4]</b><span class="small">CDMX · [Dirección]</span><span class="tag">Café</span></button><button type="button" class="pv-shop" data-i="4" data-st="Jalisco"><b>[Tienda 5]</b><span class="small">Jalisco · [Dirección]</span><span class="tag">Orgánica</span></button><button type="button" class="pv-shop" data-i="5" data-st="Jalisco"><b>[Tienda 6]</b><span class="small">Jalisco · [Dirección]</span><span class="tag">Wellness</span></button><button type="button" class="pv-shop" data-i="6" data-st="Nuevo León"><b>[Tienda 7]</b><span class="small">Nuevo León · [Dirección]</span><span class="tag">Orgánica</span></button><button type="button" class="pv-shop" data-i="7" data-st="Nuevo León"><b>[Tienda 8]</b><span class="small">Nuevo León · [Dirección]</span><span class="tag">Wellness</span></button><button type="button" class="pv-shop" data-i="8" data-st="Querétaro"><b>[Tienda 9]</b><span class="small">Querétaro · [Dirección]</span><span class="tag">Orgánica</span></button><button type="button" class="pv-shop" data-i="9" data-st="Yucatán"><b>[Tienda 10]</b><span class="small">Yucatán · [Dirección]</span><span class="tag">Wellness</span></button><button type="button" class="pv-shop" data-i="10" data-st="Otros estados"><b>[Tienda 11]</b><span class="small">Otros estados · [Dirección]</span><span class="tag">Orgánica</span></button><button type="button" class="pv-shop" data-i="11" data-st="Otros estados"><b>[Tienda 12]</b><span class="small">Otros estados · [Dirección]</span><span class="tag">Wellness</span></button></div>
<div class="pv-map"><svg class="mx" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8 L30 6 L44 18 L56 22 L60 36 L58 48 L66 60 L76 52 L80 42 L96 40 L94 52 L86 62 L76 70 L64 76 L54 72 L44 66 L36 58 L30 48 L22 36 L14 30 L18 46 L22 58 L14 46 L8 30 Z" fill="#DCDCD5" stroke="#AEB3B8" stroke-width="0.4"></path></svg><button type="button" class="pv-pin on" style="left:52%;top:60%" data-i="0" data-st="CDMX" aria-label="[Tienda 1]"></button><button type="button" class="pv-pin" style="left:54%;top:62%" data-i="1" data-st="CDMX" aria-label="[Tienda 2]"></button><button type="button" class="pv-pin" style="left:51%;top:63%" data-i="2" data-st="CDMX" aria-label="[Tienda 3]"></button><button type="button" class="pv-pin" style="left:53%;top:59%" data-i="3" data-st="CDMX" aria-label="[Tienda 4]"></button><button type="button" class="pv-pin" style="left:38%;top:56%" data-i="4" data-st="Jalisco" aria-label="[Tienda 5]"></button><button type="button" class="pv-pin" style="left:37%;top:58%" data-i="5" data-st="Jalisco" aria-label="[Tienda 6]"></button><button type="button" class="pv-pin" style="left:52%;top:30%" data-i="6" data-st="Nuevo León" aria-label="[Tienda 7]"></button><button type="button" class="pv-pin" style="left:54%;top:31%" data-i="7" data-st="Nuevo León" aria-label="[Tienda 8]"></button><button type="button" class="pv-pin" style="left:49%;top:54%" data-i="8" data-st="Querétaro" aria-label="[Tienda 9]"></button><button type="button" class="pv-pin" style="left:84%;top:46%" data-i="9" data-st="Yucatán" aria-label="[Tienda 10]"></button><button type="button" class="pv-pin" style="left:30%;top:22%" data-i="10" data-st="Otros estados" aria-label="[Tienda 11]"></button><button type="button" class="pv-pin" style="left:62%;top:70%" data-i="11" data-st="Otros estados" aria-label="[Tienda 12]"></button><span class="pv-maptag">[Mapa real · Google Maps]</span>
<div class="pv-card"><span class="lab"><span data-k>Orgánica</span></span><b><span data-n>[Tienda 1]</span></b><span class="small"><span data-s>CDMX</span> · [Dirección y horario]</span><a class="tlink" href="#" style="align-self: flex-start; margin-top: 4px">Cómo llegar</a></div>
</div>
</div>
</section>

<!-- 4 · EN LÍNEA Y MAYOREO -->
<section class="pv-two" aria-label="Otras formas de comprar">
<div class="cell yellow"><span class="lab">En línea</span><h2 class="disp h2" style="max-width: 12ch">Todo Commons en commons.mx.</h2><p class="sub" style="color: #2C342F">El catálogo completo, envío gratis desde $990 y descuento por volumen: 2 frascos −10%, 3 o más −20%.</p><a class="btn dark" href="/collections/all" style="align-self: flex-start">Comprar en línea<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div>
<div class="cell"><span class="lab">¿Tienes una tienda?</span><h2 class="disp h2" style="max-width: 12ch">Vende Commons.</h2><p class="sub">Para tiendas, cafés, spas y estudios. Un solo precio de mayoreo y catálogo a tu correo.</p><a class="sq" href="/pages/benefecios-ser-distribuidor" style="align-self: flex-start">Ir a Mayoreo</a></div>
</section>


</div>
</div>
<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var D = [["CDMX", "Orgánica"], ["CDMX", "Wellness"], ["CDMX", "Concept store"], ["CDMX", "Café"], ["Jalisco", "Orgánica"], ["Jalisco", "Wellness"], ["Nuevo León", "Orgánica"], ["Nuevo León", "Wellness"], ["Querétaro", "Orgánica"], ["Yucatán", "Wellness"], ["Otros estados", "Orgánica"], ["Otros estados", "Wellness"]];
function pick(i){ root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.classList.toggle('on', +x.dataset.i === i); });
  var c = root.querySelector('.pv-card'); if (c){ c.querySelector('[data-k]').textContent = D[i][1]; c.querySelector('[data-n]').textContent = '[Tienda ' + (i + 1) + ']'; c.querySelector('[data-s]').textContent = D[i][0]; } }
root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.addEventListener('click', function(){ pick(+x.dataset.i); }); });
function count(){ var n = 0; root.querySelectorAll('.pv-shop').forEach(function(x){ if (!x.hidden) n++; }); var c = root.querySelector('[data-count]'); if (c) c.textContent = n + ' tiendas (ejemplo)'; }
root.querySelectorAll('[data-st]').forEach(function(b){ if (b.tagName !== 'BUTTON' || b.classList.contains('pv-shop') || b.classList.contains('pv-pin')) return; b.addEventListener('click', function(){
  root.querySelectorAll('.pv-chips [data-st]').forEach(function(x){ x.classList.toggle('on', x === b); });
  root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.hidden = !!b.dataset.st && x.dataset.st !== b.dataset.st; }); count();
}); });
root.querySelectorAll('[data-view]').forEach(function(b){ b.addEventListener('click', function(){
  root.querySelectorAll('[data-view]').forEach(function(x){ x.classList.toggle('on', x === b); });
  var l = root.querySelector('[data-loc]'); l.classList.remove('m-lista', 'm-mapa'); l.classList.add('m-' + b.dataset.view);
}); });
count();
})();
</script>
