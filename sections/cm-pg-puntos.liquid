{{ 'cm-pg-puntos.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmpg-{{ section.id }}">
<div class="v4 tA acY">


<!-- 1 · DÓNDE ENCONTRARNOS -->
<section class="pv-hero" aria-labelledby="ph">
<div class="cell"><span class="lab">Puntos de venta</span><h1 id="ph" class="disp h1" style="max-width: 10ch">Encuéntranos cerca de ti.</h1></div>
<div class="cell"><p class="sub">Estamos en 5 cadenas y en más de 80 tiendas orgánicas y de wellness en todo México. O pide en línea: envío gratis desde $990.</p>
<div class="pv-search"><span>Ciudad o código postal</span><a class="btn dark" href="#cd">Buscar<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div></div>
</section>

<!-- 2 · CADENAS -->
<section aria-labelledby="cd">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Cadenas</span><h2 id="cd" class="disp h2">En tus tiendas de siempre.</h2></div></div>
<div class="pv-chains"><div><b>Liverpool</b><span class="small">Tiendas departamentales</span></div><div><b>HEB</b><span class="small">Supermercados</span></div><div><b>Sanborns</b><span class="small">Tiendas en todo el país</span></div><div><b>Fresko La Comer</b><span class="small">Supermercados</span></div><div><b>Farmacias San Pablo</b><span class="small">Farmacias</span></div><div><b>Alsuper</b><span class="small">Supermercados</span></div></div>
<p class="pv-note">Cada cadena y cada sucursal tiene productos distintos. Si buscas uno en específico, aquí en línea está todo el catálogo.</p>
</section>

<!-- 3 · TIENDAS ESPECIALIZADAS -->
<section class="pv-two" aria-label="Otras formas de comprar">
<div class="cell yellow"><span class="lab">En línea</span><h2 class="disp h2" style="max-width: 12ch">Todo Commons en commons.mx.</h2><p class="sub" style="color: #2C342F">El catálogo completo, envío gratis desde $990 y descuento por volumen: 2 frascos −10%, 3 o más −15%.</p><a class="btn dark" href="/collections/all" style="align-self: flex-start">Comprar en línea<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div>
<div class="cell"><span class="lab">¿Tienes una tienda?</span><h2 class="disp h2" style="max-width: 12ch">Vende Commons.</h2><p class="sub">Para tiendas, cafés, spas y estudios. Un solo precio de mayoreo y catálogo a tu correo.</p><a class="sq" href="/pages/benefecios-ser-distribuidor" style="align-self: flex-start">Ir a Mayoreo</a></div>
</section>


</div>
</div>
<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var D = [["CDMX", "Orgánica"], ["CDMX", "Wellness"], ["CDMX", "Concept store"], ["CDMX", "Café"], ["Jalisco", "Orgánica"], ["Jalisco", "Wellness"], ["Nuevo León", "Orgánica"], ["Nuevo León", "Wellness"], ["Querétaro", "Orgánica"], ["Yucatán", "Wellness"], ["Otros estados", "Orgánica"], ["Otros estados", "Wellness"]];
function pick(i){ root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.classList.toggle('on', +x.dataset.i === i); });
  var c = root.querySelector('.pv-card'); if (c){ c.querySelector('[data-k]').textContent = D[i][1]; c.querySelector('[data-n]').textContent = '[Tienda ' + (i + 1) + ']'; c.querySelector('[data-s]').textContent = D[i][0]; } }
root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.addEventListener('click', function(){ pick(+x.dataset.i); }); });
function count(){ var n = 0; root.querySelectorAll('.pv-shop').forEach(function(x){ if (!x.hidden) n++; }); var c = root.querySelector('[data-count]'); if (c) c.textContent = n + ' tiendas (ejemplo)'; }
root.querySelectorAll('[data-st]').forEach(function(b){ if (b.tagName !== 'BUTTON' || b.classList.contains('pv-shop') || b.classList.contains('pv-pin')) return; b.addEventListener('click', function(){
  root.querySelectorAll('.pv-chips [data-st]').forEach(function(x){ x.classList.toggle('on', x === b); });
  root.querySelectorAll('.pv-shop,.pv-pin').forEach(function(x){ x.hidden = !!b.dataset.st && x.dataset.st !== b.dataset.st; }); count();
}); });
root.querySelectorAll('[data-view]').forEach(function(b){ b.addEventListener('click', function(){
  root.querySelectorAll('[data-view]').forEach(function(x){ x.classList.toggle('on', x === b); });
  var l = root.querySelector('[data-loc]'); l.classList.remove('m-lista', 'm-mapa'); l.classList.add('m-' + b.dataset.view);
}); });
count();
})();
</script>
{%- comment -%} v5 · puntos {%- endcomment -%}
