<div class="pl-fmts" role="radiogroup" aria-label="Presentación">{%- for v in rp.variants -%}<button type="button" class="{% if forloop.first %}on{% endif %}" role="radio" data-v="{{ v.id }}" data-p="{{ v.price | money_without_trailing_zeros }}" data-t="{{ v.title | replace: 'Carry On 50g', 'Polvo 50 g' | replace: 'Polvo 100g', 'Polvo 100 g' | escape }}"{% unless v.available %} disabled{% endunless %}><b>{{ v.title | replace: 'Carry On 50g', 'Polvo 50 g' | replace: 'Polvo 100g', 'Polvo 100 g' }}</b><span>{{ v.price | money_without_trailing_zeros }}</span></button>{%- endfor -%}</div>
<span class="small" data-fd>{{ rp.selected_or_first_available_variant.title | replace: 'Carry On 50g', 'Polvo 50 g' | replace: 'Polvo 100g', 'Polvo 100 g' }}</span>
<div class="row"><span class="num pl-price" data-fp>{{ rp.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span><button type="button" class="pl-add pl-btn" data-add data-v="{{ rp.selected_or_first_available_variant.id }}">Agregar al carrito</button></div>
<a class="tlink" href="{{ rp.url }}" style="align-self:flex-start">Ver la ficha completa</a>
