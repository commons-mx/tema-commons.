<div class="im"><a href="{{ rp.url }}"><img src="{%- if rp.featured_image -%}{{ rp.featured_image | image_url: width: 800 }}{%- endif -%}" loading="lazy" alt="{{ rp.title | escape }}"></a></div>
<div class="tx">
<span class="lab">Commons Botanicals</span>
<b class="disp">{{ rp.title }}</b>
<span class="small">25% betaglucanos · cuerpo fructífero</span>
