<div class="cm4" id="cm-prod-{{ section.id }}">
<section aria-labelledby="mv-{{ section.id }}">
  <div class="hd-row"><h2 id="mv-{{ section.id }}" class="disp h2">{{ section.settings.heading }}</h2><div class="hdl">{%- if section.settings.protocol_label != blank and section.settings.protocol_head -%}<a class="tlink" href="{{ section.settings.protocol_link | default: '#protocolo' }}">{{ section.settings.protocol_label }}</a>{%- endif -%}{%- if section.settings.link_label != blank -%}<a class="sq" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.link_label }}</a>{%- endif -%}</div></div>
  <div class="box cards">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p == blank -%}{%- continue -%}{%- endif -%}
      <article class="card" {{ block.shopify_attributes }}>
        <a class="ph" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
          {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 800 | image_tag: class: 'prod', loading: 'lazy', sizes: '(min-width: 760px) 25vw, 50vw' }}{%- endif -%}
          {%- if p.media.size > 1 -%}{{ p.media[1] | image_url: width: 800 | image_tag: class: 'alt', loading: 'lazy', alt: '', sizes: '(min-width: 760px) 25vw, 50vw' }}{%- endif -%}
          {%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge }}</span>{%- endif -%}
        </a>
        <div class="cardrow">
          <div>
            {%- liquid
  assign _t = p.type | downcase
  assign _ln = 'Botanicals'
  if _t contains 'science' or p.handle == 'azafran-1' or p.handle == 'magnesio-p-m'
    assign _ln = 'Science'
  elsif _t contains 'chocolate' or _t contains 'blend' or _t contains 'miel'
    assign _ln = 'Rituals'
  endif
-%}<span class="lab ctag">{{ block.settings.tag | default: _ln }}</span>
            <h3 class="cname"><a href="{{ p.url }}" style="color: inherit">{{ block.settings.title | default: p.title }}</a></h3>
            <div class="cmeta">{%- if p.variants.size > 1 -%}<span class="num">Desde {{ p.price_min | money_without_trailing_zeros }}</span> · {{ p.variants.size }} presentaciones{%- else -%}<span class="num">{{ p.price | money_without_trailing_zeros }}</span>{%- if block.settings.size != blank %} · {{ block.settings.size }}{% endif -%}{%- endif -%}</div>
            {%- if block.settings.per_serving != blank -%}<div class="cmeta">{{ block.settings.per_serving }}</div>{%- endif -%}
            {%- if section.settings.card_protocol != blank -%}<a class="ptadd" href="{{ section.settings.protocol_link | default: '#protocolo' }}">{{ section.settings.card_protocol }}</a>{%- endif -%}
          </div>
          {%- if p.variants.size > 1 -%}
            <details class="cm-qa"><summary class="cart" aria-label="Elegir presentación de {{ p.title | escape }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path></svg></summary>
              <div class="qa" role="dialog" aria-label="Presentaciones de {{ p.title | escape }}">
                <div class="qahead"><strong style="font-weight: 500">{{ p.title }}</strong></div>
                {%- for v in p.variants -%}
                <form method="post" action="{{ routes.cart_add_url }}" class="cm-addform">
                  <input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="1">
                  <button type="submit" class="opt"{% unless v.available %} disabled{% endunless %}><span>{{ v.title }}</span><span class="num">{{ v.price | money_without_trailing_zeros }}</span></button>
                </form>
                {%- endfor -%}
                {%- if section.settings.protocol_label != blank -%}<a class="tlink qapt" href="{{ section.settings.protocol_link | default: '#protocolo' }}">o súmalo a tu protocolo y ahorra hasta 15%</a>{%- endif -%}
              </div>
            </details>
          {%- else -%}
            <form method="post" action="{{ routes.cart_add_url }}" class="cm-addform"><input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="cart" aria-label="Agregar {{ p.title | escape }} al carrito"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path></svg></button></form>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>
</div>
<style>
  #cm-prod-{{ section.id }} .ph{display:block}
  #cm-prod-{{ section.id }} .cm-qa{position:static}
  #cm-prod-{{ section.id }} .cm-qa summary{list-style:none}
  #cm-prod-{{ section.id }} .cm-qa summary::-webkit-details-marker{display:none}
  #cm-prod-{{ section.id }} .cm-addform{margin:0}
</style>
{% schema %}
{
  "name": "Commons · Productos",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Los más queridos."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto de la liga",
      "default": "Ver todo"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Liga"
    },
    {
      "type": "text",
      "id": "protocol_label",
      "label": "Liga a Arma tu protocolo",
      "default": "Arma tu protocolo · hasta −15%"
    },
    {
      "type": "checkbox",
      "id": "protocol_head",
      "label": "Mostrar la liga junto al título",
      "default": true
    },
    {
      "type": "text",
      "id": "card_protocol",
      "label": "Liga en cada producto",
      "default": "+ Súmalo a tu protocolo"
    },
    {
      "type": "url",
      "id": "protocol_link",
      "label": "Liga del protocolo (si está vacía, baja a la sección en el Home)"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre corto (opcional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Necesidad",
          "default": "Estrés"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta sobre la foto",
          "default": "Más vendido"
        },
        {
          "type": "text",
          "id": "size",
          "label": "Presentación (si tiene una sola)",
          "info": "Ej. 60 cápsulas"
        },
        {
          "type": "text",
          "id": "per_serving",
          "label": "Costo por porción",
          "default": "Desde $4.95 por porción"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Commons · Productos",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
