<div class="pl-comb">{%- assign cp = all_products["hongo-reishi-100g-20-β-glucanos"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Sueño</span><b>{{ cp.title }}</b><span>Botanicals · hongo</span></div></a>{%- endif -%}{%- assign cp = all_products["azafran-1"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Ánimo</span><b>{{ cp.title }}</b><span>Commons Science · en la mañana</span></div></a>{%- endif -%}{%- assign cp = all_products["miel-enfoque-y-balance-de-estres"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Ritual</span><b>{{ cp.title }}</b><span>Rituals · miel</span></div></a>{%- endif -%}</div>
