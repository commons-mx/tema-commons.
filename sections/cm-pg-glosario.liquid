oading="lazy"></div></div><div class="nm"><b>Shatavari</b><span>Hierba · Sistema hormonal</span></div></button><button type="button" class="gl-card" data-i="17" data-fam="Hierba"><div class="gph"><div class="circ"><img src="{%- if section.settings.cm_img_15 != blank -%}{{ section.settings.cm_img_15 | image_url: width: 2000 }}{%- else -%}{{ 'cm-b-4d303cdac8.jpg' | asset_url }}{%- endif -%}" alt="Tulsi" loading="lazy"></div></div><div class="nm"><b>Tulsi</b><span>Hierba · Estrés</span></div></button><button type="button" class="gl-card" data-i="18" data-fam="Hierba"><div class="gph"><div class="circ"><img src="{{ 'cm-gl-vitex.jpg' | asset_url }}" alt="Vitex" loading="lazy" width="800" height="800"></div></div><div class="nm"><b>Vitex</b><span>Hierba · Sistema hormonal</span></div></button></div>
