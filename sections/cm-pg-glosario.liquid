<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var D = [{"href": "/pages/amla-ficha-tecnica", "n": "Amla", "lat": "Phyllanthus emblica", "fam": "Hierba", "need": "Defensas", "part": "Fruto", "act": "—", "fmt": "Polvo"}, {"href": "/pages/ashwagandha-ficha-tecnica", "n": "Ashwagandha", "lat": "Withania somnifera", "fam": "Hierba", "need": "Estrés", "part": "Raíz", "act": "5% withanólidos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/astragalo-ficha-tecnica", "n": "Astrágalo", "lat": "Astragalus membranaceus", "fam": "Hierba", "need": "Defensas", "part": "Raíz", "act": "10:1", "fmt": "Polvo"}, {"href": "/pages/bacopa-ficha-tecnica", "n": "Bacopa", "lat": "Bacopa monnieri", "fam": "Hierba", "need": "Enfoque", "part": "Planta entera", "act": "50% bacósidos", "fmt": "Cápsulas, con Ginkgo"}, {"href": "/pages/chaga-ficha-tecnica", "n": "Chaga", "lat": "Inonotus obliquus", "fam": "Hongo", "need": "Defensas", "part": "Cuerpo fructífero", "act": "20% betaglucanos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/cola-de-pavo-ficha-tecnica", "n": "Cola de Pavo", "lat": "Trametes versicolor", "fam": "Hongo", "need": "Defensas", "part": "Cuerpo fructífero", "act": "20% betaglucanos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/cordiceps-ficha-tecnica", "n": "Cordyceps", "lat": "Cordyceps militaris", "fam": "Hongo", "need": "Energía", "part": "Cuerpo fructífero", "act": "20% betaglucanos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/eleuthero-ficha-tecnica", "n": "Eleuthero", "lat": "Eleutherococcus senticosus", "fam": "Hierba", "need": "Energía", "part": "Raíz", "act": "0.8% eleuterósidos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/gingko-ficha-tecnica", "n": "Ginkgo", "lat": "Ginkgo biloba", "fam": "Hierba", "need": "Enfoque", "part": "Hoja", "act": "24%", "fmt": "Cápsulas, con Bacopa"}, {"href": "/pages/gotu-kola-ficha-tecnica", "n": "Gotu Kola", "lat": "Centella asiatica", "fam": "Hierba", "need": "Claridad", "part": "Hoja", "act": "—", "fmt": "Cápsulas y polvo"}, {"href": "/pages/maitake-ficha-tecnica", "n": "Maitake", "lat": "Grifola frondosa", "fam": "Hongo", "need": "Metabolismo", "part": "Cuerpo fructífero", "act": "20% betaglucanos", "fmt": "Cápsulas"}, {"href": "/pages/melena-de-leon-que-es", "n": "Melena de León", "lat": "Hericium erinaceus", "fam": "Hongo", "need": "Enfoque", "part": "Cuerpo fructífero", "act": "20% betaglucanos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/mucuna-ficha-tecnica", "n": "Mucuna", "lat": "Mucuna pruriens", "fam": "Hierba", "need": "Ánimo", "part": "Semilla", "act": "20% L-dopa", "fmt": "Cápsulas"}, {"href": "/pages/reishi-ficha-tecnica", "n": "Reishi", "lat": "Ganoderma lucidum", "fam": "Hongo", "need": "Estrés, sueño e inmunidad", "part": "Cuerpo fructífero", "act": "25% betaglucanos", "fmt": "Cápsulas y polvo"}, {"href": "/pages/rhodiola-ficha-tecnica", "n": "Rhodiola", "lat": "Rhodiola rosea", "fam": "Hierba", "need": "Energía", "part": "Raíz", "act": "3% rosavinas · 1% salidrosida", "fmt": "Cápsulas y polvo"}, {"href": "/pages/schisandra-ficha-tecnica", "n": "Schisandra", "lat": "Schisandra chinensis", "fam": "Hierba", "need": "Balance", "part": "Fruto", "act": "10:1", "fmt": "Cápsulas y polvo"}, {"href": "/pages/shatavari-ficha-tecnica", "n": "Shatavari", "lat": "Asparagus racemosus", "fam": "Hierba", "need": "Sistema hormonal", "part": "Raíz", "act": "4:1", "fmt": "Cápsulas y polvo"}, {"href": "/pages/tulsi", "n": "Tulsi", "lat": "Ocimum tenuiflorum", "fam": "Hierba", "need": "Estrés", "part": "Hoja", "act": "10:1", "fmt": "Cápsulas y polvo"}, {"href": "/pages/vitex-adaptogeno", "n": "Vitex", "lat": "Vitex agnus-castus", "fam": "Hierba", "need": "Sistema hormonal", "part": "Fruto", "act": "0.5%", "fmt": "Cápsulas"}];
var cur = D.findIndex(function(d){ return d.n === 'Reishi'; });
function sel(c){
  var i = +c.dataset.i, d = D[i]; cur = i;
  root.querySelectorAll('.gl-card').forEach(function(x){ x.classList.toggle('on', x === c); });
  root.querySelectorAll('[data-q]').forEach(function(e){ e.textContent = d[e.dataset.q]; });
  var fh = root.querySelector('[data-ficha]'); if (fh) { fh.hidden = !d.href; if (d.href) fh.href = d.href; }
  var qc = root.querySelector('[data-qc]'); if (qc) qc.innerHTML = c.querySelector('.circ').outerHTML;
}
root.querySelectorAll('.gl-card').forEach(function(c){ c.addEventListener('click', function(){ var d = D[+c.dataset.i]; if (d && d.href) { location.href = d.href; return; } sel(c); var q = root.querySelector('.gl-quick'); if (q && q.getBoundingClientRect().top < 0) q.scrollIntoView({ behavior: 'smooth' }); }); });
var qcw = root.querySelector('[data-qc]'); if (qcw) { qcw.style.cursor = 'pointer'; qcw.addEventListener('click', function(){ var d = D[cur]; if (d && d.href) location.href = d.href; }); }
root.querySelectorAll('[data-fam]').forEach(function(b){ if (b.classList.contains('gl-card')) return; b.addEventListener('click', function(){
  root.querySelectorAll('.gl-bar [data-fam]').forEach(function(x){ x.classList.toggle('on', x === b); });
  root.querySelectorAll('.gl-card').forEach(function(c){ c.hidden = !!b.dataset.fam && c.dataset.fam !== b.dataset.fam; });
}); });
(function(){ var want = new URLSearchParams(location.search).get('planta'); if (!want) return;
  var norm = function(t){ return t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, '-'); };
  var i = D.findIndex(function(d){ return norm(d.n) === norm(want); }); if (i < 0) return;
  var c = root.querySelector('.gl-card[data-i="' + i + '"]'); if (!c) return; sel(c);
  var q = root.querySelector('.gl-quick'); if (q) setTimeout(function(){ q.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
})();
})();
</script>
