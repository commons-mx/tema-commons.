{{ 'cm-pg-glosario.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmpg-{{ section.id }}">
<div class="v4 tA acY">


<!-- 1 · GLOSARIO -->
<section class="gl-hero" aria-labelledby="gh">
<div class="cell"><span class="lab">Glosario</span><h1 id="gh" class="disp h1" style="max-width: 11ch">Conoce cada planta.</h1></div>
<div class="cell"><p class="sub">De dónde viene, qué parte usamos, qué activo trae nuestro extracto y para qué se ha usado.</p><div class="gl-search">Busca una planta</div></div>
</section>
<div class="gl-bar" role="tablist" aria-label="Familia"><button type="button" class="on" data-fam="" role="tab">Todas · 19</button><button type="button" class="" data-fam="Hongo" role="tab">Hongos · 6</button><button type="button" class="" data-fam="Hierba" role="tab">Hierbas · 13</button><span class="small">De la A a la Z</span></div>

<!-- 2 · VISTA RÁPIDA -->
<section class="gl-quick" aria-live="polite" aria-label="Planta seleccionada">
<div class="gl-qc"><div class="qw" data-qc><div class="circ"><img src="{{ 'cm-gl-reishi-hongo.png' | asset_url }}" alt="Reishi" loading="lazy"></div></div></div>
<div class="gl-qt">
<div style="display: flex; flex-direction: column; gap: 6px"><span class="lab"><span data-q="fam">Hongo</span> · <span data-q="need">Estrés, sueño e inmunidad</span></span><h2 class="disp"><span data-q="n">Reishi</span></h2><span class="gl-lat"><span data-q="lat">Ganoderma lucidum</span></span></div>
<div class="gl-facts"><div><span class="lab">Parte que usamos</span><b><span data-q="part">Cuerpo fructífero</span></b></div><div><span class="lab">Nuestro extracto</span><b><span data-q="act">25% betaglucanos</span></b></div><div><span class="lab">Formatos</span><b><span data-q="fmt">Cápsulas y polvo</span></b></div><div><span class="lab">Se ha usado para</span><b><span data-q="need">Sueño</span></b></div></div>
<div class="gl-links"><a class="btn dark" href="/pages/reishi-ficha-tecnica" data-ficha>Ver la planta completa<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a><a class="tlink" href="/collections/tienda">Comprar <span data-q="n">Reishi</span></a></div>
</div>
</section>

<!-- 3 · TODAS LAS PLANTAS -->
