<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var FAM = [["Hongos", "hongos", 7], ["Hierbas", "hierbas", 12]], NOTES = ["Hongos: 100% cuerpo fructífero, sin micelio ni grano. Extracto estandarizado en betaglucanos.", "Hierbas y raíces: extracto estandarizado con el activo declarado en la etiqueta (5% withanólidos en Ashwagandha). Medio gramo por porción."];
var gt = root.querySelector('[data-gt]'), gb = root.querySelector('[data-gb]'), note = root.querySelector('[data-note]');
function pick(i){ root.querySelectorAll('.ffilt [data-fam]').forEach(function(x){ x.classList.toggle('on', +x.dataset.fam === i); });
  root.querySelectorAll('.fam3 [data-fam]').forEach(function(x){ x.classList.toggle('on', +x.dataset.fam === i); });
  root.querySelectorAll('[data-g]').forEach(function(c){ c.hidden = i < 0 ? !/\bs\b/.test(c.dataset.g) : c.dataset.g.indexOf('f' + i) !== 0; });
  gt.textContent = i < 0 ? 'Empieza por aquí.' : FAM[i][0] + '.'; gb.textContent = i < 0 ? 'Ver todas las plantas' : 'Ver los ' + FAM[i][2] + ' ' + FAM[i][1];
  note.hidden = i < 0; note.textContent = i < 0 ? '' : NOTES[i]; }
root.querySelectorAll('[data-fam]').forEach(function(x){ x.addEventListener('click', function(){ pick(+x.dataset.fam); }); });
})();
</script>
