<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var N = { tl: root.querySelectorAll('[data-g="tl"][data-r="p"]').length };
var cur = { orig: 0, tl: 0, herb: 0 };
function set(g, i){ cur[g] = i; root.querySelectorAll('[data-g="' + g + '"]').forEach(function(el){ el.classList.toggle('on', +el.dataset.i === i); });
  if (g === 'tl') { var p = root.querySelector('[data-tl="-1"]'), n = root.querySelector('[data-tl="1"]'), t = root.querySelector('[data-tln]');
    if (p) p.classList.toggle('off', i === 0); if (n) n.classList.toggle('off', i === N.tl - 1); if (t) t.textContent = (i + 1) + ' / ' + N.tl; } }
root.querySelectorAll('[data-r="b"]').forEach(function(x){ x.setAttribute('type', 'button'); x.addEventListener('click', function(){ set(x.dataset.g, +x.dataset.i); }); });
root.querySelectorAll('[data-tl]').forEach(function(x){ x.addEventListener('click', function(){ var j = cur.tl + (+x.dataset.tl); if (j >= 0 && j < N.tl) set('tl', j); }); });
})();
</script>
