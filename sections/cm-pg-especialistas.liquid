<section id="directorio" class="ed-dir" aria-labelledby="ed">
<div class="ed-hd"><span class="lab">Directorio</span><h2 id="ed" class="disp h2">Encuentra un especialista.</h2><p class="sub">Especialistas que conocen y recomiendan Commons.</p></div>
<div class="ed-filt"><label><span class="sr">Especialidad</span><select data-fa><option value="">Todas las especialidades</option><option>Nutrición</option><option>Psicología</option><option>Psiquiatría</option><option>Biología</option><option>Medicina</option><option>Terapias y bienestar</option></select></label><label><span class="sr">Estado</span><select data-fe><option value="">Todos los estados</option><option>CDMX</option><option>Estado de México</option><option>Guanajuato</option><option>Jalisco</option><option>Querétaro</option><option>Michoacán</option><option>Aguascalientes</option><option>Nuevo León</option></select></label><span class="ed-count" data-count>28 especialistas</span></div>
{%- comment -%} Directorio desde Contenido → Metaobjetos → Especialista. Contacto solo si permiso_contacto = true. {%- endcomment -%}
{%- assign esp_tones = '#CDBDF0,#EDE47A,#E9E6DF,#F4D9C6' | split: ',' -%}
{%- paginate shop.metaobjects.especialista.values by 250 -%}
{%- assign esp_list = shop.metaobjects.especialista.values -%}
{%- if esp_list.size > 0 -%}
<div class="ed-grid">
{%- for m in esp_list -%}
{%- assign nm = m.nombre.value | strip -%}{%- if nm == blank -%}{%- continue -%}{%- endif -%}
{%- assign ini = '' -%}{%- assign k = 0 -%}
{%- assign ws = nm | split: ' ' -%}
{%- for w in ws -%}{%- assign wl = w | downcase -%}{%- if wl == 'dr.' or wl == 'dra.' or wl == 'dr' or wl == 'dra' or wl == 'lic.' or wl == 'mtra.' -%}{%- continue -%}{%- endif -%}{%- if k < 2 -%}{%- assign wf = w | slice: 0 -%}{%- assign ini = ini | append: wf -%}{%- assign k = k | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- assign ti = forloop.index0 | modulo: 4 -%}{%- assign tone = esp_tones[ti] -%}
{%- assign ciudad = m.ciudad.value | strip -%}{%- assign estado = m.estado.value | strip -%}
<article class="ed-card" data-a="{{ m.area.value | escape }}" data-e="{{ estado | escape }}">
{%- if m.foto.value -%}<img class="ed-av ed-ph" src="{{ m.foto.value | image_url: width: 192 }}" width="64" height="64" loading="lazy" alt="{{ nm | escape }}">{%- else -%}<span class="ed-av" style="background:{{ tone }}" aria-hidden="true">{{ ini | upcase }}</span>{%- endif -%}
<div class="ed-tx"><h3>{{ nm | escape }}</h3><p class="ed-esp">{{ m.especialidad.value | escape }}</p><p class="ed-loc"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>{%- if ciudad != blank -%}{{ ciudad | escape }}, {% endif -%}{{ estado | escape }}</p>
{%- if m.en_linea.value -%}<p class="ed-ol">Consulta en línea</p>{%- endif -%}
{%- if m.permiso_contacto.value -%}
{%- assign ig = m.instagram.value | strip | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove: 'instagram.com/' | remove: '@' | split: '/' | first | split: '?' | first -%}
{%- assign wa = m.whatsapp.value | remove: ' ' | remove: '-' | remove: '+' | remove: '(' | remove: ')' | remove: '.' -%}
{%- if wa.size == 10 -%}{%- assign wa = '52' | append: wa -%}{%- endif -%}
{%- assign web = m.web.value -%}
{%- if ig != blank or wa != blank or web != blank -%}
<div class="ed-ct">
{%- if ig != blank -%}<a href="https://instagram.com/{{ ig | escape }}" target="_blank" rel="noopener" aria-label="Instagram de {{ nm | escape }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>@{{ ig | escape }}</a>{%- endif -%}
{%- if wa != blank -%}<a href="https://wa.me/{{ wa | escape }}?text={{ 'Hola, te encontré en el directorio de Commons.' | url_encode }}" target="_blank" rel="noopener" aria-label="WhatsApp de {{ nm | escape }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.4 7.9L3 21l1.2-4.4A9 9 0 1 1 21 12z"></path></svg>WhatsApp</a>{%- endif -%}
{%- if web != blank -%}<a href="{{ web }}" target="_blank" rel="noopener" aria-label="Sitio de {{ nm | escape }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"></path></svg>Sitio</a>{%- endif -%}
</div>
{%- endif -%}
{%- endif -%}
</div></article>
{%- endfor -%}
</div>
{%- else -%}
