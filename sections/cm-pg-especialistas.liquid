.ed-lock-x{position:absolute;top:10px;right:12px;width:40px;height:40px;border:0;background:none;font-size:26px;cursor:pointer;color:#141A16}
.ed-lock-ok{display:flex;gap:10px;align-items:center;font-size:15px;font-weight:500;cursor:pointer;padding:12px;border:1px solid #141A16;border-radius:12px;background:#fff}
