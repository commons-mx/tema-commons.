<script>
(function(){ var r=document.getElementById('directorio'); if(!r) return;
 var fa=r.querySelector('[data-fa]'), fe=r.querySelector('[data-fe]'), c=r.querySelector('[data-count]'), em=r.querySelector('[data-empty]'), cs=r.querySelectorAll('.ed-card');
 [fa,fe].forEach(function(s,i){ Array.prototype.slice.call(s.options,1).forEach(function(o){ var has=Array.prototype.some.call(cs,function(x){ return (i?x.dataset.e:x.dataset.a)===o.value; }); if(!has) o.remove(); }); });
 function go(){ var n=0; cs.forEach(function(x){ var ok=(!fa.value||x.dataset.a===fa.value)&&(!fe.value||x.dataset.e===fe.value); x.hidden=!ok; if(ok)n++; }); c.textContent=n+(n===1?' especialista':' especialistas'); em.hidden=n>0; }
