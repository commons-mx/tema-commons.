{%- if rp.id -%}<div class="pl-buy"><div class="pi"><img src="{%- if rp.featured_image -%}{{ rp.featured_image | image_url: width: 800 }}{%- endif -%}" loading="lazy" alt="{{ rp.title | escape }}"></div><div><b>Commons Reishi</b><span>25% betaglucanos · cápsulas y polvo · desde {{ rp.price_min | money_without_trailing_zeros }}</span></div><a class="pl-add" href="#s4" style="display:inline-flex;align-items:center;text-decoration:none">Comprar</a></div>{%- endif -%}
