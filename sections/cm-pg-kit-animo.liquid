<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
function cmAdd(items, btn){ var t = btn ? btn.textContent : '';
  if (btn){ btn.disabled = true; btn.textContent = 'Agregando…'; }
  return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
    .then(function(r){ return r.json(); }).then(function(d){
      if (btn){ btn.disabled = false; btn.textContent = d && d.status ? 'No disponible' : '✓ Agregado'; setTimeout(function(){ btn.textContent = t; }, 1800); }
      document.dispatchEvent(new CustomEvent('cart:refresh')); try { document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true })); } catch(e) {}
      return d; }); }
var main = root.querySelector('.kf-buy .sy-btn'); if (main){ main.addEventListener('click', function(e){ e.preventDefault(); cmAdd([{"id": 67173285855405, "quantity": 1}, {"id": 43310832713901, "quantity": 1}, {"id": 43310837301421, "quantity": 1}], main); }); }
root.querySelectorAll('[data-ids]').forEach(function(c){ var btn = c.querySelector('.sy-add'); if (!btn || !c.dataset.ids) return;
  btn.addEventListener('click', function(e){ e.preventDefault(); cmAdd(c.dataset.ids.split(',').map(function(id){ return { id: +id, quantity: 1 }; }), btn); }); });
})();
</script>
