<script>
(function(){

var Q = {}; try { Q = JSON.parse(document.getElementById('cmq-data').textContent); } catch (e) { console.warn('quiz: datos de productos', e); }
function firstVar(q){ var k = Object.keys(q.v || {}); return k.length ? q.v[k[0]][0] : null; }
function pickVar(q, usePw, n, pw){
  var v = q.v || {}, ks = Object.keys(v); if (!ks.length) return null;
  var want = usePw ? /polvo 1/i : /c[aá]psulas/i;
  if (n === 'Master blend') want = pw ? /polvo/i : /c[aá]psulas/i;
  for (var i = 0; i < ks.length; i++) if (want.test(ks[i])) return v[ks[i]][0];
  return v[ks[0]][0];
}
function addItems(items){
  if (!items.length) return;
  fetch('{{ routes.cart_add_url }}.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
    .then(function(r){ if (!r.ok) throw r; if (window.Alpine && Alpine.store('xMiniCart')) { Alpine.store('xMiniCart').reLoad && Alpine.store('xMiniCart').reLoad(); Alpine.store('xMiniCart').openCart(); } else { location.href = '{{ routes.cart_url }}'; } })
    .catch(function(){ location.href = '{{ routes.cart_url }}'; });
}
class DCLogic { constructor(props){ this.props = props || {}; } setState(o){ if (typeof o === 'function') o = o(this.state); Object.assign(this.state, o); paint(); } }


function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
var FN = [];
function on(f){ FN.push(f); return FN.length - 1; }
function opt(o){ return '<button type="button" class="' + o.cls + '" data-fn="' + on(o.pick) + '"><span>' + esc(o.t) + '</span>' + (o.s ? '<small>' + esc(o.s) + '</small>' : '') + '</button>'; }
function view(v){
  FN = []; var h = '';
  if (v.isQuiz) {
    h += '<section class="qwrap" aria-labelledby="qq"><div class="qside"><div style="display:flex;flex-direction:column;gap:16px"><span class="lab">Quiz · 3 minutos</span><h1 class="disp h2">Encuentra tu Commons.</h1><p style="margin:0;font-size:17px;max-width:32ch">Cuéntanos qué estás viviendo y te armamos tu protocolo, con cómo tomarlo.</p></div>';
    h += '<div class="qsteps">' + v.stepList.map(function(s){ return '<span class="' + s.cls + '"><b>' + s.n + '</b>' + esc(s.t) + '</span>'; }).join('') + '</div></div>';
    h += '<div class="qmain"><div class="qbar"><i style="width:' + v.pct + '%"></i></div><span class="lab">Paso ' + v.stepN + ' de 5 · ' + esc(v.stepName) + '</span><h2 id="qq" class="qq">' + esc(v.q) + '</h2>';
    if (v.hint) h += '<p class="qhint">' + esc(v.hint) + '</p>';
    h += v.groups.map(function(g){ return '<div class="qgrp">' + (g.lab ? '<span class="lab">' + esc(g.lab) + '</span>' : '') + '<div class="' + g.cls + '">' + g.opts.map(opt).join('') + '</div></div>'; }).join('');
    if (v.isSafety) h += '<p class="qpriv">Tus respuestas de salud no salen de tu navegador: no se envían ni se usan para anuncios. Tu resultado se guarda aquí 30 días para que lo retomes.</p>';
    if (v.err) h += '<p class="qpriv" style="color:#8a1c1c">' + esc(v.err) + '</p>';
    h += '<div class="qnav">' + (v.canBack ? '<button type="button" class="qback" data-fn="' + on(v.back) + '">← Regresar</button>' : '') + '<span></span><button type="button" class="btn dark" data-fn="' + on(v.next) + '" style="border:0;cursor:pointer">' + esc(v.nextTxt) + '<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span>' + '</button></div></div></section>';
  }
  if (v.isBlock) {
    h += '<section class="rblock"><span class="lab">Tu resultado</span><h1 class="disp h2">' + esc(v.blockT) + '</h1><p class="sub" style="max-width:46ch">' + esc(v.blockS) + '</p><div class="rshare"><a class="btn dark" href="https://wa.me/525564299433">Escríbenos por WhatsApp' + '<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span>' + '</a><button type="button" class="sq" data-fn="' + on(v.restart) + '">Volver a empezar</button></div></section>';
  }
  if (v.isRes) {
    h += '<section class="rhero"><div class="rleft"><span class="lab">Tu protocolo · ' + esc(v.needsTxt) + '</span><h1 class="disp h1" style="font-size:calc(64px * var(--dscale))">' + esc(v.pname) + '</h1><p class="sub" style="max-width:46ch">' + esc(v.pintro) + '</p><div class="rprods">';
    h += v.prods.map(function(p){ return '<div class="rp"><div class="th">' + (p.img ? '<img src="' + esc(p.img) + '" alt="' + esc(p.n) + '">' : '') + '</div><div><div class="nm"><a href="' + esc(p.url) + '" style="color:inherit">' + esc(p.n) + '</a><span class="' + p.tgc + '">' + p.line + '</span>' + (p.warn ? '<span class="warn">' + esc(p.warn) + '</span>' : '') + '</div><div class="why">' + esc(p.why) + '</div><div class="how">' + esc(p.how) + '</div></div><span class="num">' + p.p + '</span></div>'; }).join('');
    h += '</div><span class="small">Este producto no es un medicamento. Si tomas medicamentos, consulta a tu médico.</span></div>';
    h += '<div class="rbox"><span class="lab">Tu total</span><div class="rtot"><span class="num">' + v.total + '</span>' + (v.full ? '<s class="num">' + v.full + '</s>' : '') + '</div><div><div class="rline"><span>' + esc(v.discTxt) + '</span><span class="num">−' + v.save + '</span></div><div class="rline"><span>Por día</span><span class="num">' + v.perDay + '</span></div><div class="rline"><span>Envío</span><span>' + v.ship + '</span></div></div>';
    h += '<button type="button" class="btn dark full" data-fn="' + on(v.addAll) + '" style="border:0;cursor:pointer;width:100%">' + esc(v.addTxt) + '<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span>' + '</button>';
    h += '<a class="tlink" href="/#protocolo" style="align-self:center">Ajustarlo en Arma tu protocolo</a><button type="button" class="sq" data-fn="' + on(v.toggleEss) + '">' + esc(v.essTxt) + '</button>';
    if (v.kitNear) h += '<div class="rkit"><span class="lab">Kit cercano</span><b style="font-weight:500">' + esc(v.kitNear) + '</b><span class="small">' + esc(v.kitNearS) + '</span></div>';
    if (v.anyWarn) h += '<p class="qpriv" style="margin:0">Algunos productos llevan "consulta a tu médico". Revisa tu protocolo con tu médico antes de empezar.</p>';
    window.__cmq = { n: v.pname, needs: v.needsTxt, intro: v.pintro, total: v.total, full: v.full, perDay: v.perDay, disc: v.discTxt, prods: v.prods.map(function(p){ return p.n; }), det: v.prods.map(function(p){ return { n: p.n, line: String(p.line || '').replace(/<[^>]+>/g, ''), why: p.why, how: p.how, p: p.p, img: p.img, warn: p.warn }; }) };
    h += '<form class="rmail" data-mail novalidate><span class="lab">Tu protocolo, por correo</span><p class="small" style="margin:0">Te lo mandamos en PDF, con cuándo y cómo tomar cada uno.</p><div class="rmrow"><input type="email" name="email" class="in" placeholder="tu@correo.com" autocomplete="email" required aria-label="Tu correo"><button type="submit" class="btn dark" style="border:0;cursor:pointer">Mándamelo</button></div><label class="rmchk"><input type="checkbox" name="mkt" checked> Quiero recibir guías y novedades de Commons.</label><span class="small rmok" data-mailok hidden>Listo. Te llega en unos minutos; revisa también promociones.</span><span class="small rmerr" data-mailerr hidden>No se pudo enviar. Revisa tu correo o descárgalo en PDF.</span></form>';
