<div class="cmpg" id="cmq-{{ section.id }}"><div class="v4 tA acY"><div id="cmq-root"><noscript>Activa JavaScript para hacer el quiz.</noscript></div></div></div>
<style>#cmq-{{ section.id }} .qo{cursor:pointer}#cmq-{{ section.id }} .rrits .rp > div:nth-child(2){display:flex;flex-direction:column;gap:4px}#cmq-{{ section.id }} .radd{display:flex;flex-direction:column;align-items:flex-end;gap:8px}#cmq-{{ section.id }} .radd .sq{cursor:pointer}@media (max-width:760px){#cmq-{{ section.id }} .rrits .radd{grid-column:2;flex-direction:row;align-items:center;justify-content:space-between}}#cmq-{{ section.id }} .rp .th img{width:100%;height:100%;object-fit:cover}
#cmq-{{ section.id }} .rmail{display:flex;flex-direction:column;gap:10px;padding:18px;border:1px solid var(--rule,#D9D8D1);background:#fff}
#cmq-{{ section.id }} .rmrow{display:flex;gap:8px}#cmq-{{ section.id }} .rmrow .in{flex:1;min-width:0;height:48px;border:1px solid #141A16;padding:0 14px;font:inherit;font-size:16px;border-radius:0;background:#fff}
#cmq-{{ section.id }} .rmchk{display:flex;gap:8px;align-items:flex-start;font-size:13px;color:#4A524C}
#cmq-{{ section.id }} .rmok{color:#2F6B3A}#cmq-{{ section.id }} .rmerr{color:#A33}
