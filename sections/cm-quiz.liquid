<script>
(function(){
  var root = document.getElementById('cmq-{{ section.id }}'); if (!root) return;
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function cmqPrint(){
    var q = window.__cmq; if (!q) { window.print(); return; }
    var old = document.getElementById('cmq-print'); if (old) old.remove();
    var d = document.createElement('div'); d.id = 'cmq-print'; d.style.display = 'none';
    var rows = q.det.map(function(p){ return '<tr><td class="ci">' + (p.img ? '<img src="' + esc(p.img) + '" alt="">' : '') + '</td><td><b>' + esc(p.n) + '</b> <span class="cl">' + esc(p.line) + '</span><div class="cw">' + esc(p.why) + '</div><div class="ch">' + esc(p.how) + '</div>' + (p.warn ? '<div class="cx">' + esc(p.warn) + '</div>' : '') + '</td><td class="cp">' + esc(p.p) + '</td></tr>'; }).join('');
    d.innerHTML = '<style>#cmq-print{font-family:Figtree,Arial,sans-serif;color:#141A16;padding:8mm 6mm;font-size:11pt;line-height:1.4}#cmq-print .hd{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1.5px solid #141A16;padding-bottom:4mm;margin-bottom:6mm}#cmq-print .lg{font-family:Georgia,serif;font-size:22pt;font-weight:700}#cmq-print .lb{font-size:8pt;letter-spacing:.12em;text-transform:uppercase;color:#4A524C}#cmq-print h1{font-size:24pt;font-weight:500;margin:2mm 0}#cmq-print p{margin:0 0 4mm}#cmq-print table{width:100%;border-collapse:collapse;margin:4mm 0}#cmq-print td{border-top:1px solid #D9D8D1;padding:3mm 2mm;vertical-align:top}#cmq-print .ci{width:16mm}#cmq-print .ci img{width:14mm;height:14mm;object-fit:contain}#cmq-print .cl{font-size:8pt;letter-spacing:.1em;text-transform:uppercase;color:#6E757B}#cmq-print .cw{color:#4A524C;margin-top:1mm}#cmq-print .ch{font-family:monospace;font-size:8.5pt;margin-top:1.5mm;text-transform:uppercase}#cmq-print .cx{color:#8A2B2B;font-size:9pt;margin-top:1mm}#cmq-print .cp{text-align:right;white-space:nowrap}#cmq-print .tt{display:flex;justify-content:flex-end;gap:6mm;border-top:1.5px solid #141A16;padding-top:3mm;font-size:12pt}#cmq-print .wk{display:grid;grid-template-columns:repeat(4,1fr);gap:4mm;margin-top:6mm}#cmq-print .wk div{border-top:1px solid #141A16;padding-top:2mm;font-size:9.5pt}#cmq-print .ft{margin-top:8mm;font-size:8.5pt;color:#6E757B;border-top:1px solid #D9D8D1;padding-top:3mm}#cmq-print tr{page-break-inside:avoid}</style>'
      + '<div class="hd"><span class="lg">commons</span><span class="lb">Tu protocolo · ' + esc(q.needs) + '</span></div>'
      + '<h1>' + esc(q.n) + '</h1><p>' + esc(q.intro) + '</p>'
      + '<table>' + rows + '</table>'
      + '<div class="tt"><span>' + esc(q.disc) + '</span><b>Total ' + esc(q.total) + '</b>' + (q.perDay ? '<span>' + esc(q.perDay) + ' al día</span>' : '') + '</div>'
      + '<div class="lb" style="margin-top:8mm">Tus primeras 12 semanas</div><div class="wk"><div><b>Semana 1–2</b><br>Empieza con la dosis mínima para ver cómo te sienta.</div><div><b>Semana 3</b><br>Si te sientes bien, sube a tu dosis completa.</div><div><b>Semana 8–10</b><br>Evalúa cómo vas.</div><div><b>Semana 12</b><br>Descansa las que lo piden y retoma.</div></div>'
      + '<div class="ft">Este producto no es un medicamento. Si tomas medicamentos, consulta a tu médico. Es una guía, no un diagnóstico. · commons.mx · WhatsApp 55 6429 9433</div>';
    document.body.appendChild(d);
    setTimeout(function(){ window.print(); }, 150);
  }
  root.addEventListener('click', function(e){
    if (e.target.closest('[data-pdf]')) { e.preventDefault(); cmqPrint(); }
    var sh = e.target.closest('[data-wsh]');
    if (sh && window.__cmq) { var stx = 'Me salió este protocolo en Commons: ' + window.__cmq.n + ' (' + window.__cmq.prods.join(', ') + '). Haz el quiz aquí: ' + location.origin + '/pages/quiz';
      if (navigator.share) { e.preventDefault(); navigator.share({ text: stx }).catch(function(){}); } else { sh.href = 'https://wa.me/?text=' + encodeURIComponent(stx); } }
    var wa = e.target.closest('[data-wa]');
    if (wa && window.__cmq) { wa.href = 'https://wa.me/525564299433?text=' + encodeURIComponent('Hola, hice el quiz y me salió: ' + window.__cmq.n + ' (' + window.__cmq.prods.join(', ') + '). ¿Me ayudan?'); }
  });
  root.addEventListener('submit', function(e){
    var f = e.target.closest('[data-mail]'); if (!f) return;
    e.preventDefault();
    var em = f.querySelector('[name=email]'), ok = f.querySelector('[data-mailok]'), er = f.querySelector('[data-mailerr]');
    ok.hidden = true; er.hidden = true;
    if (!em.value || em.value.indexOf('@') < 1) { er.hidden = false; em.focus(); return; }
    var q = window.__cmq || { n: '', needs: '', prods: [] };
    var slug = function(s){ return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''); };
    var tags = ['quiz-protocolo', 'quiz-' + slug(q.n)].concat(q.prods.map(function(p){ return 'quiz-p-' + slug(p); })).join(', ');
    var fd = new FormData();
    fd.append('form_type', 'customer'); fd.append('utf8', '✓');
    fd.append('contact[email]', em.value); fd.append('contact[tags]', tags);
    if (f.querySelector('[name=mkt]').checked) fd.append('contact[accepts_marketing]', 'true');
    var b = f.querySelector('button[type=submit]'); b.disabled = true;
    fetch('/contact', { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function(r){ if (!r.ok && r.status !== 302) throw r; ok.hidden = false; em.value = ''; })
      .catch(function(){ er.hidden = false; })
      .finally(function(){ b.disabled = false; });
  });
})();
