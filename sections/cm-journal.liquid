<div class="cm4">
<section class="row2" aria-labelledby="jr-{{ section.id }}">
  <div class="cell" style="justify-content: space-between">
    <h2 id="jr-{{ section.id }}" class="disp h1">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}<a class="sq" href="{{ section.settings.button_link | default: section.settings.blog.url | default: '/blogs/news' }}" style="align-self: flex-start">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
  <div class="jlist">
    {%- assign blog = section.settings.blog -%}
    {%- if blog != blank and blog.articles.size > 0 -%}
      {%- for article in blog.articles limit: 3 -%}
      <a class="jart" href="{{ article.url }}">
        <div class="jimg">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '25vw' }}{%- endif -%}</div>
        <div class="jtxt">{%- if article.tags.first -%}<span class="tag">{{ article.tags.first }}</span>{%- endif -%}<h3 class="jt">{{ article.title }}</h3>{%- assign words = article.content | strip_html | split: ' ' | size -%}{%- assign mins = words | divided_by: 200 | at_least: 1 -%}<span class="jmin"><span class="n">{{ mins }}</span>minutos</span></div>
      </a>
      {%- endfor -%}
    {%- else -%}
      <p class="small" style="padding: 24px 32px">Elige un blog en el editor para mostrar los artículos.</p>
    {%- endif -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "Commons · Journal",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Más artículos en nuestro blog"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Liga del botón"
    }
  ],
  "presets": [
    {
      "name": "Commons · Journal"
    }
  ]
}
{% endschema %}
