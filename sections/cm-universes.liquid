<div class="cm4">
<section class="ulines2" aria-labelledby="uni-{{ section.id }}">
  <div class="hd-row"><div><h2 id="uni-{{ section.id }}" class="disp h2">{{ section.settings.heading }}</h2>{%- if section.settings.intro != blank -%}<p class="sub uintro">{{ section.settings.intro }}</p>{%- endif -%}</div></div>
  {%- for block in section.blocks -%}
  {%- liquid
    assign mk = block.settings.mark
    if mk == blank
      case block.settings.style
        when 'sci'
          assign mk = '#DFF68F'
        when 'rit'
          assign mk = '#E8C77A'
        else
          assign mk = '#CDBDF0'
      endcase
    endif
    assign col = block.settings.collection
    assign link = block.settings.button_link | default: col.url | default: '#'
  -%}
  <article class="uband u-{{ block.settings.style }}{% cycle '', ' flip' %}" {{ block.shopify_attributes }}>
    <a class="uph2" href="{{ link }}" tabindex="-1" aria-hidden="true">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 760px) 50vw, 100vw', alt: '' }}{%- elsif block.settings.asset != blank -%}<img src="{{ block.settings.asset | asset_url }}" alt="" loading="lazy" width="2000" height="1334">{%- else -%}<span class="uphn">[Foto 3:2 · {{ block.settings.label }}]</span>{%- endif -%}</a>
    <div class="utx2">
      <div class="umark2"><span class="udot" style="background: {{ mk }}"></span><span class="ulab">{{ block.settings.label }}</span>{%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge }}</span>{%- endif -%}<span class="unum">{{ forloop.index | prepend: '0' }} / {{ forloop.length | prepend: '0' }}</span></div>
      <h3 class="disp h2 utitle">{{ block.settings.title }}</h3>
      {%- if block.settings.text != blank -%}<p class="utext">{{ block.settings.text }}</p>{%- endif -%}
      {%- if block.settings.cats != blank -%}
      <div class="uprods">
        {%- assign cl = block.settings.cats | newline_to_br | split: '<br />' -%}
        {%- for c in cl -%}{%- assign cp = c | strip | split: '|' -%}{%- if cp.size > 1 -%}{%- assign ph = all_products[cp[2]] -%}
        <a class="uprod" href="{{ cp[1] }}"><span class="upim">{%- if ph.featured_image -%}{{ ph.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: cp[0] }}{%- endif -%}</span><span class="upn">{{ cp[0] }}</span><span class="upp">{{ cp[3] }}</span></a>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- elsif block.settings.products != blank -%}
      <div class="uprods">
        {%- for p in block.settings.products -%}
        <a class="uprod" href="{{ p.url }}"><span class="upim">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</span><span class="upn">{{ p.metafields.custom.short_name | default: p.title | truncatewords: 3, '' }}</span><span class="upp">{%- if p.price_varies -%}Desde {% endif -%}{{ p.price_min | money_without_trailing_zeros }}</span></a>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if block.settings.extra_label != blank -%}<a class="uextra" href="{{ block.settings.extra_link | default: '#' }}">{%- if block.settings.extra_tag != blank -%}<span class="lab">{{ block.settings.extra_tag }}</span>{%- endif -%}<b>{{ block.settings.extra_label }} →</b></a>{%- endif -%}
      <div class="ufoot2"><a class="sq{% if block.settings.style == 'sci' %} light{% endif %}" href="{{ link }}">{{ block.settings.button_label | default: 'Explorar' }}</a>{%- if col != blank and col.products_count > 0 -%}<span class="lab umeta">{{ col.products_count }} productos</span>{%- elsif block.settings.sig != blank -%}<span class="lab umeta">{{ block.settings.sig }}</span>{%- endif -%}</div>
    </div>
  </article>
  {%- endfor -%}
</section>
</div>
<style>.uph2{overflow:hidden}.uph2[href*="science"] img{transform:scale(1.55);transform-origin:50% 50%}</style>
<style>@media (max-width:760px){.uph2[href*="science"]{aspect-ratio:1/1;background:url({{ 'cm-home-science-sq.jpg' | asset_url }}) center/cover}.uph2[href*="science"] img{display:none}}</style>
{% schema %}
{
  "name": "Commons · Líneas",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "La ciencia no reemplaza el origen, lo acompaña."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción"
    }
  ],
  "blocks": [
    {
      "type": "universe",
      "name": "Línea",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nombre",
          "default": "Commons Botanicals"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Color de la marca",
          "options": [
            {
              "value": "bot",
              "label": "Botanicals (lila)"
            },
            {
              "value": "sci",
              "label": "Science (lima)"
            },
            {
              "value": "rit",
              "label": "Rituals (ámbar · por aprobar)"
            },
            {
              "value": "otra",
              "label": "Otra línea (elige color)"
            }
          ],
          "default": "bot"
        },
        {
          "type": "color",
          "id": "mark",
          "label": "Color del punto (vacío = el de la línea)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección de la línea (muestra cuántos productos)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Foto del tema (si no subes una)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "El origen con hierbas y adaptógenos"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "textarea",
          "id": "cats",
          "label": "Familias de la línea (en vez de productos)",
          "info": "Una por línea: Nombre|liga|handle del producto para la foto|dato"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Productos de la línea (hasta 3)",
          "limit": 3
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón",
          "default": "Explorar Botanicals"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Liga del botón"
        },
        {
          "type": "text",
          "id": "sig",
          "label": "Dato en mono (si no hay colección)"
        },
        {
          "type": "text",
          "id": "extra_tag",
          "label": "Tarjeta extra · rótulo"
        },
        {
          "type": "text",
          "id": "extra_label",
          "label": "Tarjeta extra · texto"
        },
        {
          "type": "url",
          "id": "extra_link",
          "label": "Tarjeta extra · liga"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Commons · Universos",
      "blocks": [
        {
          "type": "universe"
        },
        {
          "type": "universe"
        },
        {
          "type": "universe"
        }
      ]
    }
  ]
}
{% endschema %}
