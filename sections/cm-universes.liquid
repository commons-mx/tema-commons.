<div class="cm4">
<section class="ulines" aria-labelledby="uni-{{ section.id }}">
  <div class="hd-row"><div><h2 id="uni-{{ section.id }}" class="disp h2">{{ section.settings.heading }}</h2>{%- if section.settings.intro != blank -%}<p class="sub uintro">{{ section.settings.intro }}</p>{%- endif -%}</div><span class="lab ucount">{{ section.blocks.size }} líneas</span></div>
  <div class="ugrid ug{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
    {%- liquid
      assign mk = block.settings.mark
      if mk == blank
        case block.settings.style
          when 'sci'
            assign mk = '#DFF68F'
          when 'rit'
            assign mk = '#E8C77A'
          else
            assign mk = '#CDBDF0'
        endcase
      endif
      assign col = block.settings.collection
    -%}
    <a class="uline" href="{{ block.settings.button_link | default: col.url | default: '#' }}" {{ block.shopify_attributes }}>
      <div class="umark"><span class="udot" style="background: {{ mk }}"></span><span class="ulab">{{ block.settings.label }}</span>{%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge }}</span>{%- endif -%}<span class="unum">{{ forloop.index | prepend: '0' }} / {{ forloop.length | prepend: '0' }}</span></div>
      <div class="uph">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 760px) 33vw, 100vw', alt: block.settings.label }}{%- else -%}<span class="uphn">[Foto 3:2 · {{ block.settings.label }}]</span>{%- endif -%}</div>
      <div class="utx">
        <h3 class="disp h3t">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}<p class="small">{{ block.settings.text }}</p>{%- endif -%}
        <div class="ufoot">
          <span class="sq">{{ block.settings.button_label | default: 'Explorar' }}</span>
          {%- if col != blank and col.products_count > 0 -%}<span class="lab umeta">{{ col.products_count }} productos</span>{%- elsif block.settings.sig != blank -%}<span class="lab umeta">{{ block.settings.sig }}</span>{%- endif -%}
        </div>
      </div>
    </a>
    {%- endfor -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "Commons · Líneas",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "La ciencia no reemplaza el origen, lo acompaña."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción"
    }
  ],
  "blocks": [
    {
      "type": "universe",
      "name": "Línea",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nombre",
          "default": "Commons Botanicals"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Color de la marca",
          "options": [
            {
              "value": "bot",
              "label": "Botanicals (lila)"
            },
            {
              "value": "sci",
              "label": "Science (lima)"
            },
            {
              "value": "rit",
              "label": "Rituals (ámbar · por aprobar)"
            },
            {
              "value": "otra",
              "label": "Otra línea (elige color)"
            }
          ],
          "default": "bot"
        },
        {
          "type": "color",
          "id": "mark",
          "label": "Color del punto (vacío = el de la línea)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección de la línea (muestra cuántos productos)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "El origen con hierbas y adaptógenos"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón",
          "default": "Explorar Botanicals"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Liga del botón"
        },
        {
          "type": "text",
          "id": "sig",
          "label": "Dato en mono (si no hay colección)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Commons · Universos",
      "blocks": [
        {
          "type": "universe"
        },
        {
          "type": "universe"
        },
        {
          "type": "universe"
        }
      ]
    }
  ]
}
{% endschema %}
