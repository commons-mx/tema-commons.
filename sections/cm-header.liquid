          {%- if block.settings.label contains 'Botanicals' -%}<a class="mrow mrall" href="/collections/botanicals">Comprar todo Botanicals<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a><a class="mrow mrall" href="/collections/rituals">Comprar todo Rituals<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>{%- elsif block.settings.label contains 'Science' -%}<a class="mrow mrall" href="/collections/science">Comprar todo Science<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>{%- elsif block.settings.label contains 'Journal' -%}{%- else -%}<a class="mrow mrall" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Comprar todo<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>{%- endif -%}
        </div>
