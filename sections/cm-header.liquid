{%- liquid
  assign cart_url = routes.cart_url
  for b in section.blocks
    if b.settings.needs_menu != blank
      assign needs_menu = b.settings.needs_menu
      break
    endif
  endfor
-%}
<style>
  #x-header-container{display:none !important}
  #shopify-section-{{ section.id }}{position:sticky;top:0;z-index:60}
  [x-cloak]{display:none !important}
</style>
<div class="cm4 cm-hdr" x-data="{ open: null, mob: false, mp: null }" @keydown.escape.window="open = null; mob = false" @mouseleave="open = null">
  {%- if section.settings.ann_text != blank -%}
  <div class="ann">{%- if section.settings.ann_link != blank -%}<a href="{{ section.settings.ann_link }}" style="color: inherit; text-decoration: none">{{ section.settings.ann_text }}</a>{%- else -%}{{ section.settings.ann_text }}{%- endif -%}{%- if section.settings.ann_more != blank -%}<span class="hide-m"> · {{ section.settings.ann_more }}{%- if section.settings.ann_link_label != blank %} <a href="{{ section.settings.ann_link | default: '#' }}" style="color: #141A16">{{ section.settings.ann_link_label }}</a>{%- endif -%}</span>{%- endif -%}</div>
  {%- endif -%}
  <header class="hdr">
    <div class="wrap">
      <button class="ibtn menu" aria-label="Abrir menú" @click="mob = true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="20" y2="8"></line><line x1="4" y1="16" x2="20" y2="16"></line></svg></button>
      <nav class="nav" aria-label="Principal">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="{% if block.settings.style == 'sq' %}sq{% endif %}{% if block.settings.link != blank and request.path == block.settings.link %} on{% endif %}" {{ block.shopify_attributes }}
            {%- if block.type == 'panel' %} @mouseenter="open = '{{ block.id }}'" @focus="open = '{{ block.id }}'" :class="open == '{{ block.id }}' && 'on'" aria-haspopup="true" :aria-expanded="open == '{{ block.id }}'"{% else %} @mouseenter="open = null"{% endif %}>{{ block.settings.label }}{%- if block.settings.badge != blank -%}<span class="cm-new">{{ block.settings.badge }}</span>{%- endif -%}</a>
        {%- endfor -%}
      </nav>
      <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}, inicio"><svg viewBox="0 0 442.65 60.96" fill="currentColor" aria-hidden="true"><path d="M439.05,25.69c-2.39-2.4-6.25-4.47-11.58-6.2l-6.79-2.2c-6.32-2.06-9.43-4.29-9.43-8.29,0-1.86.72-3.02,2.17-4.23,1.07-.9,3.03-1.66,4.97-1.58,3.89.16,7.72,4,8.5,9.18.28,1.84.73,3.34,1.48,4.18,1.2,1.35,2.69,2.07,4.86,2.07,4.26,0,6.34-3.29,6.34-6.61,0-3.7-2.06-6.62-5.59-8.42,0,0-1.4-.67-2.45-1-.23-.07-.46-.14-.7-.2-2.32-.64-6.12-1.5-11.57-1.66-.04,0-.06.03-.09.03-.05,0-.11-.03-.16-.03-3.06,0-5.89.42-8.48,1.25-2.59.83-4.84,1.98-6.74,3.45-1.9,1.47-3.39,3.2-4.49,5.2-1.1,2-1.65,4.17-1.65,6.5,0,3.67,1.36,6.82,4.09,9.45,2.73,2.63,7.28,5.51,13.67,7.71l4.89,1.7c3.52,1.2,5.97,2.5,7.33,3.9,1.36,1.4,2,2.97,2,5.17,0,1.44-.79,2.67-2,3.51-1.27.88-3.21,1.61-5.41,1.61s-4.89-.46-6.36-1.43c-2.15-1.53-4.14-4.32-4.81-8.28-.27-1.61-1.16-3.38-1.96-4.27-1.27-1.43-3.08-2.15-5.36-2.15-4.5,0-6.93,3.73-6.93,7.24,0,3.91,2.18,7,5.91,8.9,0,0,1.48.71,2.59,1.05.24.08.49.15.74.21,2.59.72,6.94,1.69,13.24,1.78.04,0,.83,0,1.22,0,3.19,0,6.15-.45,8.88-1.35,2.73-.9,5.07-2.15,7.04-3.75,1.96-1.6,3.49-3.52,4.59-5.75,1.1-2.23,1.65-4.65,1.65-7.25,0-3.6-1.2-7.02-3.59-9.42Z"></path><path d="M88.16.72c-14.41,0-29,9-29,26.21s14.59,26.21,29,26.21,29-9,29-26.21S102.58.72,88.16.72ZM96.07,48.28c-1.29,1.31-3.15,1.94-5.68,1.94-6.47,0-7.79-7.68-10.39-21.89-1.38-7.63-2.01-12.03-1.99-16.1.02-4.96,3.42-8.58,7.94-8.58,6.46,0,7.79,7.68,10.39,21.88,1.27,6.98,1.69,11.86,1.75,16.26.04,2.91-.64,5.09-2.02,6.49Z"></path><path d="M302,.72c-14.41,0-29,9-29,26.21s14.59,26.21,29,26.21,29-9,29-26.21S316.41.72,302,.72ZM309.9,48.28c-1.29,1.31-3.15,1.94-5.68,1.94-6.47,0-7.79-7.68-10.39-21.89-1.38-7.63-2.01-12.03-1.99-16.1.02-4.96,3.42-8.58,7.94-8.58,6.46,0,7.79,7.68,10.39,21.88,1.27,6.98,1.69,11.86,1.75,16.26.04,2.91-.64,5.09-2.02,6.49Z"></path><path d="M265.29,32.12v-11.86c0-13.69-3.75-19.53-12.55-19.53-3.53,0-12.93,1.54-18.14,11.3v-.08c-.81-7.23-5.17-11.21-12.26-11.21-5.52,0-14.15,4.05-18.02,11.23-1.4-7.75-5.15-11.23-11.89-11.23-3.59,0-13,1.99-18.13,11.29,0,0,0-.04,0-.04-1.36-7.68-5.25-11.25-12.27-11.25-5.47,0-13.38,2.81-17.85,11.01V.78c0-.32-.36-.49-.61-.3-6.58,5.06-13.8,8.91-21.06,11.2-.3.1-.35.47-.1.66,2.93,2.25,2.93,5.26,2.93,16.08v3.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12V13.9c1.4-.81,3.8-1.23,4.79-1.23,6.47,0,6.78,6.05,6.78,16.75v2.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12v-11.86c0-1.34-.12-4.32-.2-6.31,1.71-1.1,4.68-1.27,4.99-1.27,6.47,0,6.78,6.05,6.78,16.75v2.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12v-11.86c0-1.84-.07-3.52-.21-5.08l-.15-1.29c.29-.12.86-.53,1.07-.6v.03s.05-.01.08-.02c1.26-.47,2.71-.62,3.51-.62,6.47,0,6.78,6.05,6.78,16.75v2.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12v-11.86c0-2.11-.1-4.09-.29-5.71v-.42c1.69-1.19,4.77-1.44,5.08-1.44,6.47,0,6.78,6.05,6.78,16.75v2.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12Z"></path><path d="M388.92,32.12v-11.86c0-13.69-3.76-19.53-12.56-19.53-4.32,0-12.76,1.5-17.84,11V.78c0-.32-.36-.49-.61-.3-6.58,5.06-13.8,8.91-21.06,11.2-.3.1-.35.47-.1.66,2.93,2.25,2.93,5.26,2.93,16.08v3.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12V13.92l.29-.16c1.39-.86,3.48-1.09,4.5-1.09,6.47,0,6.78,6.05,6.78,16.75v2.69c0,11.08,0,16.53-2.34,19.12-.21.24-.03.61.29.61h22.92c.32,0,.51-.38.29-.61-2.34-2.59-2.34-8.04-2.34-19.12Z"></path><path d="M54.63,43.63c-3.06,1.72-7.3,2.88-11.27,2.88-11.96,0-24.86-9.29-24.83-29.68.01-9.52,3.35-14.11,9.41-14.11,1.62,0,2.78.43,3.54,1.31,1.44,1.67.89,4.34.63,6.1-.89,6.1.39,11.17,3.08,14.2,1.93,2.17,4.66,3.27,8.12,3.27,6.82,0,10.5-5.65,10.5-10.97C53.8,6.52,44.33,0,29.67,0,13.31,0,0,13.83,0,30.83c0,18.31,11.96,30.14,30.48,30.14,7.75,0,18.47-1.79,25.4-16.17.38-.79-.49-1.59-1.26-1.16Z"></path></svg></a>
      <a class="sq mshop" href="#" @click.prevent="mob = true">{{ section.settings.mobile_button | default: 'Comprar' }}</a>
      <div class="icons"><a href="{{ routes.search_url }}">Buscar</a><a href="{{ routes.account_url }}">Cuenta</a><a href="{{ cart_url }}" @click.prevent="$store.xMiniCart ? $store.xMiniCart.openCart() : (window.location = '{{ cart_url }}')">Carrito <span class="cartn">{{ cart.item_count }}</span></a></div>
      <a class="ibtn mcart" href="{{ cart_url }}" aria-label="Carrito" style="justify-self: end;position:relative" @click.prevent="$store.xMiniCart ? $store.xMiniCart.openCart() : (window.location = '{{ cart_url }}')"><span class="cartn cartb"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path></svg></a>
    </div>
  </header>

  {%- comment -%} paneles de escritorio {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'panel' -%}
      {%- liquid
        assign n = 0
        if block.settings.needs_menu != blank
          assign n = n | plus: 1
        endif
        if block.settings.menu_1 != blank
          assign n = n | plus: 1
        endif
        if block.settings.menu_2 != blank
          assign n = n | plus: 1
        endif
        if block.settings.menu_3 != blank
          assign n = n | plus: 1
        endif
        if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.items != blank
          assign n = n | plus: 1
        endif
        if block.settings.card_title != blank
          assign n = n | plus: 1
        endif
      -%}
      <div class="mega cm-mega" x-cloak x-show="open == '{{ block.id }}'" x-transition.opacity style="grid-template-columns: {% if block.settings.needs_menu != blank %}minmax(0,1.45fr) repeat({{ n | minus: 1 | at_least: 1 }}, minmax(0,1fr)){% else %}repeat({{ n | at_least: 1 }}, minmax(0,1fr)){% endif %}">
        {%- if block.settings.label contains 'Botanicals' -%}<div class="mallbar"><a class="tlink" href="/collections/botanicals">Comprar todo Botanicals</a><a class="tlink" href="/collections/rituals">Comprar todo Rituals</a></div>{%- elsif block.settings.label contains 'Science' -%}<div class="mallbar"><a class="tlink" href="/collections/science">Comprar todo Science</a></div>{%- elsif block.settings.label contains 'Comprar' -%}<div class="mallbar"><a class="btn mall" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Comprar todo<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div>{%- endif -%}
        {%- if block.settings.needs_menu != blank -%}
        <div class="mcol"><span class="eyb">{{ block.settings.needs_title | default: 'Por necesidad' }}</span>
          <div class="ngrid">{%- for l in block.settings.needs_menu.links -%}<a href="{{ l.url }}">{%- render 'cm-need-icon', icon: l.title -%}{{ l.title }}</a>{%- endfor -%}</div>
          {%- if block.settings.needs_all_label != blank -%}<a class="tlink" href="{{ block.settings.needs_all_link | default: '#' }}">{{ block.settings.needs_all_label }}</a>{%- endif -%}
        </div>
        {%- endif -%}
        {%- if block.settings.menu_1 != blank -%}
<div class="mcol">
  {%- if block.settings.title_1 != blank -%}<span class="eyb">{{ block.settings.title_1 }}</span>{%- endif -%}
  {%- assign loose = false -%}
  {%- for l in block.settings.menu_1.links -%}
    {%- if l.links.size > 0 -%}
      <div class="grp"><a class="gh" href="{{ l.url }}">{{ l.title }}</a>
        <div class="mlist tight{% if l.links.size > 8 %} two{% endif %}">{%- for c in l.links -%}<a href="{{ c.url }}"><span>{{ c.title }}</span></a>{%- endfor -%}</div>
      </div>
    {%- else -%}
      {%- assign loose = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if loose -%}<div class="mlist">{%- for l in block.settings.menu_1.links -%}{%- if l.links.size == 0 -%}<a href="{{ l.url }}"><span>{{ l.title }}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
  
</div>
{%- endif -%}{%- if block.settings.menu_2 != blank -%}
<div class="mcol">
  {%- if block.settings.title_2 != blank -%}<span class="eyb">{{ block.settings.title_2 }}</span>{%- endif -%}
  {%- assign loose = false -%}
  {%- for l in block.settings.menu_2.links -%}
    {%- if l.links.size > 0 -%}
      <div class="grp"><a class="gh" href="{{ l.url }}">{{ l.title }}</a>
        <div class="mlist tight{% if l.links.size > 8 %} two{% endif %}">{%- for c in l.links -%}<a href="{{ c.url }}"><span>{{ c.title }}</span></a>{%- endfor -%}</div>
      </div>
    {%- else -%}
      {%- assign loose = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if loose -%}<div class="mlist">{%- for l in block.settings.menu_2.links -%}{%- if l.links.size == 0 -%}<a href="{{ l.url }}"><span>{{ l.title }}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
  
</div>
{%- endif -%}{%- if block.settings.menu_3 != blank -%}
<div class="mcol">
  {%- if block.settings.title_3 != blank -%}<span class="eyb">{{ block.settings.title_3 }}</span>{%- endif -%}
  {%- assign loose = false -%}
  {%- for l in block.settings.menu_3.links -%}
    {%- if l.links.size > 0 -%}
      <div class="grp"><a class="gh" href="{{ l.url }}">{{ l.title }}</a>
        <div class="mlist tight{% if l.links.size > 8 %} two{% endif %}">{%- for c in l.links -%}<a href="{{ c.url }}"><span>{{ c.title }}</span></a>{%- endfor -%}</div>
      </div>
    {%- else -%}
      {%- assign loose = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if loose -%}<div class="mlist">{%- for l in block.settings.menu_3.links -%}{%- if l.links.size == 0 -%}<a href="{{ l.url }}"><span>{{ l.title }}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
  {%- if true and block.settings.promo_big != blank -%}<div class="promo">{%- if block.settings.promo_label != blank -%}<span class="lab">{{ block.settings.promo_label }}</span>{%- endif -%}<span class="big">{{ block.settings.promo_big }}</span>{%- if block.settings.promo_text != blank -%}<span class="small" style="color: #2C342F">{{ block.settings.promo_text }}</span>{%- endif -%}</div>{%- endif -%}
</div>
{%- endif -%}
        {%- if block.settings.items != blank -%}
        <div class="mcol"><span class="eyb">{{ block.settings.products_title | default: 'Fórmulas' }}</span>
          <div class="cm-pgrid">
          {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}{%- for line in lines -%}{%- assign line = line | strip -%}{%- if line == blank -%}{%- continue -%}{%- endif -%}{%- assign f = line | split: '|' -%}{%- assign img = f[5] | strip -%}{%- unless img contains '/' -%}{%- assign img = img | asset_url -%}{%- endunless -%}
            <a class="pcard" href="{{ f[4] | strip }}"><div class="pimg"><img src="{{ img }}" alt="{{ f[1] | strip }}" loading="lazy" width="600" height="600"></div><div class="ptx"><span class="lab">{{ f[0] | strip }}</span><span class="pn">{{ f[1] | strip }}</span><span class="small">{{ f[2] | strip }}</span><span class="small num">{{ f[3] | strip }}</span></div></a>
          {%- endfor -%}
          </div>
          {%- if block.settings.soon != blank -%}<span class="eyb" style="margin-top: 8px">Próximamente</span><div class="cm-soon">{{ block.settings.soon }}</div>{%- endif -%}
        </div>
        {%- elsif block.settings.product_1 != blank or block.settings.product_2 != blank -%}
        <div class="mcol"><span class="eyb">{{ block.settings.products_title | default: 'Fórmulas' }}</span>
          <div class="cm-pgrid">
          {%- for p in (1..2) -%}
            {%- if p == 1 -%}{%- assign pr = block.settings.product_1 -%}{%- else -%}{%- assign pr = block.settings.product_2 -%}{%- endif -%}
            {%- if pr != blank -%}
            <a class="pcard" href="{{ pr.url }}"><div class="pimg">{%- if pr.featured_media -%}{{ pr.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', alt: pr.title }}{%- endif -%}</div><div class="ptx"><span class="pn">{{ pr.title }}</span><span class="small num">{{ pr.price | money_without_trailing_zeros }}</span></div></a>
            {%- endif -%}
          {%- endfor -%}
          </div>
          {%- if block.settings.soon != blank -%}<span class="eyb" style="margin-top: 8px">Próximamente</span><div class="cm-soon">{{ block.settings.soon }}</div>{%- endif -%}
        </div>
        {%- endif -%}
        {%- if block.settings.card_title != blank -%}
          {%- if block.settings.card_style == 'quiz' -%}
          <div class="qcard"><div class="qimg">{%- if block.settings.card_image != blank -%}{{ block.settings.card_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.card_title }}{%- else -%}<img src="{{ 'cm-quiz.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}</div>
            <div class="qtx">{%- if block.settings.card_eyebrow != blank -%}<span class="lab">{{ block.settings.card_eyebrow }}</span>{%- endif -%}<span class="disp h3t">{{ block.settings.card_title }}</span>{%- if block.settings.card_text != blank -%}<span class="small" style="color: #2C342F">{{ block.settings.card_text }}</span>{%- endif -%}<a class="btn dark" href="{{ block.settings.card_link | default: '#' }}">{{ block.settings.card_button | default: 'Ver' }}<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div></div>
          {%- else -%}
          <a class="icard" href="{{ block.settings.card_link | default: '#' }}">{%- if block.settings.card_image != blank -%}{{ block.settings.card_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.card_title }}{%- elsif block.settings.card_eyebrow contains 'Science' -%}<img src="{{ 'cm-b-e4e505fc32.png' | asset_url }}" alt="" loading="lazy" style="background:#fff;object-fit:contain">{%- elsif block.settings.card_eyebrow contains 'Journal' -%}<img src="{{ 'cm-f-estudios-57.jpg' | asset_url }}" alt="" loading="lazy">{%- else -%}<img src="{{ 'cm-f-img-7319.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}{%- if block.settings.card_eyebrow != blank -%}<span class="lab">{{ block.settings.card_eyebrow }}</span>{%- endif -%}<span class="disp h3t">{{ block.settings.card_title }}</span><span class="sq light" style="align-self: flex-start">{{ block.settings.card_button | default: 'Ver' }}</span></a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
  <div class="cm-dim" x-cloak x-show="open" @mouseenter="open = null" @click="open = null"></div>

  {%- comment -%} menú de celular {%- endcomment -%}
  <div class="cm-mob" x-cloak x-show="mob" x-transition.opacity role="dialog" aria-label="Menú">
