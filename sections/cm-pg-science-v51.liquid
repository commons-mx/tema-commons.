<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
root.querySelectorAll('[data-lab]').forEach(function(x){ x.addEventListener('click', function(){ var i = x.dataset.lab;
  root.querySelectorAll('[data-lab]').forEach(function(y){ y.classList.toggle('on', y === x); });
  root.querySelectorAll('[data-labp]').forEach(function(p){ p.hidden = p.dataset.labp !== i; }); }); });
root.querySelectorAll('[data-add]').forEach(function(b){ b.addEventListener('click', function(){ b.disabled = true;
  fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: +b.dataset.add, quantity: 1 }] }) })
  .then(function(r){ if (!r.ok) throw r; b.disabled = false; b.classList.add('on'); if (window.Alpine && Alpine.store('xMiniCart')) { Alpine.store('xMiniCart').reLoad && Alpine.store('xMiniCart').reLoad(); Alpine.store('xMiniCart').openCart(); } else { location.href = '/cart'; } })
  .catch(function(){ location.href = '/cart'; }); }); });
})();
</script>
