<style>
#cmpg-{{ section.id }} .patents{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:32px 48px;align-items:center;padding:56px 40px;border-bottom:1px solid var(--rule)}
#cmpg-{{ section.id }} .pthd{display:flex;flex-direction:column;gap:12px}
#cmpg-{{ section.id }} .ptrow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-left:1px solid var(--rule)}
#cmpg-{{ section.id }} .pti{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:8px 24px;border-right:1px solid var(--rule)}
#cmpg-{{ section.id }} .plogo{filter:grayscale(1) brightness(.25);max-width:100%}
#cmpg-{{ section.id }} .pword{font-size:26px;letter-spacing:-.01em;font-weight:500;line-height:28px}
#cmpg-{{ section.id }} .ptlegal{grid-column:1/-1;font-size:11px}
#cmpg-{{ section.id }} .soonlogos{display:flex;gap:14px;align-items:center;margin-top:8px}
#cmpg-{{ section.id }} .soonlogos img{filter:grayscale(1) brightness(.25)}
@media (max-width:760px){#cmpg-{{ section.id }} .patents{grid-template-columns:1fr;padding:40px 16px}#cmpg-{{ section.id }} .ptrow{grid-template-columns:1fr;border-left:0}#cmpg-{{ section.id }} .pti{flex-direction:row;justify-content:space-between;align-items:center;border-right:0;border-top:1px solid var(--rule);padding:16px 0}#cmpg-{{ section.id }} .pword{font-size:22px}}
</style>
