<div class="cm4">
{%- if section.settings.heading != blank -%}<div class="needs-hd"><h2 class="disp h3t">{{ section.settings.heading }}</h2></div>{%- endif -%}
<nav class="box needs" aria-label="Necesidades">
  {%- for block in section.blocks -%}
  <a class="need" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{%- render 'cm-need-icon', icon: block.settings.icon -%}{{ block.settings.label | default: block.settings.icon }}</a>
  {%- endfor -%}
</nav>
</div>
{% schema %}
{
  "name": "Commons · Necesidades",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Qué necesitas hoy?"
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Necesidad",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            {
              "value": "Sueño",
              "label": "Sueño"
            },
            {
              "value": "Estrés",
              "label": "Estrés"
            },
            {
              "value": "Ánimo",
              "label": "Ánimo"
            },
            {
              "value": "Enfoque",
              "label": "Enfoque"
            },
            {
              "value": "Energía",
              "label": "Energía"
            },
            {
              "value": "Ciclo",
              "label": "Ciclo"
            },
            {
              "value": "Defensas",
              "label": "Defensas"
            },
            {
              "value": "Metabolismo",
              "label": "Metabolismo"
            }
          ],
          "default": "Sueño"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto (si es distinto al ícono)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Liga (colección)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Commons · Necesidades",
      "blocks": [
        {
          "type": "need",
          "settings": {
            "icon": "Sueño"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Estrés"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Ánimo"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Enfoque"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Energía"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Ciclo"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Defensas"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Metabolismo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
