<div class="cm4">
{%- if section.settings.heading != blank -%}<div class="needs-hd"><h2 class="disp h3t">{{ section.settings.heading }}</h2>{%- if section.settings.quiz_label != blank -%}<a class="tlink" href="{{ section.settings.quiz_link | default: '#cm-quiz' }}">{{ section.settings.quiz_label }}</a>{%- endif -%}</div>{%- endif -%}
<div class="needwrap"><nav class="box needs" aria-label="Necesidades">
  {%- for block in section.blocks -%}
  <a class="need" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{%- render 'cm-need-icon', icon: block.settings.icon -%}{{ block.settings.label | default: block.settings.icon }}</a>
  {%- endfor -%}
</nav><span class="nswipe" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
<script>(function(){var w=document.currentScript.previousElementSibling;if(!w)return;var n=w.querySelector(".needs");if(n)n.addEventListener("scroll",function(){if(n.scrollLeft>20)w.classList.add("seen");},{passive:true});})();</script>
</div>
{% schema %}
{
  "name": "Commons · Necesidades",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Qué necesitas hoy?"
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Liga al quiz",
      "default": "¿No sabes cuál? Haz el quiz"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Liga al quiz (si está vacía, baja a la sección del quiz)"
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Necesidad",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            {
              "value": "Sueño",
              "label": "Sueño"
            },
            {
              "value": "Estrés",
              "label": "Estrés"
            },
            {
              "value": "Ánimo",
              "label": "Ánimo"
            },
            {
              "value": "Enfoque",
              "label": "Enfoque"
            },
            {
              "value": "Energía",
              "label": "Energía"
            },
            {
              "value": "Ciclo",
              "label": "Sistema hormonal"
            },
            {
              "value": "Digestión",
              "label": "Digestión"
            },
            {
              "value": "Longevidad",
              "label": "Longevidad"
            },
            {
              "value": "Defensas",
              "label": "Defensas"
            },
            {
              "value": "Metabolismo",
              "label": "Metabolismo"
            }
          ],
          "default": "Sueño"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto (si es distinto al ícono)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Liga (colección)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Commons · Necesidades",
      "blocks": [
        {
          "type": "need",
          "settings": {
            "icon": "Sueño"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Estrés"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Ánimo"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Enfoque"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Energía"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Ciclo"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Defensas"
          }
        },
        {
          "type": "need",
          "settings": {
            "icon": "Metabolismo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
