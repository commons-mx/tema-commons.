<div class="cm4">
<section class="row2" aria-labelledby="dif-{{ section.id }}">
  <div class="cell lila" style="justify-content: space-between{% if section.settings.color != blank %}; background: {{ section.settings.color }}{% endif %}">
    <div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start">{%- if section.settings.tag != blank -%}<span class="tag">{{ section.settings.tag }}</span>{%- endif -%}<h2 id="dif-{{ section.id }}" class="disp h2" style="max-width: 12ch">{{ section.settings.heading }}</h2></div>
    {%- if section.settings.text != blank -%}<p class="sub" style="color: #2C342F">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="stds">
    {%- for block in section.blocks -%}
    <div class="std" {{ block.shopify_attributes }}><div><h3 class="disp h3t">{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div><span class="ring{% if block.settings.icon == '3' %} sci{% endif %}">{%- render 'cm-std-icon', icon: block.settings.icon -%}</span></div>
    {%- endfor -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "Commons · Diferentes",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Etiqueta",
      "default": "Nuestros estándares"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Por qué somos diferentes."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "No da igual cuál compras. Dos frascos pueden decir “Reishi” y ser cosas muy distintas."
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color del bloque",
      "default": "#CDBDF0"
    }
  ],
  "blocks": [
    {
      "type": "std",
      "name": "Estándar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            {
              "value": "0",
              "label": "Extracto"
            },
            {
              "value": "1",
              "label": "Hongo"
            },
            {
              "value": "2",
              "label": "Medio gramo"
            },
            {
              "value": "3",
              "label": "Science (punteado)"
            }
          ],
          "default": "0"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Extracto estandarizado"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Commons · Diferentes",
      "blocks": [
        {
          "type": "std",
          "settings": {
            "icon": "0",
            "title": "Extracto estandarizado",
            "text": "Planta concentrada, con el activo declarado en la etiqueta: 25% betaglucanos en Reishi, 5% withanólidos en Ashwagandha."
          }
        },
        {
          "type": "std",
          "settings": {
            "icon": "1",
            "title": "100% cuerpo fructífero",
            "text": "En hongos, solo el hongo. Sin micelio, sin grano y sin rellenos."
          }
        },
        {
          "type": "std",
          "settings": {
            "icon": "2",
            "title": "Medio gramo por porción",
            "text": "Más concentrado, menos cantidad. Una cápsula al día, no cucharadas de polvo."
          }
        },
        {
          "type": "std",
          "settings": {
            "icon": "3",
            "title": "Ingredientes de patente",
            "text": "En Commons Science: ingredientes con estudios clínicos, en la dosis que se estudió."
          }
        }
      ]
    }
  ]
}
{% endschema %}
