<div class="cm4">
<footer class="ftr">
<div class="wrap">
  <div class="fgrid">
    <div class="fintro">
      {%- if section.settings.tagline != blank -%}<p style="margin: 0; font-size: 22px">{{ section.settings.tagline }}</p>{%- endif -%}
      <div class="nbox">
        <span class="nbt">{{ section.settings.newsletter_title }}</span>
        {%- form 'customer', class: 'nform', id: 'cm-news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="cm-news-{{ section.id }}" style="position: absolute; left: -9999px">Tu correo</label>
          <input id="cm-news-{{ section.id }}" type="email" name="contact[email]" placeholder="Tu correo" required autocomplete="email">
          <button type="submit">{{ section.settings.newsletter_button }}</button>
          {%- if form.posted_successfully? -%}<span class="small" style="flex-basis: 100%">Gracias, ya estás en la lista.</span>{%- endif -%}
        {%- endform -%}
      </div>
      <div class="fsoc"><span class="lab" style="color: #4A524C">Síguenos</span><div>
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg></a>{%- endif -%}
        {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M14 3c.5 2.5 2.5 4.5 5 5"></path></svg></a>{%- endif -%}
        {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M13 21v-8h3M13 13v-2.5A2.5 2.5 0 0 1 15.5 8H17M10 13h3"></path></svg></a>{%- endif -%}
      </div></div>
    </div>
    <div class="fcols">
      {%- for i in (1..4) -%}
        {%- capture key -%}menu_{{ i }}{%- endcapture -%}
        {%- assign menu = section.settings[key] -%}
        {%- if menu != blank -%}<div><span class="lab" style="color: #4A524C">{{ menu.title }}</span>{%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
    <div class="facc">
      {%- for i in (1..4) -%}
        {%- capture key -%}menu_{{ i }}{%- endcapture -%}
        {%- assign menu = section.settings[key] -%}
        {%- if menu != blank -%}<details><summary>{{ menu.title }}<svg class="fchev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary><div class="flinks">{%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div></details>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="flogo"><svg viewBox="0 0 442.65 60.96" fill="currentColor" aria-hidden="true"><path d="M439.05,25.69c-2.39-2.4-6.25-4.47-11.58-6.2l-6.79-2.2c-6.32-2.06-9.43-4.29-9.43-8.29,0-1.86.72-3.02,2.17-4.23,1.07-.9,3.03-1.66,4.97-1.58,3.89.16,7.72,4,8.5,9.18.28,1.84.73,3.34,1.48,4.18,1.2,1.35,2.69,2.07,4.86,2.07,4.26,0,6.34-3.29,6.34-6.61,0-3.7-2.06-6.62-5.59-8.42,0,0-1.4-.67-2.45-1-.23-.07-.46-.14-.7-.2-2.32-.64-6.12-1.5-11.57-1.66-.04,0-.06.03-.09.03-.05,0-.11-.03-.16-.03-3.06,0-5.89.42-8.48,1.25-2.59.83-4.84,1.98-6.74,3.45-1.9,1.47-3.39,3.2-4.49,5.2-1.1,2-1.65,4.17-1.65,6.5,0,3.67,1.36,6.82,4.09,9.45,2.73,2.63,7.28,5.51,13.67,7.71l4.89,1.7c3.52,1.2,5.97,2.5,7.33,3.9,1.36,1.4,2,2.97,2,5.17,0,1.44-.79,2.67-2,3.51-1.27.88-3.21,1.61-5.41,1.61s-4.89-.46-6.36-1.43c-2.15-1.53-4.14-4.32-4.81-8.28-.27-1.61-1.16-3.38-1.96-4.27-1.27-1.43-3.08-2.15-5.36-2.15-4.5,0-6.93,3.73-6.93,7.24,0,3.91,2.18,7,5.91,8.9,0,0,1.48.71,2.59,1.05.24.08.49.15.74.21,2.59.72,6.94,1.69,13.24,1.78.04,0,.83,0,1.22,0,3.19,0,6.15-.45,8.88-1.35,2.73-.9,5.07-2.15,7.04-3.75,1.96-1.6,3.49-3.52,4.59-5.75,1.1-2.23,1.65-4.65,1.65-7.25,0-3.6-1.2-7.02-3.59-9.42Z"></path><path d="M88.16.72c-14.41,0-29,9-29,26.21s14.59,26.21,29,26.21,29-9,29-26.21S102.58.72,88.16.72ZM96.07,48.28c-1.29,1.31-3.15,1.94-5.68,1.94-6.47,0-7.79-7.68-10.39-21.89-1.38-7.63-2.01-12.03-1.99-16.1.02-4.96,3.42-8.58,7.94-8.58,6.46,0,7.79,7.68,10.39,21.88,1.27,6.98,1.69,11.86,1.75,16.26.04,2.91-.64,5.09-2.02,6.49Z"></path><path d="M302,.72c-14.41,0-29,9-29,26.21s14.59,26.21,29,26.21,29-9,29-26.21S316.41.72,302,.72ZM309.9,48.28c-1.29,1.31-3.15,1.94-5.68,1.94-6.47,0-7.79-7.68-10.39-21.89-1.38-7.63-2.01-12.03-1.99-16.1.02-4.96,3.42-8.58,7.94-8.58,6.46,0,7.79,7.68,10.39,21.88,1.27,6.98,1.69,11.86,1.75,16.26.04,2.91-.64,5.09-2.02,6.49Z"></path><path d="M265.29,32.12v-11.86c0-13.69-3.75-19.53-12.55-19.53-3.53,0-12.93,1.54-18.14,11.3v-.08c-.81-7.23-5.17-11.21-12.26-11.21-5.52,0-14.15,4.05-18.02,11.23-1.4-7.75-5.15-11.23-11.89-11.23-3.59,0-13,1.99