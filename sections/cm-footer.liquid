.59-1.26-1.16Z"></path></svg></div>
  <div class="fbot"><span>{%- assign cm_year = 'now' | date: '%Y' -%}{{ section.settings.bottom | replace: '[year]', cm_year }}</span><span>{%- for link in section.settings.legal.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}</span></div>
</div>
</footer>
</div>
{% schema %}
{
  "name": "Commons · Footer",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Frase",
      "default": "In common with nature."
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título del newsletter",
      "default": "Únete a la comunidad Commons."
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Botón del newsletter",
      "default": "Suscribirme →"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menú 1 (Comprar)"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menú 2 (Aprende)"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menú 3 (Commons)"
    },
    {
      "type": "link_list",
      "id": "menu_4",
      "label": "Menú 4 (Ayuda)"
    },
    {
      "type": "text",
      "id": "bottom",
      "label": "Texto de abajo",
      "default": "-Designed for human systems- · © [year] Commons · [Leyenda COFEPRIS]",
      "info": "[year] se cambia solo por el año actual"
    },
    {
      "type": "link_list",
      "id": "legal",
      "label": "Menú legal (aviso de privacidad, términos)"
    }
  ],
  "presets": [
    {
      "name": "Commons · Footer"
    }
  ]
}
{% endschema %}
