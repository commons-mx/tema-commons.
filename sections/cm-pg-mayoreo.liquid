{{ 'cm-pg-mayoreo.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmpg-{{ section.id }}">
<div class="v4 tA acY">


<!-- 1 · MAYOREO -->
<section class="my-hero" aria-labelledby="mh">
<div class="cell">
<span class="lab">Mayoreo · para negocios</span>
<h1 id="mh" class="disp h1" style="max-width: 10ch">Lleva Commons a tu negocio.</h1>
<p class="sub">Para tiendas, cafés, restaurantes, spas, gimnasios y estudios que quieren ofrecer adaptógenos con dosis declaradas. Un solo precio de mayoreo para todos.</p>
<div class="my-btns"><a class="btn dark" href="#catalogo">Recibir el catálogo<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a><a class="tlink" href="#como">Cómo funciona</a></div>
</div>
<div class="cellimg"><img src="{%- if section.settings.cm_img_1 != blank -%}{{ section.settings.cm_img_1 | image_url: width: 2000 }}{%- else -%}{{ 'cm-b-ff4d9c74ec.jpg' | asset_url }}{%- endif -%}" loading="lazy" alt="Frascos Commons Botanicals sobre fondo naranja"><span class="photocap"></span></div>
</section>
<div class="my-stats">
<div><span class="n num">2018</span><span class="small">desde</span></div>
<div><span class="n num">+80</span><span class="small">tiendas orgánicas y de wellness</span></div>
<div><span class="n num">+200</span><span class="small">especialistas nos recomiendan</span></div>
<div><span class="n">5 cadenas</span><span class="small">Liverpool, HEB, Sanborns, Fresko La Comer y Farmacias San Pablo</span></div>
</div>

<!-- 2 · PARA QUIÉN -->
<section aria-labelledby="pq">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Para quién</span><h2 id="pq" class="disp h2">Hecho para tu negocio.</h2></div></div>
<div class="my-g3">
<div><span class="my-ic">01</span><h3>Tiendas y concept stores</h3><p>Tiendas naturistas, de diseño, boutiques y de regalo. Botanicals, Science y Rituals listos para anaquel.</p></div>
<div><span class="my-ic">02</span><h3>Cafés y restaurantes</h3><p>Lattes con Melena de León o Cordyceps, cacaos y chais funcionales para tu menú. Para barra, con display incluido desde 4 productos.</p></div>
<div><span class="my-ic">03</span><h3>Spas, gimnasios y estudios</h3><p>Yoga, pilates, spas y hoteles boutique. Rituales para tu clientela y producto para llevar a casa.</p></div>
</div>
</section>

<!-- 3 · POR QUÉ COMMONS -->
<section class="my-why" aria-labelledby="pc">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Por qué Commons</span><h2 id="pc" class="disp h2">Lo que vendes.</h2></div></div>
<div class="my-g4">
<div><h3>Extractos estandarizados</h3><p>Activo declarado en cada producto: 5% withanólidos en Ashwagandha, 25% betaglucanos en Reishi.</p></div>
<div><h3>Ingredientes de patente</h3><p>Affron®, Reducose®, Eriomin® y Creapure®, en las dosis que se han estudiado.</p></div>
<div><h3>Sin rellenos ni micelio</h3><p>Hongos 100% cuerpo fructífero. Nada escondido en la etiqueta.</p></div>
<div><h3>Una marca que tu cliente ya conoce</h3><p>Estamos en Liverpool, HEB, Sanborns, Fresko La Comer y Farmacias San Pablo.</p></div>
</div>
</section>

<!-- 4 · LO QUE RECIBES -->
<section aria-labelledby="lr">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Lo que recibes</span><h2 id="lr" class="disp h2">Más que producto.</h2></div></div>
<div class="my-g4">
<div><h3>Un solo precio de mayoreo</h3><p>El mismo para todos los negocios, sin letras chiquitas.</p></div>
<div><h3>Capacitación para tu equipo</h3><p>Qué es cada planta y cómo recomendarla.</p></div>
<div><h3>Muestras y folletos</h3><p>Para que tu clientela pruebe y se lleve la información a casa.</p></div>
<div><h3>Displays para tu producto</h3><p>Según el volumen de tu pedido. En barras de café, desde 4 productos.</p></div>
</div>
</section>

<!-- 5 · CÓMO FUNCIONA -->
<section id="como" aria-labelledby="cf">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Cómo funciona</span><h2 id="cf" class="disp h2">Cuatro pasos, sin contratos.</h2></div></div>
<div class="my-steps">
<div><span class="n num">1</span><b>Llena el formulario</b><p>Dos minutos. Cuéntanos de tu negocio.</p></div>
<div><span class="n num">2</span><b>Recibe el catálogo</b><p>Revisamos tus datos y te lo mandamos por correo, con la lista de precios de mayoreo.</p></div>
<div><span class="n num">3</span><b>Haz tu primer pedido</b><p>Por correo o WhatsApp. Pedido mínimo de $8,000.</p></div>
<div><span class="n num">4</span><b>Reabastece cuando quieras</b><p>Sin contratos. Pides cuando lo necesites.</p></div>
</div>
<div class="my-terms yellow">
<div><span class="lab">Pedido mínimo</span><b class="num">$8,000</b></div>
<div><span class="lab">Entrega</span><b>5 a 7 días hábiles</b></div>
<div><span class="lab">Envíos</span><b>A todo México</b></div>
<div><span class="lab">Ventas · WhatsApp</span><b class="num">55 7908 4274</b></div>
</div>
</section>

<!-- 6 · CATÁLOGO (FORMULARIO) -->
<section id="catalogo" class="my-form" aria-labelledby="ca">
<div class="cell">
<div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Catálogo de mayoreo</span><h2 id="ca" class="disp h2" style="max-width: 10ch">Recibe el catálogo.</h2></div>
<p class="sub">Déjanos tus datos y te mandamos el catálogo y la lista de precios a tu correo. Si prefieres hablar con alguien, escríbenos por WhatsApp a ventas: 55 7908 4274.</p>
</div>
{%- form 'contact', id: 'cm-mayoreo', class: 'my-fields' -%}
{%- if form.posted_successfully? -%}<div class="my-ok"><span class="lab">Listo</span><b>Recibimos tus datos.</b><span class="small" style="color: #2C342F">Alguien de ventas te manda el catálogo y la lista de precios a tu correo en 1 a 2 días hábiles.</span></div>
{%- else -%}
{%- if form.errors -%}<div class="cm-ok" style="background:#F2B8C0">Revisa los campos: {{ form.errors | default_errors }}</div>{%- endif -%}
<input type="hidden" name="contact[Asunto]" value="Mayoreo · catálogo">
<div class="my-row"><label>Nombre<input class="in" type="text" name="contact[name]" required></label><label>Nombre del negocio<input class="in" type="text" name="contact[Negocio]" required></label></div><label>Tipo de negocio</label><div class="my-chips"><label class="cm-chip"><input type="radio" name="contact[Tipo de negocio]" value="Tienda" checked hidden><span>Tienda</span></label><label class="cm-chip"><input type="radio" name="contact[Tipo de negocio]" value="Café o restaurante" hidden><span>Café o restaurante</span></label><label class="cm-chip"><input type="radio" name="contact[Tipo de negocio]" value="Spa, gym o estudio" hidden><span>Spa, gym o estudio</span></label><label class="cm-chip"><input type="radio" name="contact[Tipo de negocio]" value="Otro" hidden><span>Otro</span></label></div><div class="my-row"><label>Ciudad<input class="in" type="text" name="contact[Ciudad]" required></label><label>Correo<input class="in" type="email" name="contact[email]" required></label></div><div class="my-row"><label>WhatsApp<input class="in" type="tel" name="contact[phone]" required></label><label>Instagram o sitio web<input class="in" type="text" name="contact[Instagram]"></label></div><label>¿Qué te interesa? Puedes marcar varias.</label><div class="my-chips"><label class="cm-chip"><input type="checkbox" name="contact[Interés][]" value="Botanicals" checked hidden><span>Botanicals</span></label><label class="cm-chip"><input type="checkbox" name="contact[Interés][]" value="Science" hidden><span>Science</span></label><label class="cm-chip"><input type="checkbox" name="contact[Interés][]" value="Rituals" hidden><span>Rituals</span></label></div><input type="hidden" name="contact[body]" value="Solicitud de catálogo de mayoreo"><label class="my-chk" style="cursor:pointer"><input type="checkbox" required style="width:18px;height:18px;accent-color:#141A16"> Acepto el aviso de privacidad.</label>
<button type="submit" class="btn dark" style="align-self: flex-start; border: 0; cursor: pointer">Recibir el catálogo<span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></button>
{%- endif -%}
{%- endform -%}
</section>

<!-- 7 · PREGUNTAS -->
<section class="my-faq" aria-labelledby="pf">
<div class="cell"><span class="lab">Mayoreo</span><h2 id="pf" class="disp h2" style="max-width: 10ch">Preguntas frecuentes.</h2><a class="tlink" href="/pages/especialistas" style="align-self: flex-start">Ir a Especialistas</a></div>
<div class="my-list"><details class="my-q"><summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:60px"><span>¿Hay pedido mínimo?</span><span aria-hidden="true">+</span></summary><p>Sí: $8,000 por pedido. La entrega es de 5 a 7 días hábiles, a todo México.</p></details><details class="my-q"><summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:60px"><span>¿El precio es igual para todos?</span><span aria-hidden="true">+</span></summary><p>Sí. Tiendas, cafés y estudios tienen el mismo precio de mayoreo.</p></details><details class="my-q"><summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:60px"><span>¿Me dan display?</span><span aria-hidden="true">+</span></summary><p>Según el volumen de tu pedido. En barras de café, siempre, desde 4 productos.</p></details><details class="my-q"><summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:60px"><span>Soy especialista en salud, ¿es aquí?</span><span aria-hidden="true">+</span></summary><p>Para especialistas tenemos un programa aparte, con su propia forma de colaborar. Aplica en la página de Especialistas.</p></details><details class="my-q"><summary style="display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:60px"><span>¿Puedo usar fotos de Commons en mis redes?</span><span aria-hidden="true">+</span></summary><p>Sí. Te compartimos fotos y materiales para que lo comuniques.</p></details></div>
</section>


</div>
</div>
{%- comment -%} v5 · mayoreo {%- endcomment -%}
