{
  "name": "Mayoreo v5",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Fotos de la página"
    },
    {
      "type": "image_picker",
      "id": "cm_img_1",
      "label": "Foto 1 · Frascos Commons Botanicals sobre fondo naranja"
    }
  ]
}
{% endschema %}
