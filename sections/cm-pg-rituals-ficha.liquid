</main>

</div>
</div>
<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var f = root.querySelector('.rf-act'); if (f){ var q = f.querySelector('[data-qty]'), t = f.querySelector('[data-total]'), unit = {{ product.price | json }};
  function upd(){ var n = Math.max(1, parseInt(q.value, 10) || 1); q.value = n; t.textContent = '$' + (unit * n / 100).toLocaleString('es-MX'); }
  f.querySelectorAll('[data-q]').forEach(function(b){ b.addEventListener('click', function(){ q.value = (parseInt(q.value, 10) || 1) + (+b.dataset.q); upd(); }); });
  q.addEventListener('change', upd); }
})();
</script>
