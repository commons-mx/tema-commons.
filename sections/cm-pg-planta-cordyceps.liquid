{{ 'cm-pg-planta.css' | asset_url | stylesheet_tag }}
<div class="cmpg" id="cmpg-{{ section.id }}">
<div class="v4 tA acY">
{%- assign rp = all_products["cordyceps-extracto-commons"] -%}

<div class="pl-top"><a href="/pages/que-son">Glosario</a><span>/</span><a href="/pages/que-son">Hongos</a><span>/</span><span>Cordyceps</span></div>

<section class="pl-hero" aria-labelledby="ph">
<div class="pl-ph" style="background-color: #EFEBE3"><img class="cover" src="{%- if section.settings.cm_img_1 != blank -%}{{ section.settings.cm_img_1 | image_url: width: 2000 }}{%- else -%}{{ 'Cordyceps_commons_adaptogenos_b42f48d6-ba8a-4408-b197-d38cdaf58d47.jpg' | file_url }}{%- endif -%}" loading="eager" alt="Cordyceps · Cordyceps militaris [validar especie]"></div>
<div class="pl-tx">
<span class="lab">Glosario · Hongo · Energía</span>
<h1 id="ph" class="disp h1">Cordyceps</h1>
<span class="pl-lat">Cordyceps militaris [validar especie] · también conocido como Dong chong xia cao</span>
<p class="sub">El hongo que en el Tíbet y China se reservaba para la energía y la resistencia. El nuestro es cuerpo fructífero, sin micelio.</p>
{%- if rp.id -%}<div class="pl-buy"><div class="pi"><img src="{%- if rp.featured_image -%}{{ rp.featured_image | image_url: width: 800 }}{%- endif -%}" loading="lazy" alt="{{ rp.title | escape }}"></div><div><b>Commons Cordyceps</b><span>20% betaglucanos · cápsulas y polvo · desde {{ rp.price_min | money_without_trailing_zeros }}</span></div><a class="pl-add" href="#s4" style="display:inline-flex;align-items:center;text-decoration:none">Comprar</a></div>{%- endif -%}
</div>
</section>
<nav class="pl-toc" aria-label="En esta página"><a href="#s0">En 10 segundos</a><a href="#s1">Lo que hay dentro</a><a href="#s2">Lo que dice la investigación</a><a href="#s3">Cómo se toma</a><a href="#s4">Dónde lo encuentras</a><a href="#s5">Antes de tomarlo</a></nav>

<section id="s0" aria-label="En 10 segundos">
<div class="pl-facts">
<div><span class="lab">Parte que usamos</span><b>Cuerpo fructífero</b></div>
<div><span class="lab">Tradición</span><b>Medicina tradicional china y tibetana</b></div>
<div><span class="lab">De dónde viene</span><b>Cultivado [validar origen]</b></div>
<div><span class="lab">Momento</span><b>Mañana o tarde</b></div>
<div><span class="lab">Nuestro extracto</span><b>20% betaglucanos</b></div>
<div><span class="lab">Formatos</span><b>Cápsulas y polvo</b></div>
</div>
</section>

<section id="s1" class="pl-in" aria-labelledby="ld">
<div class="cell"><span class="lab">Lo que hay dentro</span><h2 id="ld" class="disp h2">Los betaglucanos.</h2><p class="sub" style="max-width: 48ch">Son los compuestos del hongo que más se han estudiado, y los declaramos en la etiqueta.</p></div>
<div class="cell"><span class="pl-big num">100<small>mg</small></span><p class="small" style="margin: 0; font-size: 16px; max-width: 34ch">de betaglucanos en cada cápsula de 500 mg (extracto al 20%).</p></div>
</section>

<section id="s2" aria-labelledby="ri">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Lo que dice la investigación</span><h2 id="ri" class="disp h2">Tradición, con estudios.</h2></div><span class="small">[Validar con Fer y regulatorio]</span></div>
<div class="pl-res">
<div><span class="n">Se ha estudiado para</span><p>Energía · Rendimiento físico</p><span class="small">Estudios del ingrediente, no de nuestro producto terminado.</span></div>
<div><span class="n">500 mg</span><p>de extracto en cada cápsula o en ½ scoop. Es la porción base de Botanicals.</p></div>
<div><span class="n">unas 3 semanas</span><p>es lo que suele tardar en notarse. Dale constancia.</p></div>
</div>
<div class="pl-refs"><details><summary style="display:flex;justify-content:space-between;align-items:center;min-height:64px;padding:0 40px;font-size:17px"><span>Ver las referencias</span><span aria-hidden="true">+</span></summary><ol><li><a href="https://pubmed.ncbi.nlm.nih.gov/30954592/" target="_blank" rel="noopener">Advance in Cordyceps militaris (Linn) Link polysaccharides: Isolation, structure, and bioactivities: A review</a></li><li><a href="https://pubmed.ncbi.nlm.nih.gov/31410524/" target="_blank" rel="noopener">Advances in research on Cordyceps militaris degeneration</a></li><li><a href="https://pubmed.ncbi.nlm.nih.gov/36521708/" target="_blank" rel="noopener">Cordyceps militaris acidic polysaccharides improve learning and memory impairment in mice with exercise fatigue through the PI3K/NRF2/HO-1 signalling pathway</a></li></ol></details></div>
</section>

<section id="s3" aria-labelledby="ct">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Cómo se toma</span><h2 id="ct" class="disp h2">Poco, todos los días y con constancia.</h2></div></div>
<div class="pl-steps">
<div><span class="n num">1</span><b>1 cápsula o ½ scoop al día</b><p>Empieza con la mitad la primera semana y luego sube a la porción completa.</p></div>
<div><span class="n num">2</span><b>6 días a la semana</b><p>Descansa 1 día, el que tú elijas. Ciclo: Sin pausa larga.</p></div>
<div><span class="n num">3</span><b>De día</b><p>En la mañana o antes de entrenar. No quita el sueño, así que también va en la tarde.</p></div>
</div>
</section>

{%- if rp.id -%}
<section id="s4" aria-labelledby="dl">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Dónde lo encuentras</span><h2 id="dl" class="disp h2">Cordyceps en Commons.</h2></div></div>
<div class="pl-one">
<div class="im"><a href="{{ rp.url }}"><img src="{%- if rp.featured_image -%}{{ rp.featured_image | image_url: width: 800 }}{%- endif -%}" loading="lazy" alt="{{ rp.title | escape }}"></a></div>
<div class="tx">
<span class="lab">Commons Botanicals</span>
<b class="disp">{{ rp.title }}</b>
<span class="small">20% betaglucanos · cuerpo fructífero</span>
<span class="lab" style="margin-top: 8px">Elige tu presentación</span>
<div class="pl-fmts" role="radiogroup" aria-label="Presentación">{%- for v in rp.variants -%}<button type="button" class="{% if forloop.first %}on{% endif %}" role="radio" data-v="{{ v.id }}" data-p="{{ v.price | money_without_trailing_zeros }}" data-t="{{ v.title | escape }}"{% unless v.available %} disabled{% endunless %}><b>{{ v.title }}</b><span>{{ v.price | money_without_trailing_zeros }}</span></button>{%- endfor -%}</div>
<span class="small" data-fd>{{ rp.selected_or_first_available_variant.title }}</span>
<div class="row"><span class="num pl-price" data-fp>{{ rp.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span><button type="button" class="pl-add" data-add data-v="{{ rp.selected_or_first_available_variant.id }}">Agregar al carrito</button></div>
<a class="tlink" href="{{ rp.url }}" style="align-self:flex-start">Ver la ficha completa</a>
</div>
</div>
<p class="pl-note">Llevando 2 frascos ahorras 10%; con 3 o más, 15%. <a class="tlink" href="/#protocolo">Arma tu protocolo</a></p>
</section>
{%- endif -%}

<section aria-labelledby="cb">
<div class="hd-row"><div style="display: flex; flex-direction: column; gap: 14px"><span class="lab">Combina bien con</span><h2 id="cb" class="disp h2">Cordyceps, acompañado.</h2></div></div>
<div class="pl-comb">{%- assign cp = all_products["melena-de-leon-capsulas-organicas"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Enfoque</span><b>{{ cp.title }}</b><span>Botanicals · hongo</span></div></a>{%- endif -%}{%- assign cp = all_products["raiz-rhodiola-rosea-full-polvo"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Energía</span><b>{{ cp.title }}</b><span>Botanicals · raíz</span></div></a>{%- endif -%}{%- assign cp = all_products["cacao-latte-boost"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Ritual de día</span><b>{{ cp.title }}</b><span>Rituals · un sobre</span></div></a>{%- endif -%}</div>
</section>

<section id="s5" class="pl-warn" aria-labelledby="at">
<div class="cell"><span class="lab">Antes de tomarlo</span><h2 id="at" class="disp h2" style="max-width: 12ch">Lo que debes saber.</h2></div>
<div class="pl-wl">
<h3>No se recomienda si…</h3>
<ul><li>Estás embarazada o lactando.</li><li>Eres menor de 18 años.</li></ul>
<h3>Consulta a tu médico antes si…</h3>
<ul><li>Tomas anticoagulantes.</li><li>Tomas medicamentos para la diabetes.</li><li>Tienes una condición autoinmune o tomas inmunosupresores.</li></ul>
<p class="small">Si tienes dudas, escríbenos por WhatsApp y te orientamos. [Validar precauciones con Fer]</p>
<h3>Cómo guardarlo</h3>
<p>Lejos de la luz y la humedad, a temperatura ambiente. Dura hasta 36 meses en buenas condiciones. [Confirmar caducidad por lote]</p>
</div>
</section>

<nav class="pl-more" aria-label="Sigue aprendiendo">
<a href="/pages/adaptogenos">Qué es un adaptógeno<span aria-hidden="true">→</span></a>
<a href="/pages/nuestra-ciencia">Nuestra ciencia y la biblioteca de evidencia<span aria-hidden="true">→</span></a>
<a href="/pages/que-son">Volver al glosario<span aria-hidden="true">→</span></a>
</nav>

</div>
</div>
<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var add = root.querySelector('[data-add]'), fp = root.querySelector('[data-fp]'), fd = root.querySelector('[data-fd]');
root.querySelectorAll('.pl-fmts [data-v]').forEach(function(x){ x.addEventListener('click', function(){
  root.querySelectorAll('.pl-fmts [data-v]').forEach(function(y){ y.classList.toggle('on', y === x); y.setAttribute('aria-checked', y === x); });
  add.dataset.v = x.dataset.v; fp.textContent = x.dataset.p; fd.textContent = x.dataset.t; add.textContent = 'Agregar al carrito'; add.classList.remove('on'); }); });
if (add) add.addEventListener('click', function(){ add.disabled = true;
  fetch('{{ routes.cart_add_url }}.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: +add.dataset.v, quantity: 1 }] }) })
  .then(function(r){ if (!r.ok) throw r; add.textContent = 'Agregado ✓'; add.classList.add('on');
    if (window.Alpine && Alpine.store('xMiniCart')) { Alpine.store('xMiniCart').reLoad && Alpine.store('xMiniCart').reLoad(); Alpine.store('xMiniCart').openCart && Alpine.store('xMiniCart').openCart(); } })
  .catch(function(){ location.href = '{{ routes.cart_url }}'; }).finally(function(){ add.disabled = false; }); });
})();
</script>
