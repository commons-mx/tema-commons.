<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
root.querySelectorAll('[data-g]').forEach(function(b){ if (b.tagName !== 'BUTTON') return; b.addEventListener('click', function(){
  root.querySelectorAll('button[data-g]').forEach(function(x){ x.classList.toggle('on', x === b); });
  root.querySelectorAll('.mn-card[data-g]').forEach(function(c){ c.hidden = c.dataset.g !== b.dataset.g; });
}); });
var K = 'cm-manual-v1', st = {}; try { st = JSON.parse(localStorage.getItem(K) || '{}'); } catch (e) {}
st.m = st.m || {}; st.f = st.f || {};
function save(){ try { localStorage.setItem(K, JSON.stringify(st)); } catch (e) {} }
function paint(){
  root.querySelectorAll('[data-k]').forEach(function(c){ var v = st.m[c.dataset.k] || 0; c.className = 'mn-d' + (v === 1 ? ' on' : (v === 2 ? ' rest' : '')); c.textContent = v === 1 ? '✓' : (v === 2 ? '–' : ''); });
  root.querySelectorAll('[data-f]').forEach(function(c){ c.classList.toggle('on', st.f[c.dataset.f] === +c.dataset.v); });
}
root.querySelectorAll('[data-k]').forEach(function(c){ c.addEventListener('click', function(){ var k = c.dataset.k; st.m[k] = ((st.m[k] || 0) + 1) % 3; if (!st.m[k]) delete st.m[k]; save(); paint(); }); });
root.querySelectorAll('[data-f]').forEach(function(c){ c.addEventListener('click', function(){ st.f[c.dataset.f] = +c.dataset.v; save(); paint(); }); });
paint();
})();
</script>
