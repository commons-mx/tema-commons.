<div class="mn-filt" role="tablist" aria-label="Filtrar productos"><button type="button" class="on" data-g="h" role="tab">Hongos<span>6</span></button><button type="button" class="" data-g="r" role="tab">Hierbas y raíces<span>12</span></button><button type="button" class="" data-g="s" role="tab">Master blend y Science<span>4</span></button></div>
