<span class="nm"><span class="sy-lbl">Botanicals</span><b>Astrágalo</b><span class="ev-tags"><span class="ic-defensas">Defensas</span><span class="ic-energia">Energía</span></span></span>
<span class="lv"><span class="ev-dots" aria-hidden="true"><i class="on"></i><i></i><i></i></span><span>Uso tradicional</span></span>
