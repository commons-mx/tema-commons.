<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
var line = 'all', need = '';
function apply(){ root.querySelectorAll('.ev-row').forEach(function(r){ var ok = (line === 'all' || r.dataset.line === line) && (!need || r.dataset.needs.split(',').indexOf(need) >= 0); r.hidden = !ok; }); }
root.querySelectorAll('[data-tab]').forEach(function(b){ b.addEventListener('click', function(){ line = b.dataset.tab; root.querySelectorAll('[data-tab]').forEach(function(x){ x.classList.toggle('on', x === b); }); apply(); }); });
root.querySelectorAll('[data-need]').forEach(function(b){ b.addEventListener('click', function(){ need = need === b.dataset.need ? '' : b.dataset.need; root.querySelectorAll('[data-need]').forEach(function(x){ x.classList.toggle('on', x.dataset.need === need); }); apply(); }); });
root.querySelectorAll('.ev-row').forEach(function(r){ var body = r.querySelector('.ev-body'), btn = r.querySelector('.ev-rh'), pm = r.querySelector('.pm'); if (!body) return;
  btn.addEventListener('click', function(){ var open = body.hidden; body.hidden = !open; pm.textContent = open ? '−' : '+'; btn.setAttribute('aria-expanded', open ? 'true' : 'false'); }); });
})();
</script>
