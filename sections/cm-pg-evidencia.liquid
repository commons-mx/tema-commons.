root.querySelectorAll('[data-need]').forEach(function(b){ b.addEventListener('click', function(){ need = need === b.dataset.need ? '' : b.dataset.need; root.querySelectorAll('[data-need]').forEach(function(x){ x.classList.toggle('on', x.dataset.need === need); }); apply(); }); });
root.querySelectorAll('.ev-row').forEach(function(r){ var body = r.querySelector('.ev-body'), btn = r.querySelector('.ev-rh'); if (!body) return;
