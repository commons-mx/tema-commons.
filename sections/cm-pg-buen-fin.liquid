<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
function cmAdd(items, btn){ var t = btn ? btn.textContent : '';
  if (btn){ btn.disabled = true; btn.textContent = 'Agregando…'; }
  return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
    .then(function(r){ return r.json(); }).then(function(d){
      if (btn){ btn.disabled = false; btn.textContent = d && d.status ? 'No disponible' : '✓ Agregado'; setTimeout(function(){ btn.textContent = t; }, 1800); }
      document.dispatchEvent(new CustomEvent('cart:refresh')); try { document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true })); } catch(e) {}
      return d; }); }
var picks = [];
function money(n){ return '$' + n.toLocaleString('es-MX'); }
function paint(){
  var nFree = Math.floor(picks.length / 3), order = picks.map(function(p, i){ return [p.p, i]; }).sort(function(a, b){ return a[0] - b[0]; }), free = {};
  for (var k = 0; k < nFree; k++) free[order[k][1]] = true;
  var tot = 0, full = 0; picks.forEach(function(p, i){ full += p.p; if (!free[i]) tot += p.p; });
  var g = picks.length % 3, msg = picks.length === 0 ? 'Agrega 3 frascos y el de menor precio va gratis.' : (g === 0 ? 'Listo: ' + nFree + (nFree === 1 ? ' frasco gratis.' : ' frascos gratis.') + ' Agrega 3 más y va otro gratis.' : 'Te ' + (3 - g === 1 ? 'falta 1 frasco' : 'faltan ' + (3 - g) + ' frascos') + ' para tu ' + (nFree ? 'siguiente ' : '') + 'frasco gratis.');
  var box = root.querySelector('[data-lines]'); if (box) box.innerHTML = picks.map(function(p, i){ return '<div class="l"><span>' + p.n + '<small>' + p.f + '</small></span><span class="pr">' + (free[i] ? '<s>' + money(p.p) + '</s>Gratis' : money(p.p)) + '</span></div>'; }).join('');
  var em = root.querySelector('[data-empty]'); if (em) em.hidden = picks.length > 0;
  root.querySelectorAll('.bf-slots i, .bf-slots span').forEach(function(s, i){ var c = picks.length ? picks.length - Math.floor((picks.length - 1) / 3) * 3 : 0; s.className = i < c ? (c === 3 && i === 2 ? 'free' : 'on') : ''; });
  var setT = function(sel, t){ var e = root.querySelector(sel); if (e) e.textContent = t; };
  setT('[data-msg]', msg); setT('[data-total]', money(tot)); setT('[data-ship]', tot >= 3500 ? 'Tu envío es gratis.' : 'Te faltan ' + money(3500 - tot) + ' para el envío gratis.');
}
root.querySelectorAll('[data-vid]').forEach(function(b){ b.addEventListener('click', function(e){ e.preventDefault(); if (!b.dataset.vid) return;
  cmAdd([{ id: +b.dataset.vid, quantity: 1 }], b).then(function(d){ if (d && !d.status){ picks.push({ n: b.dataset.n, f: b.dataset.f, p: +b.dataset.p }); paint(); } }); }); });
root.querySelectorAll('[data-add]').forEach(function(b){ b.addEventListener('click', function(e){ e.preventDefault(); cmAdd([{ id: +b.dataset.add, quantity: 1 }], b); }); });
root.querySelectorAll('[data-go]').forEach(function(b){ b.addEventListener('click', function(){ location.href = b.dataset.go; }); });
paint();
})();
</script>
