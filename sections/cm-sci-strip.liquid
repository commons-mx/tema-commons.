{%- assign s = section.settings -%}
<div class="cm4"><a class="scistrip" href="{{ s.link | default: '/products/azafran-1' }}">
<img src="{{ s.asset | default: 'cm-hero-sci.jpg' | asset_url }}" alt="Latas de Azafrán y Magnesio P.M. de Commons Science" width="1600" height="900" loading="lazy">
<span class="sst"><span class="ssl">{{ s.eyebrow }}</span><span class="ssh">{{ s.text }}</span></span>
<span class="ssa" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a></div>
<style>
.cm4 .scistrip{display:flex;align-items:center;gap:16px;background:#141A16;color:#F6F3EC;text-decoration:none;padding:14px 40px;border-bottom:1px solid var(--rule)}
.cm4 .scistrip img{width:120px;height:68px;object-fit:cover;border-radius:6px;background:#fff;flex:0 0 auto}
.cm4 .scistrip .sst{display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}
.cm4 .scistrip .ssl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#DFF68F;font-weight:500}
.cm4 .scistrip .ssh{font-size:17px;line-height:1.25}
.cm4 .scistrip .ssa{width:38px;height:38px;border-radius:99px;background:#DFF68F;color:#141A16;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
@media (max-width:749px){.cm4 .scistrip{padding:12px 16px;gap:12px}.cm4 .scistrip img{width:84px;height:56px}.cm4 .scistrip .ssh{font-size:15px}.cm4 .scistrip .ssa{width:32px;height:32px}}
</style>
{% schema %}
{
  "name": "Commons · Franja Science",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Nuevo · Commons Science"},
    {"type": "text", "id": "text", "label": "Texto", "default": "Azafrán, nuestra primera fórmula"},
    {"type": "url", "id": "link", "label": "Liga"},
    {"type": "text", "id": "asset", "label": "Imagen (archivo del tema)", "default": "cm-hero-sci.jpg"}
  ],
  "presets": [{"name": "Commons · Franja Science"}]
}
{% endschema %}
