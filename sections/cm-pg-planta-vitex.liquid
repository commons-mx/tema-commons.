<div class="pl-comb">{%- assign cp = all_products["shatavari-full-polvo"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Ciclo</span><b>{{ cp.title }}</b><span>Botanicals · raíz</span></div></a>{%- endif -%}{%- assign cp = all_products["ashwagandha-organico-capsulas-extracto"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Estrés</span><b>{{ cp.title }}</b><span>Botanicals · raíz</span></div></a>{%- endif -%}{%- assign cp = all_products["moon-rose-balance"] -%}{%- if cp.id -%}<a href="{{ cp.url }}"><div><div class="circ">{%- if cp.featured_image -%}<img src="{{ cp.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ cp.title | escape }}">{%- else -%}<span class="ini">{{ cp.title | slice: 0 }}</span>{%- endif -%}</div></div><div><span class="lab">Ritual</span><b>{{ cp.title }}</b><span>Rituals · blend</span></div></a>{%- endif -%}</div>
</section>

