{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
-%}
<div class="cm4" id="cm-hero-{{ section.id }}">
<section class="hero" aria-label="Destacado">
  {%- for block in slides -%}
    {%- capture fb -%}{{ block.settings.asset | default: 'cm-hero-' | append: '' }}{%- if block.settings.asset == blank -%}{{ forloop.index }}.jpg{%- endif -%}{%- endcapture -%}
    {%- assign dual = false -%}{%- if block.settings.image2 != blank or block.settings.asset2 != blank -%}{%- assign dual = true -%}{%- endif -%}
    <div class="cm-slide-bg{% if forloop.first %} on{% endif %}{% if dual %} dual{% endif %}" data-i="{{ forloop.index0 }}">
      <div class="hh">
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hbg', sizes: '100vw', loading: 'eager', alt: block.settings.heading }}
      {%- else -%}
        <img class="hbg" src="{{ fb | asset_url }}" alt="{{ block.settings.heading | escape }}" loading="eager">
      {%- endif -%}
      {%- if dual and block.settings.cap1 != blank -%}<span class="hcap"><i style="background:#CDBDF0"></i>{{ block.settings.cap1 }}</span>{%- endif -%}
      </div>
      {%- if dual -%}
      <div class="hh">
        {%- if block.settings.image2 != blank -%}{{ block.settings.image2 | image_url: width: 1600 | image_tag: class: 'hbg', sizes: '100vw', loading: 'eager', alt: block.settings.cap2 }}{%- else -%}<img class="hbg" src="{{ block.settings.asset2 | asset_url }}" alt="{{ block.settings.cap2 | escape }}" loading="eager">{%- endif -%}
        {%- if block.settings.cap2 != blank -%}<span class="hcap"><i style="background:#DFF68F"></i>{{ block.settings.cap2 }}</span>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
  <div class="shade"></div>
  <div class="hgrid">
    <div class="hleft">
      <div class="hcopy">
        {%- if section.settings.rating != blank -%}<span class="hrate"><span class="hstars" aria-hidden="true">★★★★★</span>{{ section.settings.rating }}</span>{%- endif -%}{%- if section.settings.eyebrow != blank -%}<span class="hfirst">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- for block in slides -%}
        <div class="cm-slide{% if forloop.first %} on{% endif %}" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="tags">
            {%- if block.settings.badge != blank -%}<span class="badge{% if block.settings.badge_style == 'bot' %} bot{% endif %}">{{ block.settings.badge }}</span>{%- endif -%}
            {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
            {%- if block.settings.tag2 != blank -%}<span class="tag hide-m">{{ block.settings.tag2 }}</span>{%- endif -%}
          </div>
          {%- if forloop.first -%}<h1 class="disp h1">{{ block.settings.heading }}</h1>{%- else -%}<h2 class="disp h1">{{ block.settings.heading }}</h2>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="sub{% if section.settings.text_mobile %} hdesc{% else %} hide-m{% endif %}">{{ block.settings.text }}</p>{%- endif -%}
          <div class="ctas">
            {%- if block.settings.button_label != blank -%}<a class="btn" href="{{ block.settings.button_link | default: '#' }}"><span>{{ block.settings.button_label }}</span><span class="arw"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a>{%- endif -%}
            {%- if block.settings.button2_label != blank -%}<a class="hlink" href="{{ block.settings.button2_link | default: '#' }}">{{ block.settings.button2_label }}</a>{%- endif -%}
          </div>
        </div>
        {%- endfor -%}
      </div>
      {%- if slides.size > 1 -%}
      <div class="hprog" role="tablist" aria-label="Líneas" style="grid-template-columns: repeat({{ slides.size }}, minmax(0,1fr))">
        {%- for block in slides -%}
        <button type="button" class="{% if forloop.first %}on{% endif %}" data-i="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"><b>0{{ forloop.index }}</b>{{ block.settings.tab_label | default: block.settings.heading }}</button>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    <div class="hright"></div>
  </div>
</section>
</div>
<style>
  #cm-hero-{{ section.id }} .cm-slide{display:none;flex-direction:column;gap:24px;align-items:flex-start}
  #cm-hero-{{ section.id }} .cm-slide.on{display:flex}
  #cm-hero-{{ section.id }} .cm-slide-bg{position:absolute;inset:0;opacity:0;transition:opacity .6s ease}
  #cm-hero-{{ section.id }} .cm-slide-bg.on{opacity:1}
  #cm-hero-{{ section.id }} .hleft{justify-content:space-between}
  @media (prefers-reduced-motion: reduce){#cm-hero-{{ section.id }} .cm-slide-bg{transition:none}}
</style>
<script>
  (function(){
    var root = document.getElementById('cm-hero-{{ section.id }}'); if(!root) return;
    var tabs = root.querySelectorAll('.hprog button'), n = tabs.length, cur = 0, timer = null;
    var secs = {{ section.settings.autoplay | default: 0 }};
    function go(i){ cur = i;
      root.querySelectorAll('[data-i]').forEach(function(el){ var on = String(el.dataset.i) === String(i); el.classList.toggle('on', on); if(el.getAttribute('role')==='tab') el.setAttribute('aria-selected', on ? 'true' : 'false'); });
    }
    tabs.forEach(function(t){ t.addEventListener('click', function(){ go(+t.dataset.i); if(timer){ clearInterval(timer); timer = null; } }); });
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (secs > 0 && n > 1 && !reduce && !window.Shopify?.designMode) { timer = setInterval(function(){ go((cur + 1) % n); }, secs * 1000); }
    document.addEventListener('shopify:block:select', function(e){ var el = root.querySelector('.cm-slide[data-i]'); var sl = e.target.closest && e.target.closest('.cm-slide'); if (sl) go(+sl.dataset.i); });
  })();
</script>
<style>#cm-hero-{{ section.id }} .hero .hbg{object-position:32% 50%}@media (max-width:749px){.hero .hbg{object-position:40% 50%}}</style>
{% schema %}
{
  "name": "Commons · Hero",
  "tag": "div",
  "class": "cm-section",
  "settings": [
    {
      "type": "text",
      "id": "rating",
      "label": "Estrellas · texto",
      "info": "Ej. 4.91 · +1,500 reseñas. Vacío = sin estrellas"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Línea de arriba",
      "default": "Pioneros de los adaptógenos en México · desde 2020"
    },
    {
      "type": "checkbox",
      "id": "text_mobile",
      "label": "Mostrar la descripción también en celular",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Cambiar solo cada (segundos, 0 = no)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Vista",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto de fondo"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Foto del tema (si no subes una)",
          "info": "Ej. cm-hero-2.jpg"
        },
        {
          "type": "text",
          "id": "cap1",
          "label": "Rótulo foto 1",
          "info": "Ej. Commons Botanicals"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "Foto 2 (segunda línea)"
        },
        {
          "type": "text",
          "id": "asset2",
          "label": "Foto 2 del tema (si no subes una)"
        },
        {
          "type": "text",
          "id": "cap2",
          "label": "Rótulo foto 2",
          "info": "Ej. Commons Science"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Texto de la línea de abajo",
          "default": "Science · nuestra línea nueva"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta",
          "default": "Nuevo"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Color de la etiqueta",
          "options": [
            {
              "value": "sci",
              "label": "Lima (Science)"
            },
            {
              "value": "bot",
              "label": "Verde bosque (Botanicals)"
            }
          ],
          "default": "sci"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Etiqueta 2"
        },
        {
          "type": "text",
          "id": "tag2",
          "label": "Etiqueta 3 (solo escritorio)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Azafrán. La dosis que se estudió."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto (solo escritorio)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón principal",
          "default": "Compra Azafrán"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Liga del botón principal"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "Botón secundario"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Liga del botón secundario"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Commons · Hero",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}





<style>/* hero limpio */
@media (max-width:749px){
#cm-hero-{{ section.id }} .hero{position:relative}
#cm-hero-{{ section.id }} .hero .cm-slide-bg.dual{aspect-ratio:auto !important;height:460px}
#cm-hero-{{ section.id }} .hero .dual .hh:first-child{height:100%;top:0;border-bottom:0}
#cm-hero-{{ section.id }} .hero .dual .hh + .hh{display:none}
#cm-hero-{{ section.id }} .hero .dual .hh:first-child .hbg{object-position:50% 60%}
#cm-hero-{{ section.id }} .hero .dual .hh:first-child .hcap{display:none}
#cm-hero-{{ section.id }} .hgrid,#cm-hero-{{ section.id }} .hleft,#cm-hero-{{ section.id }} .hcopy,#cm-hero-{{ section.id }} .cm-slide,#cm-hero-{{ section.id }} .ctas{position:static !important;min-height:0 !important}
#cm-hero-{{ section.id }} .hleft{padding:20px 16px 24px !important}
#cm-hero-{{ section.id }} .hcopy{gap:8px !important}
#cm-hero-{{ section.id }} .hcopy .hrate{font-size:12px}
#cm-hero-{{ section.id }} .hcopy .h1{font-size:28px !important;line-height:1.08 !important;margin:0 !important}
#cm-hero-{{ section.id }} .hcopy .hdesc,#cm-hero-{{ section.id }} .hcopy .tags{display:none !important}
#cm-hero-{{ section.id }} .hcopy .ctas{margin:0 !important;gap:0 !important}
#cm-hero-{{ section.id }} .hh .btn.hqz{position:absolute !important;left:14px;bottom:14px;top:auto !important;z-index:3;padding-top:5px;padding-bottom:5px;font-size:14px;box-shadow:0 6px 18px rgba(20,26,22,.18)}
#cm-hero-{{ section.id }} .hcopy .hlink{font-size:13px;margin-top:4px}
#cm-hero-{{ section.id }} .hright{display:none}
}
</style>

<script>/* quiz sobre la foto */
(function(){ var r = document.getElementById('cm-hero-{{ section.id }}'); if (!r) return;
  var mq = window.matchMedia('(max-width:749px)'), b = r.querySelector('.hcopy .ctas .btn'), home = b && b.parentNode, nx = b && b.nextSibling;
  function place(){ if (!b) return; var hh = r.querySelector('.cm-slide-bg.on .hh'); if (mq.matches && hh) { hh.appendChild(b); b.classList.add('hqz'); } else if (home) { home.insertBefore(b, nx); b.classList.remove('hqz'); } }
  place(); mq.addEventListener ? mq.addEventListener('change', place) : mq.addListener(place);
})();
</script>
