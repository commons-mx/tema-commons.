<div class="cm4 cm-page">
  <div class="wrap">
    <nav class="cpb lab" aria-label="Migas"><a href="{{ routes.root_url }}">Inicio</a> / <span>{{ page.title }}</span></nav>
    {%- if section.settings.eyebrow != blank -%}<span class="lab cpe">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="disp h1 cph">{{ page.title }}</h1>
    <div class="cpc">{{ page.content }}</div>
    {%- if section.settings.quiz -%}
    <a class="cpq" href="/pages/quiz-commons"><span><span class="lab">Quiz · 3 minutos</span><span class="cpqt">¿No sabes por dónde empezar?</span></span><span class="cpqb">Encuentra tu Commons →</span></a>
    {%- endif -%}
  </div>
</div>
<style>
.cm-page{background:#F7F7F4;color:#141A16;font-family:var(--fb);padding:40px 0 96px}
.cm-page .cpb{display:block;margin-bottom:40px;color:#5B625D}.cm-page .cpb a{color:inherit;text-decoration:none}
.cm-page .cpe{display:block;margin-bottom:16px}
.cm-page .cph{max-width:18ch;margin-bottom:48px}
.cm-page .cpc{max-width:68ch;font-size:18px;line-height:1.65}
.cm-page .cpc h2,.cm-page .cpc h3{font-family:var(--fd);font-weight:400;letter-spacing:-0.01em;line-height:1.15;text-transform:none;margin:48px 0 16px}
.cm-page .cpc h2{font-size:34px}.cm-page .cpc h3{font-size:24px}
.cm-page .cpc p,.cm-page .cpc ul,.cm-page .cpc ol{margin:0 0 18px}
.cm-page .cpc a{color:#141A16;text-underline-offset:3px}
.cm-page .cpc img{max-width:100%;height:auto;margin:24px 0}
.cm-page .cpc table{width:100%;border-collapse:collapse;font-size:16px}.cm-page .cpc td,.cm-page .cpc th{border-top:1px solid #D9D8D1;padding:10px 8px;text-align:left}
.cm-page .cpq{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;max-width:68ch;margin-top:64px;padding:24px 28px;background:#EDE47A;color:#141A16;text-decoration:none}
.cm-page .cpq > span:first-child{display:flex;flex-direction:column;gap:6px}.cm-page .cpqt{font-size:20px;font-weight:500}
.cm-page .cpqb{background:#141A16;color:#fff;padding:12px 20px;border-radius:999px;font-size:15px}
@media (max-width:760px){.cm-page{padding:24px 0 64px}.cm-page .cpb{margin-bottom:28px}.cm-page .cph{margin-bottom:32px}.cm-page .cpc{font-size:17px}.cm-page .cpc h2{font-size:28px}}
</style>
{% schema %}
{
  "name": "Página Commons v5",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta arriba del título"
    },
    {
      "type": "checkbox",
      "id": "quiz",
      "label": "Mostrar franja del quiz al final",
      "default": true
    }
  ]
}
{% endschema %}
