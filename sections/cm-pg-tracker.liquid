<div class="cmpg tk" id="cmpg-{{ section.id }}">
<style>
#cmpg-{{ section.id }}{--bg:#F7F7F4;--ink:#141A16;--ink2:#4A524C;--rule:#141A16;--soft:#DCDCD5;--lime:#EDE47A;--pale:#F4F3B2;--fd:'Jost',system-ui,sans-serif;--fb:'Figtree',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:15px;line-height:1.55;container-type:inline-size}
#cmpg-{{ section.id }} *{box-sizing:border-box}
#cmpg-{{ section.id }} .lab{font-size:11px;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
#cmpg-{{ section.id }} .small{font-size:13px;color:var(--ink2)}
#cmpg-{{ section.id }} h1,#cmpg-{{ section.id }} h2{font-family:var(--fd);font-weight:400;letter-spacing:-.02em;line-height:1.05;margin:0}
#cmpg-{{ section.id }} h1{font-size:44px}
#cmpg-{{ section.id }} h2{font-size:28px}
#cmpg-{{ section.id }} .tk-top{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);border-bottom:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-top > div{padding:48px 40px;display:flex;flex-direction:column;gap:14px}
#cmpg-{{ section.id }} .tk-top > div + div{border-left:1px solid var(--rule);background:var(--pale);justify-content:center}
#cmpg-{{ section.id }} .tk-top p{margin:0;max-width:52ch;color:var(--ink2)}
#cmpg-{{ section.id }} .tk-sec{border-bottom:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-hd{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;padding:32px 40px 20px;flex-wrap:wrap}
#cmpg-{{ section.id }} .tk-pick{padding:0 40px 28px;display:flex;flex-direction:column;gap:16px}
#cmpg-{{ section.id }} .tk-chips{display:flex;flex-wrap:wrap;gap:6px}
#cmpg-{{ section.id }} .tk-chips button{min-height:40px;padding:0 14px;border:1px solid var(--ink);background:transparent;color:var(--ink);font:inherit;font-size:13px;cursor:pointer}
#cmpg-{{ section.id }} .tk-chips button.on{background:var(--ink);color:#fff}
#cmpg-{{ section.id }} .tk-row{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap}
#cmpg-{{ section.id }} .tk-row label{display:flex;flex-direction:column;gap:6px}
#cmpg-{{ section.id }} input[type=date],#cmpg-{{ section.id }} input[type=email],#cmpg-{{ section.id }} input[type=tel]{min-height:48px;padding:0 14px;border:1px solid var(--soft);background:#fff;font:inherit;color:var(--ink);border-radius:0}
#cmpg-{{ section.id }} .btn{display:inline-flex;align-items:center;gap:14px;min-height:48px;padding:0 24px;border-radius:999px;border:0;background:var(--lime);color:var(--ink);font:inherit;font-size:15px;font-weight:500;cursor:pointer;text-decoration:none}
#cmpg-{{ section.id }} .btn.dark{background:var(--ink);color:#fff}
#cmpg-{{ section.id }} .sq{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border:1px solid var(--ink);background:transparent;color:var(--ink);font:inherit;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;text-decoration:none}
#cmpg-{{ section.id }} .tk-plan{border-top:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-p{display:grid;grid-template-columns:minmax(0,3fr) repeat(3,minmax(0,2fr));border-bottom:1px solid var(--soft)}
#cmpg-{{ section.id }} .tk-p > div{padding:16px 20px;display:flex;flex-direction:column;gap:4px}
#cmpg-{{ section.id }} .tk-p > div:first-child{padding-left:40px}
#cmpg-{{ section.id }} .tk-p b{font-family:var(--fd);font-weight:400;font-size:20px;line-height:1.15}
#cmpg-{{ section.id }} .tk-p .lab{color:var(--ink2)}
#cmpg-{{ section.id }} .tk-p .hl{background:var(--pale);padding:2px 6px;align-self:flex-start}
#cmpg-{{ section.id }} .tk-cal{display:grid;grid-template-columns:minmax(0,8fr) minmax(0,4fr)}
#cmpg-{{ section.id }} .tk-grid{padding:20px 40px 28px;border-right:1px solid var(--rule);display:flex;flex-direction:column;gap:6px}
#cmpg-{{ section.id }} .tk-wk{display:grid;grid-template-columns:44px repeat(7,minmax(0,1fr));gap:6px;align-items:center}
#cmpg-{{ section.id }} .tk-wk .w{font-size:12px;color:var(--ink2)}
#cmpg-{{ section.id }} .tk-wk .hd{font-size:11px;text-align:center;color:var(--ink2);letter-spacing:.06em}
#cmpg-{{ section.id }} .tk-d{min-height:40px;border:1px solid var(--ink);background:#fff;font:inherit;font-size:12px;color:var(--ink);cursor:pointer;padding:0}
#cmpg-{{ section.id }} .tk-d.rest{border-style:dashed;border-color:#B9B48A;background:#FBFAE6}
#cmpg-{{ section.id }} .tk-d.on{background:var(--ink);color:#fff;border-style:solid;border-color:var(--ink)}
#cmpg-{{ section.id }} .tk-d.off{background:var(--pale);border-style:solid}
#cmpg-{{ section.id }} .tk-d.today{outline:2px solid var(--lime);outline-offset:1px}
#cmpg-{{ section.id }} .tk-leg{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--ink2);margin-top:8px}
#cmpg-{{ section.id }} .tk-leg i{display:inline-block;width:12px;height:12px;border:1px solid var(--ink);margin-right:6px;vertical-align:-2px}
#cmpg-{{ section.id }} .tk-feel{padding:20px 24px 28px;display:flex;flex-direction:column;gap:10px}
#cmpg-{{ section.id }} .tk-fr{display:grid;grid-template-columns:88px repeat(5,minmax(0,1fr));gap:6px;align-items:center}
#cmpg-{{ section.id }} .tk-fr .w{font-size:12px;color:var(--ink2);line-height:1.25}
#cmpg-{{ section.id }} .tk-acts{display:flex;gap:10px;flex-wrap:wrap;padding:24px 40px;border-bottom:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-rem{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);background:var(--pale);border-bottom:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-rem > div{padding:36px 40px;display:flex;flex-direction:column;gap:12px}
#cmpg-{{ section.id }} .tk-rem form{display:flex;flex-direction:column;gap:10px}
#cmpg-{{ section.id }} .tk-rem .tk-row input{flex:1 1 200px}
#cmpg-{{ section.id }} .tk-rem ul{margin:0;padding-left:18px;color:var(--ink2)}
#cmpg-{{ section.id }} .tk-empty{padding:28px 40px;color:var(--ink2)}
#cmpg-{{ section.id }} [hidden]{display:none !important}
@container (max-width: 760px){
#cmpg-{{ section.id }} h1{font-size:32px}
#cmpg-{{ section.id }} h2{font-size:24px}
#cmpg-{{ section.id }} .tk-top,#cmpg-{{ section.id }} .tk-cal,#cmpg-{{ section.id }} .tk-rem{grid-template-columns:minmax(0,1fr)}
#cmpg-{{ section.id }} .tk-top > div,#cmpg-{{ section.id }} .tk-rem > div{padding:28px 20px}
#cmpg-{{ section.id }} .tk-top > div + div{border-left:0;border-top:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-hd,#cmpg-{{ section.id }} .tk-pick,#cmpg-{{ section.id }} .tk-acts,#cmpg-{{ section.id }} .tk-empty{padding-left:20px;padding-right:20px}
#cmpg-{{ section.id }} .tk-p{grid-template-columns:repeat(2,minmax(0,1fr))}
#cmpg-{{ section.id }} .tk-p > div:first-child{grid-column:1/-1;padding-left:20px;padding-bottom:4px}
#cmpg-{{ section.id }} .tk-p > div{padding:10px 20px}
#cmpg-{{ section.id }} .tk-grid{padding:16px 12px 20px;border-right:0;border-bottom:1px solid var(--rule)}
#cmpg-{{ section.id }} .tk-wk{grid-template-columns:30px repeat(7,minmax(0,1fr));gap:4px}
#cmpg-{{ section.id }} .tk-d{min-height:36px;font-size:11px}
#cmpg-{{ section.id }} .tk-feel{padding:16px 20px 24px}
}
@media print{
body > *:not(main){display:none !important}
#cmpg-{{ section.id }} .tk-pick,#cmpg-{{ section.id }} .tk-acts,#cmpg-{{ section.id }} .tk-rem,#cmpg-{{ section.id }} .tk-top > div + div{display:none !important}
#cmpg-{{ section.id }}{background:#fff}
#cmpg-{{ section.id }} .tk-d{min-height:28px}
}
</style>

<section class="tk-top" aria-labelledby="tkh">
<div>
<span class="lab">Tu tracker · 12 semanas</span>
<h1 id="tkh">Tu camino, día por día.</h1>
<p>Elige lo que estás tomando y el día que empezaste. Te armamos tu calendario con fechas reales: cuándo descansar, cuándo se nota y cuándo te toca tu descanso largo.</p>
</div>
<div>
<span class="lab">Cómo se usa</span>
<p style="color:var(--ink)">Toca cada día que tomaste tu protocolo. Tócalo otra vez para marcarlo como descanso. Califica cómo te sientes en las semanas 0, 4, 8 y 12.</p>
<p class="small">Se guarda en este navegador. Guarda el link en tu WhatsApp para volver a él.</p>
</div>
</section>

<section class="tk-sec" aria-labelledby="tk1">
<div class="tk-hd"><h2 id="tk1">¿Qué estás tomando?</h2><span class="small" data-sum></span></div>
<div class="tk-pick">
<div class="tk-chips" data-chips role="group" aria-label="Productos"></div>
<div class="tk-row">
<label><span class="lab">¿Cuándo empezaste?</span><input type="date" data-date></label>
<button type="button" class="btn dark" data-go>Armar mi tracker</button>
</div>
</div>
</section>

<div data-out hidden>
<section class="tk-sec" aria-labelledby="tk2">
<div class="tk-hd"><h2 id="tk2">Tu plan.</h2><span class="small">Fechas aproximadas a partir del día que empezaste.</span></div>
<div class="tk-plan" data-plan></div>
</section>

<section class="tk-sec" aria-labelledby="tk3">
<div class="tk-hd"><h2 id="tk3">Marca cada día. Así se nota.</h2><span class="small" data-prog></span></div>
<div class="tk-cal">
<div class="tk-grid" data-grid></div>
<div class="tk-feel" data-feel></div>
</div>
</section>

<div class="tk-acts">
<button type="button" class="btn" data-print>Descargar en PDF</button>
<a class="sq" href="#" data-wa target="_blank" rel="noopener">Mandarme el link por WhatsApp</a>
<button type="button" class="sq" data-copy>Copiar link</button>
</div>

<section class="tk-rem" aria-labelledby="tk4">
<div>
<span class="lab">Te acompañamos</span>
<h2 id="tk4">Te avisamos en cada paso.</h2>
<ul>
<li>Semana 3: cómo vas.</li>
<li>Semana 8: qué has notado y si te toca reponer.</li>
<li>Semana 12: si sigues o te toca tu descanso largo.</li>
</ul>
</div>
<div>
<form data-rem novalidate>
<span class="lab">Recibe tus recordatorios</span>
<div class="tk-row"><input type="email" name="email" placeholder="tu@correo.com" autocomplete="email" aria-label="Tu correo" required><input type="tel" name="phone" placeholder="WhatsApp (10 dígitos)" autocomplete="tel" aria-label="Tu WhatsApp"></div>
<label class="small" style="display:flex;gap:8px;align-items:flex-start"><input type="checkbox" name="mkt" style="margin-top:3px">Acepto recibir recordatorios y novedades de Commons. Puedo darme de baja cuando quiera.</label>
<div><button type="submit" class="btn dark">Quiero mis recordatorios</button></div>
<span class="small" data-ok hidden>Listo. Te escribimos en la semana 3.</span>
<span class="small" data-err hidden>Revisa tu correo e inténtalo otra vez.</span>
</form>
</div>
</section>
</div>
</div>

<script>
(function(){
var root = document.getElementById('cmpg-{{ section.id }}'); if (!root) return;
// clave: [nombre, handle, ritmo (6=6 y 1, d=diario, m=mucuna), meses antes del descanso largo, duración del descanso, se nota en, momento]
var P = {
 ashwagandha:['Ashwagandha','ashwagandha-organico-capsulas-extracto','6',3,'1 mes','8 semanas o más','Día o noche'],
 reishi:['Reishi','hongo-reishi-100g-20-β-glucanos','6',0,'','8 a 10 semanas','Noche'],
 melena:['Melena de León','melena-de-leon-capsulas-organicas','6',0,'','8 a 16 semanas','Mañana'],
 cordyceps:['Cordyceps','cordyceps-extracto-commons','6',0,'','unas 3 semanas','Mañana o tarde, hasta las 2 pm'],
 chaga:['Chaga','chaga','6',2,'2 a 4 semanas','8 a 10 semanas','Mañana o tarde'],
 cola:['Cola de Pavo','hongo-cola-de-pavo-full-polvo','6',0,'','8 a 10 semanas','Con la comida'],
 maitake:['Maitake','hongo-maitake-full-polvo','6',0,'','8 a 10 semanas','Con la comida'],
 rhodiola:['Rhodiola','raiz-rhodiola-rosea-full-polvo','6',3,'2 semanas','2 a 4 semanas','Solo en la mañana'],
 tulsi:['Tulsi','tulsi-full-polvo','6',0,'','unas 8 semanas','Día o noche'],
 schisandra:['Schisandra','baya-schisandra-full-polvo','6',3,'2 a 4 semanas','6 a 12 semanas','De día'],
 shatavari:['Shatavari','shatavari-full-polvo','6',3,'2 semanas','unas 8 semanas','Mañana o noche'],
 eleuthero:['Eleuthero','eleuthero-full-polvo','6',2,'1 mes','alrededor de 1 mes','Solo en la mañana'],
 astragalo:['Astrágalo','astragalus-full-polvo','6',4,'2 semanas','unas 6 semanas','Mañana'],
 amla:['Amla','amla-full-polvo','6',0,'','unas 12 semanas','Con la comida'],
 gotu:['Gotu Kola','gotu-kola','6',3,'2 semanas','alrededor de 2 meses','Mañana'],
 ginkgo:['Ginkgo + Bacopa','gingko-biloba-y-bacopa','6',3,'2 semanas','8 a 12 semanas','Con la comida'],
 mucuna:['Mucuna','mucuna-pruenis-organica-capsulas-y-polvo','m',3,'4 semanas','alrededor de 3 meses','Mañana'],
 vitex:['Vitex','vitex-extracto','d',0,'','3 ciclos','Mañana'],
 master:['Master Blend','master-blend-160-capsulas','6',0,'','8 semanas','Mañana'],
 azafran:['Azafrán','azafran-1','d',0,'','4 a 8 semanas','Como dice la etiqueta'],
 magnesio:['Magnesio P.M.','magnesio-p-m','d',0,'','2 a 4 semanas','Noche']
};
var H = {}; Object.keys(P).forEach(function(k){ H[P[k][1]] = k; });
var MES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fmt(d){ return d.getDate() + ' ' + MES[d.getMonth()] + ' ' + d.getFullYear(); }
function addDays(d, n){ var x = new Date(d); x.setDate(x.getDate() + n); return x; }
function addMonths(d, n){ var x = new Date(d); x.setMonth(x.getMonth() + n); return x; }
function iso(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }
var q = new URLSearchParams(location.search);
var sel = (q.get('p') || '').split(',').map(function(s){ s = s.trim(); return P[s] ? s : H[s]; }).filter(Boolean);
var start = q.get('f') ? new Date(q.get('f') + 'T12:00:00') : null;
if (start && isNaN(start)) start = null;
var chips = root.querySelector('[data-chips]'), dt = root.querySelector('[data-date]');
dt.value = iso(start || new Date());
Object.keys(P).forEach(function(k){
  var b = document.createElement('button'); b.type = 'button'; b.textContent = P[k][0]; b.dataset.k = k;
  b.className = sel.indexOf(k) > -1 ? 'on' : ''; b.setAttribute('aria-pressed', sel.indexOf(k) > -1);
  b.addEventListener('click', function(){ var i = sel.indexOf(k); if (i > -1) sel.splice(i, 1); else sel.push(k); b.className = i > -1 ? '' : 'on'; b.setAttribute('aria-pressed', i < 0); });
  chips.appendChild(b);
});
var KEY, st;
function load(){ KEY = 'cm-tracker-' + sel.slice().sort().join('.') + '-' + iso(start); try { st = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { st = {}; } }
function save(){ try { localStorage.setItem(KEY, JSON.stringify(st)); } catch (e) {} }
function link(){ return location.origin + location.pathname + '?p=' + sel.join(',') + '&f=' + iso(start); }
function render(){
  if (!sel.length || !start) return;
  load();
  root.querySelector('[data-out]').hidden = false;
  root.querySelector('[data-sum]').textContent = sel.map(function(k){ return P[k][0]; }).join(' · ') + ' · desde el ' + fmt(start);
  var plan = '', mucuna = sel.indexOf('mucuna') > -1, daily = sel.every(function(k){ return P[k][2] === 'd'; });
  sel.forEach(function(k){
    var p = P[k], rit = p[2] === 'd' ? 'Todos los días' : (p[2] === 'm' ? 'Lunes, martes, jueves y viernes' : '6 días y 1 de descanso');
    var pausa = p[3] ? '<span class="hl">Desde el ' + fmt(addMonths(start, p[3])) + '</span><span class="small">Descansa ' + p[4] + ' y retoma.</span>' : '<span>Sin pausa larga</span>';
    plan += '<div class="tk-p"><div><span class="lab">' + p[6] + '</span><b>' + p[0] + '</b></div><div><span class="lab">Ritmo</span><span>' + rit + '</span></div><div><span class="lab">Se suele notar</span><span>' + p[5] + '</span></div><div><span class="lab">Descanso largo</span>' + pausa + '</div></div>';
  });
  root.querySelector('[data-plan]').innerHTML = plan;
  var g = '<div class="tk-wk" aria-hidden="true"><span></span>', today = iso(new Date());
  for (var i = 0; i < 7; i++) g += '<span class="hd">' + ['DOM','LUN','MAR','MIÉ','JUE','VIE','SÁB'][addDays(start, i).getDay()] + '</span>';
  g += '</div>';
  var tomados = 0;
  for (var w = 0; w < 12; w++) {
    g += '<div class="tk-wk"><span class="w">S' + (w + 1) + '</span>';
    for (var d = 0; d < 7; d++) {
      var day = addDays(start, w * 7 + d), k2 = iso(day), dow = day.getDay();
      var rest = !daily && (mucuna && sel.length === 1 ? [1,2,4,5].indexOf(dow) < 0 : d === 6);
      var s = st[k2] || '', cls = 'tk-d' + (rest ? ' rest' : '') + (s === 'on' ? ' on' : s === 'off' ? ' off' : '') + (k2 === today ? ' today' : '');
      if (s === 'on') tomados++;
      g += '<button type="button" class="' + cls + '" data-k="' + k2 + '" aria-label="' + fmt(day) + '">' + day.getDate() + (day.getDate() === 1 ? ' ' + MES[day.getMonth()] : '') + '</button>';
    }
    g += '</div>';
  }
  g += '<div class="tk-leg"><span><i style="background:#141A16"></i>Lo tomé</span><span><i style="background:#F4F3B2"></i>Descansé</span><span><i style="border-style:dashed;border-color:#B9B48A;background:#FBFAE6"></i>Día sugerido de descanso</span></div>';
  root.querySelector('[data-grid]').innerHTML = g;
  root.querySelector('[data-prog]').textContent = tomados + ' días tomados de 72';
  var f = '<span class="lab">¿Cómo te sientes? · 1 a 5</span>';
  [0,4,8,12].forEach(function(w){
    var dd = addDays(start, w * 7);
    f += '<div class="tk-fr"><span class="w">Semana ' + w + '<br>' + fmt(dd).replace(/ \d{4}$/, '') + '</span>';
    for (var v = 1; v <= 5; v++) f += '<button type="button" class="tk-d' + (st['f' + w] == v ? ' on' : '') + '" data-f="' + w + '" data-v="' + v + '" aria-label="Semana ' + w + ': ' + v + ' de 5">' + v + '</button>';
    f += '</div>';
  });
  f += '<span class="small">Califica la semana 0 antes de tu primera toma y compárala en la 4, la 8 y la 12.</span>';
  root.querySelector('[data-feel]').innerHTML = f;
  root.querySelector('[data-wa]').href = 'https://wa.me/?text=' + encodeURIComponent('Mi tracker Commons: ' + link());
  try { history.replaceState(null, '', link()); } catch (e) {}
}
root.querySelector('[data-go]').addEventListener('click', function(){
  start = dt.value ? new Date(dt.value + 'T12:00:00') : new Date();
  if (!sel.length) { chips.querySelector('button').focus(); return; }
  render(); root.querySelector('[data-out]').scrollIntoView({ behavior: 'smooth' });
});
root.addEventListener('click', function(e){
  var b = e.target.closest('.tk-d'); if (!b) return;
  if (b.dataset.f) { st['f' + b.dataset.f] = +b.dataset.v; }
  else { var s = st[b.dataset.k]; st[b.dataset.k] = !s ? 'on' : (s === 'on' ? 'off' : ''); if (!st[b.dataset.k]) delete st[b.dataset.k]; }
  save(); render();
});
root.querySelector('[data-print]').addEventListener('click', function(){ window.print(); });
root.querySelector('[data-copy]').addEventListener('click', function(e){ var b = e.currentTarget; try { navigator.clipboard.writeText(link()); b.textContent = 'Link copiado'; } catch (x) {} });
root.querySelector('[data-rem]').addEventListener('submit', function(e){
  e.preventDefault();
  var f = e.currentTarget, em = f.querySelector('[name=email]'), ph = f.querySelector('[name=phone]'), ok = f.querySelector('[data-ok]'), er = f.querySelector('[data-err]');
  ok.hidden = true; er.hidden = true;
  if (!em.value || em.value.indexOf('@') < 1) { er.hidden = false; em.focus(); return; }
  var tags = ['tracker-12-semanas', 'tracker-inicio-' + iso(start)].concat(sel.map(function(k){ return 'tracker-p-' + k; })).join(', ');
  var fd = new FormData();
  fd.append('form_type', 'customer'); fd.append('utf8', '✓');
  fd.append('contact[email]', em.value); fd.append('contact[tags]', tags);
  if (ph.value) fd.append('contact[phone]', '+52' + ph.value.replace(/\D/g, '').slice(-10));
  if (f.querySelector('[name=mkt]').checked) fd.append('contact[accepts_marketing]', 'true');
  var b = f.querySelector('button[type=submit]'); b.disabled = true;
  fetch('/contact', { method: 'POST', body: fd, credentials: 'same-origin' })
    .then(function(r){ if (!r.ok && r.status !== 302) throw r; ok.hidden = false; })
    .catch(function(){ er.hidden = false; })
    .finally(function(){ b.disabled = false; });
});
render();
})();
</script>
{% schema %}
{
  "name": "Tracker 12 semanas",
  "tag": "section",
  "settings": []
}
{% endschema %}
